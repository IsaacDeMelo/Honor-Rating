    function denunciaPreview(input) {
      const box = document.getElementById('denuncia-preview');
      const label = document.getElementById('denuncia-files-label');
      box.innerHTML = '';
      const files = Array.from(input.files || []).slice(0, 3);
      if (input.files && input.files.length > 3) {
        const dt = new DataTransfer();
        files.forEach(f => dt.items.add(f));
        input.files = dt.files;
      }
      if (!files.length) { label.textContent = 'Anexar prints (até 3 imagens)'; return; }
      label.textContent = files.length + ' imagem(ns) selecionada(s)';
      files.forEach((f, i) => {
        const url = URL.createObjectURL(f);
        const card = document.createElement('div');
        card.className = 'relative rounded-xl overflow-hidden border shrink-0';
        card.style.cssText = 'border-color:var(--border);width:96px;';
        card.innerHTML = `
          <div style="width:96px;height:96px;background:#000;display:flex;align-items:center;justify-content:center;overflow:hidden;">
            <img src="${url}" data-dim="${i}" style="max-width:100%;max-height:100%;object-fit:contain;" alt="Prova ${i + 1}">
          </div>
          <p class="text-[8px] text-center px-1 py-0.5" data-dimlabel="${i}" style="color:var(--text-muted);">medindo...</p>
          <button type="button" data-rm="${i}" class="absolute top-1 right-1 w-5 h-5 rounded-full text-[9px] font-bold" style="background:rgba(0,0,0,.7);color:#fff;" title="Remover">×</button>`;
        box.appendChild(card);
        const probe = new Image();
        probe.onload = () => {
          const el = box.querySelector(`[data-dimlabel="${i}"]`);
          if (el) el.textContent = `${probe.naturalWidth}×${probe.naturalHeight}`;
        };
        probe.src = url;
        card.querySelector(`[data-rm="${i}"]`).onclick = () => {
          const dt = new DataTransfer();
          Array.from(input.files).forEach((ff, j) => { if (j !== i) dt.items.add(ff); });
          input.files = dt.files;
          denunciaPreview(input);
        };
      });
    }

    async function enviarDenuncia() {
      const err = document.getElementById('denuncia-error');
      const ok = document.getElementById('denuncia-ok');
      err.classList.add('hidden'); ok.classList.add('hidden');
      const nome = rpgAtualDenuncia();
      const description = document.getElementById('denuncia-desc').value.trim();
      const evidence = document.getElementById('denuncia-prova').value.trim();
      const files = Array.from((document.getElementById('denuncia-files')?.files || [])).slice(0, 3);
      if (!denunciaMotivoSel) { err.textContent = 'Escolha um motivo: Golpe, Inativo ou Falso.'; err.classList.remove('hidden'); return; }
      if (description.length < 5) { err.textContent = 'Descreva com um pouco mais de detalhe.'; err.classList.remove('hidden'); return; }
      if (denunciaMotivoSel === 'golpe' && evidence.length < 3 && !files.length) { err.textContent = 'Para golpe, anexe prints ou cole links como prova.'; err.classList.remove('hidden'); return; }
      const btn = document.getElementById('denuncia-enviar-btn');
      btn.disabled = true; btn.style.opacity = '.6';
      try {
        const form = new FormData();
        form.append('rpgName', nome);
        form.append('reason', denunciaMotivoSel);
        form.append('description', description);
        if (evidence) form.append('evidence', evidence);
        files.forEach(f => form.append('evidenceImages', f));
        const headers = {};
        const t = getToken();
        if (t) headers['Authorization'] = 'Bearer ' + t;
        const res = await fetch('/api/reports', { method: 'POST', headers, body: form });
        const data = await res.json();
        if (!res.ok) { err.textContent = data.error || 'Erro ao enviar.'; err.classList.remove('hidden'); return; }
        ok.textContent = 'Denúncia enviada. Nossa equipe de moderação vai analisar.';
        ok.classList.remove('hidden');
        document.getElementById('denuncia-desc').value = '';
        document.getElementById('denuncia-prova').value = '';
        document.getElementById('denuncia-files').value = '';
        document.getElementById('denuncia-preview').innerHTML = '';
        setTimeout(fecharModalDenuncia, 1600);
      } catch { err.textContent = 'Erro de conexão.'; err.classList.remove('hidden'); }
      finally { btn.disabled = false; btn.style.opacity = '1'; }
    }


  <!-- JAVASCRIPT -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
  <script>
    const TOKEN_KEY = 'rpg-reviewer-token';
    const USER_KEY = 'rpg-reviewer-user';
    const THEME_KEY = 'rpg-reviewer-theme';
    let cropperInstance = null;
    let cropperCallback = null;
    let croppedImageFile = null;
    let croppedBannerFile = null;
    let croppedEditImageFile = null;
    let croppedEditBannerFile = null;

    function abrirCropper(imgSrc, callback) {
      const img = document.getElementById('cropper-image');
      img.src = imgSrc;
      cropperCallback = callback;
      document.getElementById('modal-cropper').classList.remove('modal-hidden');
      img.onload = () => {
        if (cropperInstance) cropperInstance.destroy();
        cropperInstance = new Cropper(img, {
          aspectRatio: 2/3,
          viewMode: 1,
          dragMode: 'move',
          background: false,
          autoCropArea: 1,
        });
      };
    }
    function fecharCropper() {
      if (cropperInstance) { cropperInstance.destroy(); cropperInstance = null; }
      document.getElementById('modal-cropper').classList.add('modal-hidden');
      cropperCallback = null;
    }
    function cropperSetRatio(ratio) {
      if (!cropperInstance) return;
      if (isNaN(ratio)) cropperInstance.setAspectRatio(NaN);
      else cropperInstance.setAspectRatio(ratio);
    }
    function confirmarCropper() {
      if (!cropperInstance) return;
      const canvas = cropperInstance.getCroppedCanvas({ maxWidth: 1200, maxHeight: 1200 });
      canvas.toBlob(blob => {
        const file = new File([blob], 'cropped.png', { type: 'image/png' });
        if (cropperCallback) cropperCallback(file);
        fecharCropper();
      }, 'image/png');
    }
    function previewBannerSimples(input, labelId, wrapId, imgId, metaId) {
      const file = input.files?.[0];
      document.getElementById(labelId).textContent = file?.name || 'Nenhum arquivo';
      const wrap = document.getElementById(wrapId);
      if (!file) { wrap?.classList.add('hidden'); return; }
      const url = URL.createObjectURL(file);
      const img = document.getElementById(imgId);
      img.src = url;
      wrap?.classList.remove('hidden');
      const probe = new Image();
      probe.onload = () => {
        const m = document.getElementById(metaId);
        if (m) m.textContent = `${probe.naturalWidth}×${probe.naturalHeight}`;
      };
      probe.src = url;
    }
    function abrirCropperParaImagem(input, labelId) {
      const file = input.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = e => abrirCropper(e.target.result, cropped => {
        croppedImageFile = cropped;
        document.getElementById(labelId).textContent = file.name + ' (cortado 2:3)';
        const url = URL.createObjectURL(cropped);
        const img = document.getElementById('reg-image-preview');
        if (img) {
          img.src = url;
          document.getElementById('reg-image-preview-wrap')?.classList.remove('hidden');
          const probe = new Image();
          probe.onload = () => {
            const m = document.getElementById('reg-image-meta');
            if (m) m.textContent = `${probe.naturalWidth}×${probe.naturalHeight} · pronto em 2:3`;
          };
          probe.src = url;
        }
      });
      reader.readAsDataURL(file);
    }

    const THEME_DEFAULTS = {
      '--bg-primary': '#0b0f19',
      '--bg-secondary': '#0f1524',
      '--bg-card': '#111827',
      '--bg-elevated': '#1a1f35',
      '--bg-input': '#0a0e1a',
      '--accent': '#e50914',
      '--accent-hover': '#f40612',
      '--text-primary': '#f1f5f9',
      '--text-secondary': '#94a3b8',
      '--text-muted': '#64748b',
      '--border': 'rgba(100,116,139,0.25)',
      '--border-accent': 'rgba(229,9,20,0.3)',
      '--star': '#f59e0b',
    };

    function getToken() { return localStorage.getItem(TOKEN_KEY); }
    function getUser() {
      try { return JSON.parse(localStorage.getItem(USER_KEY)); }
      catch { return null; }
    }
    function saveSession(token, user) {
      localStorage.setItem(TOKEN_KEY, token);
      localStorage.setItem(USER_KEY, JSON.stringify(user));
    }
    function clearSession() {
      localStorage.removeItem(TOKEN_KEY);
      localStorage.removeItem(USER_KEY);
    }

    function aplicarCor(varName, value) {
      document.documentElement.style.setProperty(varName, value);
      salvarTema();
    }

    function salvarTema() {
      const theme = {};
      Object.keys(THEME_DEFAULTS).forEach(key => {
        theme[key] = document.documentElement.style.getPropertyValue(key) || THEME_DEFAULTS[key];
      });
      localStorage.setItem(THEME_KEY, JSON.stringify(theme));
    }

    function carregarTema() {
      const saved = localStorage.getItem(THEME_KEY);
      if (!saved) return;
      try {
        const theme = JSON.parse(saved);
        Object.entries(theme).forEach(([key, value]) => {
          if (value) document.documentElement.style.setProperty(key, value);
        });
      } catch {}
    }

    function resetarTema() {
      Object.entries(THEME_DEFAULTS).forEach(([key, value]) => {
        document.documentElement.style.setProperty(key, value);
      });
      Object.keys(THEME_DEFAULTS).forEach(key => {
        const cp = document.getElementById('cp-' + key.replace('--', ''));
        if (cp) cp.value = THEME_DEFAULTS[key];
      });
      localStorage.removeItem(THEME_KEY);
    }

    function exportarTema() {
      const theme = {};
      Object.keys(THEME_DEFAULTS).forEach(key => {
        theme[key] = document.documentElement.style.getPropertyValue(key) || THEME_DEFAULTS[key];
      });
      const text = Object.entries(theme).map(([k, v]) => `${k}: ${v}`).join('\n');
      navigator.clipboard.writeText(text).then(() => {
        alert('Tema copiado para a área de transferência!');
      }).catch(() => {
        prompt('Copie o texto abaixo:', text);
      });
    }

    function toggleThemePanel() {
      const content = document.getElementById('theme-panel-content');
      const btn = document.querySelector('#theme-panel > button');
      content.classList.toggle('hidden');
      btn.classList.toggle('hidden');
    }

    function abrirCatalogo() {
      document.getElementById('feed-view').classList.add('hidden');
      const modal = document.getElementById('modal-catalogo');
      modal.classList.remove('modal-hidden');
      void modal.offsetHeight;
      modal.classList.add('catalogo-aberto');
      document.body.style.overflow = 'hidden';
      document.getElementById('nav-catalogo').style.color = 'var(--accent)';
      document.getElementById('nav-feed').style.color = 'var(--text-muted)';
      atualizarHero();
    }

    function abrirFeed(e) {
      if (e) e.stopPropagation();
      const modal = document.getElementById('modal-catalogo');
      modal.classList.remove('catalogo-aberto');
      setTimeout(() => {
        modal.classList.add('modal-hidden');
        document.getElementById('feed-view').classList.remove('hidden');
        document.body.style.overflow = '';
      }, 100);
      document.getElementById('nav-feed').style.color = 'var(--accent)';
      document.getElementById('nav-catalogo').style.color = 'var(--text-muted)';
    }

    function revelarBlur(el) {
      const img = el?.querySelector('.cat-blur');
      if (img && !img.classList.contains('revealed')) {
        img.classList.add('revealed');
      }
    }

    function toggleRegBlurOption() {
      const age = document.getElementById('reg-age').value;
      document.getElementById('reg-blur-container').classList.toggle('hidden', age !== '18');
    }

    function toggleEditBlurOption() {
      const age = document.getElementById('edit-age').value;
      document.getElementById('edit-blur-container').classList.toggle('hidden', age !== '18');
    }

    function toggleRegLimitedFields() {
      const limited = document.getElementById('reg-tipo').value === 'limited';
      document.getElementById('reg-limited-fields').classList.toggle('hidden', !limited);
    }

    function toggleEditLimitedFields() {
      const limited = document.getElementById('edit-tipo').value === 'limited';
      document.getElementById('edit-limited-fields').classList.toggle('hidden', !limited);
    }

    function computeHeroRpgs(rpgs) {
      const byOrder = (a, b) => ((a.featuredOrder ?? 0) - (b.featuredOrder ?? 0)) || a.name.localeCompare(b.name);
      const limited = (rpgs || []).filter(r => r.limitedEdition).sort(byOrder);
      const featured = (rpgs || []).filter(r => r.featured && !r.limitedEdition).sort(byOrder);
      const combined = limited.concat(featured);
      return combined.length ? combined : (rpgs && rpgs[0] ? [rpgs[0]] : []);
    }

    function buildHeroSlides(rpgs, ads) {
      const rpgList = computeHeroRpgs(rpgs);
      const heroAds = [];
      (ads || []).forEach(a => {
        if (a.active) {
          (a.creatives || []).forEach(c => {
            if (c.placement === 'hero' || c.placement === 'both') {
              heroAds.push({ image: c.image, title: a.title, link: a.link, desc: a.description });
            }
          });
        }
      });
      const adList = heroAds;
      const slides = [];
      let adIdx = 0;
      rpgList.forEach((r, i) => {
        slides.push({ type: 'rpg', data: r });
        if (adList.length && (i + 1) % 3 === 0) {
          slides.push({ type: 'ad', data: adList[adIdx % adList.length] });
          adIdx++;
        }
      });
      if (adList.length && !slides.some(s => s.type === 'ad')) {
        slides.push({ type: 'ad', data: adList[0] });
      }
      return slides;
    }

    let catAdsData = <%- JSON.stringify(ads || []) %>;
    let heroSlides = buildHeroSlides(<%- JSON.stringify(rpgs) %>, catAdsData);
    let heroInterval, heroIndex = 0, heroPausado = false, heroTouchX = 0, heroSwipeInit = false;
    renderCatalogoAds();
    setInterval(() => { atualizarUsersData(); }, 30000);

    function iniciarHero() {
      pararHero();
      if (heroSlides.length < 2) return;
      iniciarHeroSwipe();
      heroInterval = setInterval(() => {
        if (heroPausado) return;
        heroIndex = (heroIndex + 1) % heroSlides.length;
        heroIrPara(null, heroIndex);
      }, 3000);
    }

    function pararHero() { if (heroInterval) { clearInterval(heroInterval); heroInterval = null; } }
    function pausarHero() { heroPausado = true; }
    function retomarHero() { heroPausado = false; }

    function heroIrPara(e, index) {
      if (e) { e.stopPropagation(); pausarHero(); setTimeout(retomarHero, 6000); }
      heroIndex = index;
      const slide = heroSlides[index];
      if (!slide) return;
      const banner = document.getElementById('cat-banner');
      banner.style.opacity = '0';
      setTimeout(() => {
        banner.style.backgroundImage = `url('${slide.type === 'ad' ? slide.data.image : slide.data.banner}')`;
        banner.style.opacity = '1';
        banner.classList.remove('cat-banner-zoom');
        void banner.offsetWidth;
        banner.classList.add('cat-banner-zoom');
      }, 150);
      const isAd = slide.type === 'ad';
      const adLink = document.getElementById('cat-ad-link');
      document.getElementById('cat-title').textContent = isAd ? slide.data.title : slide.data.name;
      document.getElementById('cat-desc').textContent = isAd ? '' : slide.data.description;
      document.getElementById('cat-owner').textContent = isAd ? (slide.data.desc || 'Parceiro') : `${slide.data.owner} · ${slide.data.year}`;
      document.getElementById('cat-genre').textContent = isAd ? 'Anúncio' : slide.data.genre;
      document.getElementById('cat-year').textContent = isAd ? '' : (slide.data.year || '');
      const limitedBadge = document.getElementById('cat-limited-badge');
      if (limitedBadge) limitedBadge.classList.toggle('hidden', isAd || !slide.data.limitedEdition);
      if (adLink) {
        adLink.classList.toggle('hidden', !isAd);
        adLink.classList.toggle('inline-flex', isAd);
        adLink.href = isAd && slide.data.link ? slide.data.link : '#';
      }
      const dots = document.querySelectorAll('#hero-dots button');
      dots.forEach((d, i) => {
        d.style.background = i === index ? 'var(--accent)' : 'rgba(255,255,255,0.4)';
        d.style.width = i === index ? '16px' : '6px';
      });
    }

    function heroClicar() {
      const slide = heroSlides[heroIndex];
      if (!slide) return;
      if (slide.type === 'ad') {
        if (slide.data.link) window.open(slide.data.link, '_blank');
        return;
      }
      selecionarRpgCatalogo(slide.data.name, document.getElementById('cat-hero-container'));
    }

    function heroProximo(e) { if (e) e.stopPropagation(); pausarHero(); setTimeout(retomarHero, 6000); heroIndex = (heroIndex + 1) % heroSlides.length; heroIrPara(null, heroIndex); }
    function heroAnterior(e) { if (e) e.stopPropagation(); pausarHero(); setTimeout(retomarHero, 6000); heroIndex = (heroIndex - 1 + heroSlides.length) % heroSlides.length; heroIrPara(null, heroIndex); }

    function iniciarHeroSwipe() {
      if (heroSwipeInit) return;
      heroSwipeInit = true;
      const el = document.getElementById('cat-hero-container');
      if (!el) return;
      el.addEventListener('touchstart', e => { heroTouchX = e.changedTouches[0].screenX; }, { passive: true });
      el.addEventListener('touchend', e => {
        const dx = e.changedTouches[0].screenX - heroTouchX;
        if (Math.abs(dx) > 50) {
          if (dx < 0) heroProximo(); else heroAnterior();
        }
      }, { passive: true });
    }

    function selecionarRpgCatalogo(nome, el) {
      revelarBlur(el);
      const idx = heroSlides.findIndex(s => s.type === 'rpg' && s.data.name === nome);
      if (idx !== -1) { heroIrPara(null, idx); heroIndex = idx; }
      window.scrollTo({ top: 0, behavior: 'smooth' });
      abrirDetalheRpg(nome);
    }

    function reviewScore(r) {
      return ((r.likes || []).length - (r.dislikes || []).length);
    }

    function meuVoto(r) {
      const user = getUser();
      if (!user) return null;
      if ((r.likes || []).includes(user.username)) return 'like';
      if ((r.dislikes || []).includes(user.username)) return 'dislike';
      return null;
    }

    async function votarReview(id, voto) {
      const user = getUser();
      if (!user) { abrirModalLogin(); return; }
      try {
        const res = await fetch(`/api/reviews/${id}/${voto}`, {
          method: 'POST',
          headers: { 'Authorization': 'Bearer ' + getToken() }
        });
        if (!res.ok) return;
        const updated = await res.json();
        allReviewData = allReviewData.map(r => r.id === id ? updated : r);
        const list = document.getElementById('detalhe-reviews-list');
        if (list && modalRpgAtual) renderReviewsNoDetalhe(modalRpgAtual, list);
      } catch {}
    }

    function renderReviewsNoDetalheList(revs, list) {
      if (revs.length) {
        list.innerHTML = revs.map(r => {
          const u = catUsersData.find(u => u.username === r.username);
          const avatar = u?.avatar;
          const initial = r.username.charAt(0).toUpperCase();
          const rpgName = r.rpg.name;
          const podeResponder = isCreatorOfUser(rpgName);
          const likes = (r.likes || []).length;
          const dislikes = (r.dislikes || []).length;
          const voto = meuVoto(r);
          return `
          <div class="detalhe-review-card rounded-xl p-3 border" style="background:color-mix(in srgb, var(--bg-card) 50%, transparent);border-color:var(--border);">
            <div class="flex items-center gap-2 mb-1">
              <div onclick="verPerfil('${r.username}')" class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold overflow-hidden shrink-0 cursor-pointer" style="background:var(--accent-dim);color:var(--accent);">
                ${avatar ? `<img src="${avatar}" class="w-full h-full object-cover">` : initial}
              </div>
              <span onclick="verPerfil('${r.username}')" class="text-[11px] font-semibold cursor-pointer hover:underline inline-flex items-center gap-1" style="color:var(--text-secondary);">${r.username}<span class="creator-badge hidden items-center gap-0.5 text-[7px] font-bold px-1 py-0.5 rounded-full" data-creator="${r.username}" style="background:#22c55e20;color:#22c55e;border:1px solid #22c55e40;"><i class="fa-solid fa-award"></i>Criador</span></span>
              <span class="text-[10px] ml-auto" style="color:var(--star);">${'★'.repeat(Math.floor(r.rating))}${r.rating % 1 ? '½' : ''} ${r.rating}</span>
            </div>
            <p class="text-[11px] leading-relaxed" style="color:var(--text-muted);">${r.comment.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</p>
            <div class="flex items-center gap-2 mt-1.5">
              <span class="text-[9px]" style="color:var(--text-muted);">${r.timeAgo}</span>
              <span class="inline-flex items-center gap-1 ml-auto">
                <button onclick="votarReview('${r.id}', 'like')" title="Curtir" class="text-[10px] px-2 py-1 rounded-lg font-bold transition-all active:scale-90 inline-flex items-center gap-1" style="color:${voto === 'like' ? '#22c55e' : 'var(--text-muted)'};background:${voto === 'like' ? 'color-mix(in srgb, #22c55e 15%, transparent)' : 'transparent'};border:1px solid ${voto === 'like' ? 'color-mix(in srgb, #22c55e 40%, transparent)' : 'var(--border)'};"><i class="fa-solid fa-thumbs-up"></i>${likes || ''}</button>
                <button onclick="votarReview('${r.id}', 'dislike')" title="Não curtir" class="text-[10px] px-2 py-1 rounded-lg font-bold transition-all active:scale-90 inline-flex items-center gap-1" style="color:${voto === 'dislike' ? '#ef4444' : 'var(--text-muted)'};background:${voto === 'dislike' ? 'color-mix(in srgb, #ef4444 15%, transparent)' : 'transparent'};border:1px solid ${voto === 'dislike' ? 'color-mix(in srgb, #ef4444 40%, transparent)' : 'var(--border)'};"><i class="fa-solid fa-thumbs-down"></i>${dislikes || ''}</button>
              </span>
              ${podeResponder ? `<button onclick="abrirModalResponderReview('${r.id}', '${r.username.replace(/'/g, "\\'")}', '${r.comment.replace(/'/g, "\\'").replace(/</g, '&lt;').replace(/>/g, '&gt;').slice(0, 80)}')" class="text-[9px] px-2 py-1 rounded-lg font-bold transition-all active:scale-[0.94] inline-flex items-center gap-1" style="color:#22c55e;background:color-mix(in srgb, #22c55e 10%, transparent);border:1px solid color-mix(in srgb, #22c55e 25%, transparent);"><i class="fa-solid fa-reply"></i> Responder</button>` : ''}
            </div>
            <div class="review-replies-box hidden mt-2 space-y-2" data-reviews-list="${r.id}"></div>
          </div>`;
        }).join('');
        revs.forEach(r => {
          const box = list.querySelector(`[data-reviews-list="${r.id}"]`);
          if (box) carregarRespostas(r.id, box);
        });
        atualizarFeedSelo();
      } else {
        list.innerHTML = '<p class="text-xs text-center py-4" style="color: var(--text-muted);">Nenhuma crítica ainda. Seja o primeiro a avaliar!</p>';
      }
    }

    function renderReviewsNoDetalhe(nome, list) {
      const revs = allReviewData
        .filter(r => r.rpg.name === nome)
        .sort((a, b) => {
          const d = reviewScore(b) - reviewScore(a);
          if (d !== 0) return d;
          return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
        });
      renderReviewsNoDetalheList(revs, list);
    }

    function abrirDetalheRpg(nome, fromPopstate) {
      const modal = document.getElementById('modal-detalhe');
      const rpg = catRpgData.find(r => r.name === nome);
      if (!rpg) return;
      trackAnalytics({ type: 'rpgview', rpg: nome });

      if (!fromPopstate) {
        const slug = toSlug(nome);
        window.history.pushState({ rpg: nome }, '', '/rpg/' + slug);
        document.title = rpg.name + ' — Avaliações e Críticas | Rpflix';
      }
      rpgModalOpen = true;
      modalRpgAtual = nome;
      document.getElementById('detalhe-banner').style.backgroundImage = `url('${rpg.banner}')`;
      document.getElementById('detalhe-name').textContent = rpg.name;
      document.getElementById('detalhe-owner').textContent = rpg.owner;
      document.getElementById('detalhe-genre').textContent = rpg.genre;
      document.getElementById('detalhe-year').textContent = rpg.year || '';
      const ageEl = document.getElementById('detalhe-age');
      ageEl.textContent = rpg.ageRating === 'L' ? 'Livre' : rpg.ageRating;
      ageEl.style.background = rpg.ageRating === '18' ? 'rgba(0,0,0,0.8)' : rpg.ageRating === '16' ? 'rgba(239,68,68,0.3)' : rpg.ageRating === '14' ? 'rgba(251,146,60,0.3)' : 'rgba(234,179,8,0.2)';
      ageEl.style.color = rpg.ageRating === '18' ? '#fff' : rpg.ageRating === '16' ? '#ef4444' : rpg.ageRating === '14' ? '#fb923c' : '#eab308';
      document.getElementById('detalhe-desc').textContent = rpg.description;
      const limitedBox = document.getElementById('detalhe-limited');
      if (rpg.limitedEdition) {
        limitedBox.classList.remove('hidden');
        limitedBox.classList.add('flex');
        const filled = rpg.slotsFilled || 0;
        const total = rpg.slotsTotal;
        const closed = rpg.closed || (total != null && filled >= total);
        document.getElementById('detalhe-limited-title').textContent = closed ? 'Vagas encerradas' : (total != null ? `Vagas: ${filled}/${total}` : 'Edição Limitada');
        document.getElementById('detalhe-limited-sub').textContent = rpg.closed
          ? 'Este RPG está fechado para novas inscrições.'
          : (total != null
            ? `${total - filled} vaga${total - filled !== 1 ? 's' : ''} restante${total - filled !== 1 ? 's' : ''}.`
            : 'RPG fechado com vagas limitadas.');
      } else {
        limitedBox.classList.add('hidden');
        limitedBox.classList.remove('flex');
      }
      const tagsContainer = document.getElementById('detalhe-tags');
      if (rpg.tags && rpg.tags.length) {
        tagsContainer.innerHTML = rpg.tags.sort((a, b) => b.weight - a.weight).map(t =>
          `<span class="text-[9px] px-2 py-0.5 rounded font-medium" style="background:color-mix(in srgb, var(--accent) 15%, transparent);color:var(--accent);border:1px solid color-mix(in srgb, var(--accent) 25%, transparent);">${t.name}</span>`
        ).join('');
        tagsContainer.classList.remove('hidden');
      } else {
        tagsContainer.innerHTML = '';
        tagsContainer.classList.add('hidden');
      }
      // Preencher nota em destaque
      const rpgRevs = allReviewData.filter(r => r.rpg.name === nome);
      const count = rpgRevs.length;
      const avg = count ? (rpgRevs.reduce((s, r) => s + r.rating, 0) / count) : 0;
      const ratingValue = document.getElementById('detalhe-rating-value');
      const ratingStars = document.getElementById('detalhe-rating-stars');
      const ratingCount = document.getElementById('detalhe-rating-count');
      if (count > 0) {
        ratingValue.textContent = avg.toFixed(1);
        ratingStars.innerHTML = '';
        for (let i = 1; i <= 5; i++) {
          const star = document.createElement('i');
          if (i <= Math.floor(avg)) star.className = 'fas fa-star';
          else if (i === Math.ceil(avg) && avg % 1 !== 0) star.className = 'fas fa-star-half-alt';
          else star.className = 'far fa-star';
          star.style.cssText = 'color:var(--star);font-size:9px;';
          ratingStars.appendChild(star);
        }
        ratingCount.textContent = `${count} avaliação${count !== 1 ? 'ões' : ''}`;
      } else {
        ratingValue.textContent = '—';
        ratingStars.innerHTML = '';
        for (let i = 1; i <= 5; i++) {
          const star = document.createElement('i');
          star.className = 'fa-regular fa-star';
          star.style.cssText = 'color:var(--text-muted);font-size:9px;opacity:0.4;';
          ratingStars.appendChild(star);
        }
        ratingCount.textContent = 'Sem avaliações';
      }

      const linkEl = document.getElementById('detalhe-link');
      if (rpg.link) { linkEl.href = rpg.link; linkEl.style.opacity = '1'; linkEl.style.pointerEvents = 'auto'; }
      else { linkEl.href = '#'; linkEl.style.opacity = '0.5'; linkEl.style.pointerEvents = 'none'; }
      const waEl = document.getElementById('detalhe-whatsapp');
      if (rpg.whatsapp) { waEl.href = rpg.whatsapp; waEl.style.opacity = '1'; waEl.style.pointerEvents = 'auto'; }
      else { waEl.href = '#'; waEl.style.opacity = '0.5'; waEl.style.pointerEvents = 'none'; }

      // Preencher críticas deste RPG
      const list = document.getElementById('detalhe-reviews-list');
      list.innerHTML = '<p class="text-xs text-center py-4" style="color:var(--text-muted);">Carregando...</p>';
      renderReviewsNoDetalhe(nome, list);
      // Também busca via API para garantir dados completos
      fetch('/api/reviews?rpg=' + encodeURIComponent(nome))
        .then(r => r.ok ? r.json() : [])
        .then(apiRevs => {
          if (apiRevs.length > rpgRevs.length) {
            renderReviewsNoDetalheList(apiRevs, list);
          }
        }).catch(() => {});

      const user = getUser();
      document.getElementById('btn-avaliar-detalhe').classList.toggle('hidden', !user);
      document.getElementById('btn-avaliar-detalhe').dataset.rpg = nome;
      document.getElementById('btn-editar-detalhe').classList.toggle('hidden', !user || user.role !== 'admin');
      document.getElementById('btn-editar-detalhe').dataset.rpg = nome;
      document.getElementById('btn-deletar-detalhe').classList.toggle('hidden', !user || user.role !== 'admin');
      document.getElementById('btn-deletar-detalhe').dataset.rpg = nome;

      modal.classList.remove('modal-hidden');
      void modal.offsetHeight;
      modal.classList.add('detalhe-aberto');
    }

    function avaliarDoDetalhe() {
      const nome = document.getElementById('btn-avaliar-detalhe').dataset.rpg;
      fecharDetalheRpg();
      setTimeout(() => abrirModalAvaliacao(nome), 100);
    }

    function abrirCropperParaEdicao(input, labelId) {
      const file = input.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = e => abrirCropper(e.target.result, cropped => {
        croppedEditImageFile = cropped;
        document.getElementById(labelId).textContent = file.name + ' (cortado)';
      });
      reader.readAsDataURL(file);
    }

    function editarRpgDoDetalhe() {
      const nome = document.getElementById('btn-editar-detalhe').dataset.rpg;
      if (!nome) return;
      const rpg = catRpgData.find(r => r.name === nome);
      if (!rpg) return;
      document.getElementById('edit-nome').value = rpg.name;
      document.getElementById('edit-owner').value = rpg.owner || '';
      document.getElementById('edit-genre').value = rpg.genre || '';
      document.getElementById('edit-year').value = rpg.year || '';
      document.getElementById('edit-age').value = rpg.ageRating || 'L';
      document.getElementById('edit-blur').checked = rpg.blurImage === true;
      toggleEditBlurOption();
      document.getElementById('edit-tipo').value = rpg.limitedEdition ? 'limited' : 'normal';
      document.getElementById('edit-slots-total').value = rpg.slotsTotal || '';
      document.getElementById('edit-slots-filled').value = rpg.slotsFilled || 0;
      document.getElementById('edit-closed').checked = rpg.closed === true;
      toggleEditLimitedFields();
      document.getElementById('edit-link').value = rpg.link || '';
      document.getElementById('edit-whatsapp').value = rpg.whatsapp || '';
      document.getElementById('edit-desc').value = rpg.description || '';
      document.getElementById('edit-tags').value = (rpg.tags || []).sort((a, b) => b.weight - a.weight).map(t => t.name).join(', ');
      document.getElementById('edit-rpg-error').classList.add('hidden');
      document.getElementById('edit-image-name').textContent = 'Nenhum arquivo';
      document.getElementById('edit-banner-name').textContent = 'Nenhum arquivo';
      croppedEditImageFile = null;
      croppedEditBannerFile = null;
      const featuredBtn = document.getElementById('edit-featured-btn');
      const knob = document.getElementById('edit-featured-knob');
      if (rpg.featured) {
        featuredBtn.style.background = 'var(--accent)';
        knob.style.transform = 'translateX(20px)';
      } else {
        featuredBtn.style.background = 'var(--text-muted)';
        knob.style.transform = 'translateX(0)';
      }
      featuredBtn.dataset.rpg = rpg.name;
      fecharDetalheRpg();
      document.getElementById('modal-editar-rpg').classList.remove('modal-hidden');
    }

    async function toggleFeaturedRpg() {
      const nome = document.getElementById('edit-featured-btn').dataset.rpg;
      if (!nome) return;
      const token = getToken();
      if (!token) return;
      const errEl = document.getElementById('edit-rpg-error');
      try {
        const res = await fetch(`/api/rpgs/${encodeURIComponent(nome)}/featured`, {
          method: 'PATCH',
          headers: { 'Authorization': 'Bearer ' + token }
        });
        if (!res.ok) {
          const data = await res.json();
          if (errEl) { errEl.textContent = data.error || 'Erro ao alternar destaque.'; errEl.classList.remove('hidden'); }
          return;
        }
        if (errEl) errEl.classList.add('hidden');
        const rpg = await res.json();
        const btn = document.getElementById('edit-featured-btn');
        const knob = document.getElementById('edit-featured-knob');
        if (rpg.featured) {
          btn.style.background = 'var(--accent)';
          knob.style.transform = 'translateX(20px)';
        } else {
          btn.style.background = 'var(--text-muted)';
          knob.style.transform = 'translateX(0)';
        }
        const rpgData = catRpgData.find(r => r.name === rpg.name);
        if (rpgData) rpgData.featured = rpg.featured;
        atualizarHero();
      } catch (e) {
        if (errEl) { errEl.textContent = 'Erro de conexão.'; errEl.classList.remove('hidden'); }
      }
    }

    function fecharModalEditarRpg() {
      document.getElementById('modal-editar-rpg').classList.add('modal-hidden');
    }

    async function salvarEdicaoRpg(event) {
      event.preventDefault();
      const errorEl = document.getElementById('edit-rpg-error');
      errorEl.classList.add('hidden');
      const token = getToken();
      if (!token) return;
      const nome = document.getElementById('edit-nome').value;
      const formData = new FormData();
      formData.append('owner', document.getElementById('edit-owner').value.trim());
      formData.append('genre', document.getElementById('edit-genre').value.trim());
      formData.append('year', document.getElementById('edit-year').value.trim());
      formData.append('ageRating', document.getElementById('edit-age').value);
      formData.append('blurImage', document.getElementById('edit-blur').checked);
      formData.append('description', document.getElementById('edit-desc').value.trim());
      const editLimited = document.getElementById('edit-tipo').value === 'limited';
      formData.append('limitedEdition', editLimited);
      formData.append('slotsTotal', document.getElementById('edit-slots-total').value);
      formData.append('slotsFilled', document.getElementById('edit-slots-filled').value);
      formData.append('closed', document.getElementById('edit-closed').checked);
      const tagsStr = document.getElementById('edit-tags').value.trim();
      if (tagsStr) {
        const tags = tagsStr.split(',').map((s, i) => ({ name: s.trim(), weight: tagsStr.split(',').length - i })).filter(t => t.name);
        formData.append('tags', JSON.stringify(tags));
      } else {
        formData.append('tags', JSON.stringify([]));
      }
      const link = document.getElementById('edit-link').value.trim();
      formData.append('link', link || '');
      const whatsapp = document.getElementById('edit-whatsapp').value.trim();
      formData.append('whatsapp', whatsapp || '');
      const imgFile = croppedEditImageFile || document.getElementById('edit-image').files[0];
      if (imgFile) formData.append('image', imgFile);
      const bannerFile = croppedEditBannerFile || document.getElementById('edit-banner').files[0];
      if (bannerFile) formData.append('banner', bannerFile);
      croppedEditImageFile = null;
      croppedEditBannerFile = null;
      try {
        const res = await fetch('/api/rpgs/' + encodeURIComponent(nome), { method: 'PATCH', headers: { 'Authorization': `Bearer ${token}` }, body: formData });
        const data = await res.json();
        if (!res.ok) { errorEl.textContent = data.error; errorEl.classList.remove('hidden'); return; }
        fecharModalEditarRpg();
        await refreshData();
      } catch { errorEl.textContent = 'Erro ao conectar.'; errorEl.classList.remove('hidden'); }
    }

    async function deletarRpgDoDetalhe() {
      const nome = document.getElementById('btn-deletar-detalhe').dataset.rpg;
      if (!nome) return;
      if (!confirm(`Tem certeza que deseja excluir "${nome}"? Esta ação não pode ser desfeita.`)) return;
      const token = getToken();
      if (!token) return;
      try {
        const res = await fetch('/api/rpgs/' + encodeURIComponent(nome), { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` } });
        const data = await res.json();
        if (data.error) { alert(data.error); return; }
        fecharDetalheRpg();
        await refreshData();
      } catch { alert('Erro ao excluir.'); }
    }

    function fecharDetalheRpg(fromPopstate) {
      rpgModalOpen = false;
      modalRpgAtual = null;
      const modal = document.getElementById('modal-detalhe');
      modal.classList.remove('detalhe-aberto');
      setTimeout(() => modal.classList.add('modal-hidden'), 300);
      if (!fromPopstate) {
        window.history.replaceState({}, '', '/');
        document.title = 'Honor - Rating | Catálogo';
      }
    }

    function abrirModalRegistroRpg() {
      const user = getUser();
      if (!user) { abrirModalLogin(); return; }
      document.getElementById('form-registrar-rpg').reset();
      toggleRegBlurOption();
      toggleRegLimitedFields();
      document.getElementById('reg-image-preview-wrap')?.classList.add('hidden');
      document.getElementById('reg-banner-preview-wrap')?.classList.add('hidden');
      const modal = document.getElementById('modal-registrar-rpg');
      modal.classList.remove('modal-hidden');
      void modal.offsetHeight;
      modal.classList.add('registro-aberto');
    }

    function fecharModalRegistroRpg() {
      const modal = document.getElementById('modal-registrar-rpg');
      modal.classList.remove('registro-aberto');
      document.getElementById('reg-rpg-error').classList.add('hidden');
      setTimeout(() => modal.classList.add('modal-hidden'), 300);
    }

    async function registrarRpg(event) {
      event.preventDefault();
      const errorEl = document.getElementById('reg-rpg-error');
      errorEl.classList.add('hidden');
      const token = getToken();
      if (!token) { fecharModalRegistroRpg(); abrirModalLogin(); return; }
      const formData = new FormData();
      formData.append('name', document.getElementById('reg-nome').value.trim());
      formData.append('owner', document.getElementById('reg-owner').value.trim());
      formData.append('genre', document.getElementById('reg-genre').value.trim());
      formData.append('year', document.getElementById('reg-year').value.trim());
      formData.append('ageRating', document.getElementById('reg-age').value);
      formData.append('blurImage', document.getElementById('reg-blur').checked);
      formData.append('description', document.getElementById('reg-desc').value.trim());
      const regLimited = document.getElementById('reg-tipo').value === 'limited';
      formData.append('limitedEdition', regLimited);
      formData.append('slotsTotal', document.getElementById('reg-slots-total').value);
      formData.append('slotsFilled', document.getElementById('reg-slots-filled').value);
      formData.append('closed', document.getElementById('reg-closed').checked);
      const link = document.getElementById('reg-link').value.trim();
      if (link) formData.append('link', link);
      const whatsapp = document.getElementById('reg-whatsapp').value.trim();
      if (whatsapp) formData.append('whatsapp', whatsapp);
      const imgFile = croppedImageFile || document.getElementById('reg-image').files[0];
      if (imgFile) formData.append('image', imgFile);
      const bannerFile = croppedBannerFile || document.getElementById('reg-banner').files[0];
      if (bannerFile) formData.append('banner', bannerFile);
      croppedImageFile = null;
      croppedBannerFile = null;
      try {
        const res = await fetch('/api/rpgs', { method: 'POST', headers: { 'Authorization': `Bearer ${token}` }, body: formData });
        const data = await res.json();
        if (!res.ok) { errorEl.textContent = data.error; errorEl.classList.remove('hidden'); return; }
        fecharModalRegistroRpg();
        await refreshData();
      } catch { errorEl.textContent = 'Erro ao conectar com o servidor.'; errorEl.classList.remove('hidden'); }
    }

    function deletarAvaliacao(id, btnEl) {
      if (!confirm('Excluir esta avaliação?')) return;
      const user = getUser();
      if (!user) return;
      fetch(`/api/reviews/${id}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() }
      })
      .then(r => r.json())
      .then(data => {
        if (data.error) { alert(data.error); return; }
        const card = btnEl.closest('.feed-card, .pendente-card');
        if (card) card.remove();
        catReviewData = catReviewData.filter(r => r.id !== id);
        allReviewData = allReviewData.filter(r => r.id !== id);
        atualizarMediasCatalogo();
      })
      .catch(() => alert('Erro ao excluir.'));
    }


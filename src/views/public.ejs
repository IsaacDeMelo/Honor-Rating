          </h3>
          <button onclick="fecharModalSubmissoes()" class="p-2 rounded-xl transition" style="color: var(--text-muted);">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <div class="p-4 space-y-3">
          <div class="flex gap-2 flex-wrap">
            <button onclick="submissoesFiltro='pending';renderSubmissoesAdmin()" id="sub-f-pending" class="px-3 py-1.5 rounded-xl text-[10px] font-bold">Pendentes</button>
            <button onclick="submissoesFiltro='all';renderSubmissoesAdmin()" id="sub-f-all" class="px-3 py-1.5 rounded-xl text-[10px] font-bold">Todas</button>
            <button onclick="submissoesFiltro='approved';renderSubmissoesAdmin()" id="sub-f-approved" class="px-3 py-1.5 rounded-xl text-[10px] font-bold">Aprovadas</button>
            <button onclick="submissoesFiltro='rejected';renderSubmissoesAdmin()" id="sub-f-rejected" class="px-3 py-1.5 rounded-xl text-[10px] font-bold">Recusadas</button>
          </div>
          <div id="submissoes-list" class="space-y-2">
            <p class="text-xs text-center py-6" style="color: var(--text-muted);">Carregando...</p>
          </div>
        </div>
      </div>

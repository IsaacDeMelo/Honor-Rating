              <% if (rpgRevs.length) { %>
                <% rpgRevs.forEach(r => { %>
                <div class="detalhe-review-card rounded-xl p-3 border" style="background: color-mix(in srgb, var(--bg-card) 50%, transparent); border-color: var(--border);">
                  <div class="flex items-center justify-between mb-1">
                    <span class="text-[11px] font-semibold" style="color: var(--text-secondary);"><%= r.username %></span>
                    <span class="text-[10px]" style="color: var(--star);"><%= '★'.repeat(Math.floor(r.rating)) %><%= r.rating % 1 ? '½' : '' %> <%= r.rating %></span>
                  </div>
                  <p class="text-[11px] leading-relaxed" style="color: var(--text-muted);"><%= r.comment %></p>
                  <span class="text-[9px]" style="color: var(--text-muted);"><%= r.timeAgo %></span>
                </div>
                <% }) %>
              <% } else { %>
                <p class="text-xs text-center py-4" style="color: var(--text-muted);">Nenhuma crítica ainda. Seja o primeiro a avaliar!</p>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- MODAL DE REGISTRO DE RPG -->

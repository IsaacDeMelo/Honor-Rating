    <!-- MODAL CHAT GLOBAL -->
    <div id="modal-chat" class="modal-hidden fixed inset-0 z-50 flex justify-center" style="background: color-mix(in srgb, var(--bg-primary) 94%, transparent);">
      <div class="w-full max-w-md h-full flex flex-col shadow-2xl" style="background: var(--bg-primary);">
        <div class="flex items-center gap-3 px-4 py-3 shrink-0" style="background: var(--bg-elevated); border-bottom: 1px solid var(--border);">
          <button onclick="fecharChat()" class="w-8 h-8 rounded-full flex items-center justify-center transition active:scale-90" style="color:var(--text-secondary);">
            <i class="fa-solid fa-arrow-left text-sm"></i>
          </button>
          <div class="w-10 h-10 rounded-full overflow-hidden shrink-0" style="border:1px solid var(--border);">
            <img src="https://images.stockcake.com/public/e/c/c/ecc80ba1-9082-40cc-86a2-486ad8b93846/earth-from-space-stockcake.jpg" class="w-full h-full object-cover" alt="Chat global">
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-bold truncate" style="color:var(--text-primary);">Chat global</p>
            <p class="text-[10px] truncate" id="chat-subtitulo" style="color:var(--text-muted);">da comunidade Honor Rating</p>
          </div>
          <button onclick="carregarChat()" class="w-8 h-8 rounded-full flex items-center justify-center transition active:scale-90" style="color:var(--text-muted);" title="Recarregar">
            <i class="fa-solid fa-rotate-right text-xs"></i>
          </button>
        </div>
        <div id="chat-mensagens" class="flex-1 overflow-y-auto px-3 py-4 space-y-2" style="background: color-mix(in srgb, var(--bg-card) 50%, transparent);">
          <p class="text-[11px] text-center py-8" style="color:var(--text-muted);">Carregando conversa...</p>
        </div>
        <div id="chat-preview" class="hidden px-4 pt-2 shrink-0" style="background: var(--bg-elevated);"></div>
        <div class="flex items-end gap-2 px-3 py-3 shrink-0" style="background: var(--bg-elevated); border-top: 1px solid var(--border);">
          <label for="chat-image" class="w-10 h-10 rounded-full flex items-center justify-center cursor-pointer transition active:scale-90 shrink-0" style="background:var(--bg-input);color:var(--text-secondary);border:1px solid var(--border);" title="Anexar imagem">
            <i class="fa-solid fa-plus text-sm"></i>
          </label>
          <input id="chat-image" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden" onchange="chatImagePreview(this)">
          <input id="chat-text" type="text" maxlength="1000" placeholder="Conversar..." autocomplete="off" class="flex-1 rounded-full px-4 py-2.5 text-sm focus:outline-none" style="background:var(--bg-input);border:1px solid var(--border);color:var(--text-primary);" onkeydown="if(event.key==='Enter')enviarChatMsg()">
          <button onclick="enviarChatMsg()" id="chat-send-btn" class="w-10 h-10 rounded-full flex items-center justify-center text-white transition active:scale-90 shrink-0" style="background: var(--accent);" title="Enviar">
            <i class="fa-solid fa-paper-plane text-sm"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- MODAL DE POSTAR EVENTO -->
    <div id="modal-postar-evento" class="modal-hidden fixed inset-0 z-50 flex items-center justify-center p-4" style="background: color-mix(in srgb, var(--bg-primary) 90%, transparent);">
      <div class="rounded-3xl w-full max-w-md shadow-2xl" style="background: var(--bg-card); border: 1px solid var(--border);">
        <div class="p-5 border-b flex justify-between items-center" style="border-color: var(--border); background: var(--bg-elevated);">
          <h3 class="text-sm font-bold font-title flex items-center gap-2" style="color: var(--text-primary);">
            <i class="fa-solid fa-bullhorn" style="color: var(--accent);"></i>
            Postar Evento
          </h3>
          <button onclick="fecharModalPostarEvento()" class="p-2 rounded-xl transition" style="color: var(--text-muted);">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <div class="p-4 space-y-3">
          <div>
            <label class="block text-[10px] font-bold mb-1" style="color: var(--text-secondary);">Sistema *</label>
            <select id="event-rpg-select" class="w-full rounded-xl px-3 py-2 text-xs focus:outline-none" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);">
            </select>
          </div>
          <div>
            <label class="block text-[10px] font-bold mb-1" style="color: var(--text-secondary);">Título *</label>
            <input id="event-title" type="text" class="w-full rounded-xl px-3 py-2 text-xs focus:outline-none" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);" placeholder="Ex: Inscrições abertas para a nova temporada!">
          </div>
          <div>
            <label class="block text-[10px] font-bold mb-1" style="color: var(--text-secondary);">Descrição do evento *</label>
            <textarea id="event-content" rows="4" class="w-full rounded-xl px-3 py-2 text-xs focus:outline-none resize-none" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);" placeholder="Conte sobre o evento..."></textarea>
          </div>
          <div>
            <label class="block text-[10px] font-bold mb-1" style="color: var(--text-secondary);">Imagem (opcional)</label>
            <label for="event-image" class="flex items-center justify-center gap-2 w-full rounded-xl py-2.5 text-[11px] font-bold cursor-pointer transition active:scale-[0.98]" style="background:var(--bg-input);border:1px dashed var(--border);color:var(--text-secondary);">
              <i class="fa-solid fa-image"></i>
              <span id="event-image-label">Anexar imagem</span>
            </label>
            <input id="event-image" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden" onchange="eventImagePreview(this)">
            <div id="event-image-preview" class="hidden mt-2"></div>
          </div>
          <div>
            <label class="block text-[10px] font-bold mb-1" style="color: var(--text-secondary);">Tags (opcional, separadas por vírgula)</label>
            <input id="event-tags" type="text" maxlength="200" class="w-full rounded-xl px-3 py-2 text-xs focus:outline-none" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);" placeholder="Ex: inscrições, torneio, live">
          </div>
          <div id="event-pin-box" class="hidden">
            <label class="block text-[10px] font-bold mb-1" style="color: var(--text-secondary);">Fixar no topo (só admin, dias — vazio = sem fixar)</label>
            <input id="event-pinned-days" type="number" min="0" max="365" placeholder="Ex: 5" class="w-full rounded-xl px-3 py-2 text-xs focus:outline-none" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);">
          </div>
          <p id="event-error" class="hidden text-[10px] font-bold" style="color: #ef4444;"></p>
          <button onclick="publicarEvento()" class="w-full text-white font-bold py-2.5 rounded-xl text-xs transition-all active:scale-[0.97]" style="background: var(--accent);">
            <i class="fa-solid fa-paper-plane"></i> Publicar
          </button>
        </div>
      </div>

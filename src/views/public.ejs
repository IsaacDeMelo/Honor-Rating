                <i class="fa-solid fa-pen"></i>
              </button>
              <button onclick="alternarAnuncio('${a.id}')" class="w-8 h-8 rounded-xl flex items-center justify-center text-[10px] transition active:scale-90" style="color: var(--text-primary); background: color-mix(in srgb, var(--text-muted) 12%, transparent); border: 1px solid var(--border);" title="${a.active ? 'Desativar' : 'Ativar'}">
                <i class="fa-solid fa-${a.active ? 'toggle-on' : 'toggle-off'}"></i>

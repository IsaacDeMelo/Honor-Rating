            </div>
          </div>
          <div>
            <label class="block text-[10px] font-bold mb-1" style="color:var(--text-secondary);">Contato (visível apenas para a curadoria)</label>
            <input id="sub-contact" type="text" maxlength="200" class="w-full rounded-xl px-3 py-2 text-xs focus:outline-none" style="background:var(--bg-input);border:1px solid var(--border);color:var(--text-primary);" placeholder="WhatsApp ou e-mail para retorno da avaliação">
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-[10px] font-bold mb-1" style="color:var(--text-secondary);">Capa (2:3) *</label>
              <label for="sub-image" class="flex flex-col items-center justify-center gap-1 w-full rounded-xl py-3 text-[10px] font-bold cursor-pointer" style="background:var(--bg-input);border:1px dashed var(--border);color:var(--text-secondary);">
                <i class="fa-solid fa-image"></i><span id="sub-image-label">Escolher capa</span>
              </label>

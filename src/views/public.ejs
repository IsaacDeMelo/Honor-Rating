              <p id="perfil-contact" class="text-xs" style="color: var(--text-secondary);"></p>
            </div>
          </div>

          <button id="perfil-save-btn" onclick="salvarPerfil()" class="w-full text-white font-bold py-2.5 rounded-2xl text-xs transition-all active:scale-[0.97]" style="background: var(--accent);">
            <i class="fa-solid fa-check"></i> Salvar Perfil
          </button>

          <button id="perfil-monitor-btn" onclick="abrirMonitoramento()" class="w-full py-2.5 rounded-2xl text-xs font-bold transition-all active:scale-[0.97] hidden" style="background: color-mix(in srgb, #10b981 12%, transparent); color: #34d399; border: 1px solid rgba(52,211,153,0.3);">

            <i class="fa-solid fa-chart-simple"></i> Painel do Criador
          </button>

          <div>
            <h4 id="perfil-reviews-title" class="text-[11px] font-bold font-title mb-3 flex items-center gap-2" style="color: var(--text-primary);">

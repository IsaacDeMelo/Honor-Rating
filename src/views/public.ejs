    <!-- MODAL DE RESPONDER AVALIAÇÃO -->
    <div id="modal-responder-review" class="modal-hidden fixed inset-0 z-50 flex items-center justify-center p-4" style="background: color-mix(in srgb, var(--bg-primary) 90%, transparent);">
      <div class="rounded-3xl w-full max-w-md shadow-2xl" style="background: var(--bg-card); border: 1px solid var(--border);">
        <div class="p-5 border-b flex justify-between items-center" style="border-color: var(--border); background: var(--bg-elevated);">
          <h3 class="text-sm font-bold font-title flex items-center gap-2" style="color: var(--text-primary);">
            <i class="fa-solid fa-reply" style="color: #22c55e;"></i>
            Responder Avaliação
          </h3>
          <button onclick="fecharModalResponderReview()" class="p-2 rounded-xl transition" style="color: var(--text-muted);">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <div class="p-4 space-y-3">
          <div class="rounded-xl p-3 border" style="background: color-mix(in srgb, var(--bg-card) 60%, transparent); border-color: var(--border);">
            <p class="text-[11px] font-semibold mb-1" style="color: var(--text-secondary);" id="reply-review-author"></p>
            <p class="text-[11px] leading-relaxed" style="color: var(--text-muted);" id="reply-review-comment"></p>
          </div>
          <textarea id="reply-content" rows="3" class="w-full rounded-xl px-3 py-2 text-xs focus:outline-none resize-none" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);" placeholder="Escreva sua resposta como criador..."></textarea>
          <p id="reply-error" class="hidden text-[10px] font-bold" style="color: #ef4444;"></p>
          <button onclick="enviarResposta()" class="w-full text-white font-bold py-2.5 rounded-xl text-xs transition-all active:scale-[0.97]" style="background: #22c55e;">
            <i class="fa-solid fa-paper-plane"></i> Enviar Resposta
          </button>
        </div>
      </div>

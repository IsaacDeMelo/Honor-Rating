    let adEditandoId = null;

    function editarAnuncio(id) {
      const ad = adsData.find(a => a.id === id);
      if (!ad) return;
      adEditandoId = id;
      document.getElementById('ad-input-title').value = ad.title || '';
      document.getElementById('ad-input-link').value = ad.link || '';
      document.getElementById('ad-input-desc').value = ad.description || '';
      document.getElementById('ad-input-active').checked = ad.active !== false;
      const list = document.getElementById('ad-creatives-list');
      list.innerHTML = '';
      const creatives = ad.creatives || [];
      if (!creatives.length) adicionarLinhaCriativo(null);
      else creatives.forEach((c, i) => adicionarLinhaCriativo({ ...c, index: i }));
      const saveBtn = document.getElementById('ad-save-btn');
      if (saveBtn) saveBtn.innerHTML = '<i class="fa-solid fa-save"></i> Salvar alterações';
      document.getElementById('ad-error').classList.add('hidden');
      saveBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    async function salvarAnuncio() {
      const errEl = document.getElementById('ad-error');
      errEl.classList.add('hidden');
      const title = document.getElementById('ad-input-title').value.trim();
      if (!title) {
        errEl.textContent = 'Informe o nome do anunciante.';
        errEl.classList.remove('hidden');
        return;
      }
      const rows = Array.from(document.querySelectorAll('#ad-creatives-list .ad-creative-row'));
      if (!rows.length) {
        errEl.textContent = 'Adicione ao menos uma imagem ao anúncio.';
        errEl.classList.remove('hidden');
        return;
      }
      const active = document.getElementById('ad-input-active').checked;
      const form = new FormData();
      form.append('title', title);
      const link = document.getElementById('ad-input-link').value.trim();
      if (link) form.append('link', link);
      const description = document.getElementById('ad-input-desc').value.trim();
      if (description) form.append('description', description);
      form.append('active', active ? 'true' : 'false');

      try {
        if (adEditandoId) {
          const existingIndices = new Set();
          const creativesMeta = [];
          const addCreatives = [];
          rows.forEach(row => {
            const kind = row.dataset.kind;
            const placement = row.querySelector('.ad-creative-placement').value;
            const format = row.querySelector('.ad-creative-format').value;
            const slot = parseInt(row.querySelector('.ad-creative-slot').value || '0', 10);
            if (kind === 'existing') {
              existingIndices.add(parseInt(row.dataset.index, 10));
              creativesMeta.push({ index: parseInt(row.dataset.index, 10), placement, slot, format });
            } else {
              const file = row.querySelector('.ad-creative-file').files[0];
              if (file) {
                form.append('images', file);
                addCreatives.push({ placement, slot, format });
              }
            }
          });
          const ad = adsData.find(a => a.id === adEditandoId);
          const originalCount = (ad && ad.creatives ? ad.creatives : []).length;
          const removeCreatives = [];
          for (let i = 0; i < originalCount; i++) if (!existingIndices.has(i)) removeCreatives.push(i);
          form.append('removeCreatives', JSON.stringify(removeCreatives));
          form.append('creativesMeta', JSON.stringify(creativesMeta));
          form.append('addCreatives', JSON.stringify(addCreatives));
          const res = await fetch(`/api/ads/${adEditandoId}`, {
            method: 'PATCH',
            headers: { 'Authorization': 'Bearer ' + getToken() },
            body: form
          });
          const data = await res.json();
          if (!res.ok) { errEl.textContent = data.error || 'Erro ao salvar.'; errEl.classList.remove('hidden'); return; }
          adsData = adsData.map(a => a.id === adEditandoId ? data : a);
        } else {
          const creatives = [];
          let hasFile = false;
          rows.forEach(row => {
            const file = row.querySelector('.ad-creative-file').files[0];
            if (!file) return;
            hasFile = true;
            form.append('images', file);
            creatives.push({
              placement: row.querySelector('.ad-creative-placement').value,
              slot: parseInt(row.querySelector('.ad-creative-slot').value || '0', 10),
              format: row.querySelector('.ad-creative-format').value
            });
          });
          if (!hasFile) {
            errEl.textContent = 'Escolha ao menos uma imagem para o anúncio.';
            errEl.classList.remove('hidden');
            return;
          }
          form.append('creatives', JSON.stringify(creatives));
          const res = await fetch('/api/ads', {
            method: 'POST',
            headers: { 'Authorization': 'Bearer ' + getToken() },
            body: form
          });
          const data = await res.json();
          if (!res.ok) { errEl.textContent = data.error || 'Erro ao criar anúncio.'; errEl.classList.remove('hidden'); return; }
          adsData = [data, ...adsData];
        }
        resetFormAnuncios();
        renderAnuncios();
        await refreshAds();
      } catch { errEl.textContent = 'Erro de conexão.'; errEl.classList.remove('hidden'); }
    }

    async function alternarAnuncio(id) {
      const ad = adsData.find(a => a.id === id);
      if (!ad) return;
      try {
        const res = await fetch(`/api/ads/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() },
          body: JSON.stringify({ active: !ad.active })
        });
        if (!res.ok) { alert('Erro ao alternar anúncio.'); return; }
        ad.active = !ad.active;
        renderAnuncios();
        await refreshAds();
      } catch { alert('Erro de conexão.'); }
    }

    async function deletarAnuncio(id) {
      if (!confirm('Excluir este anúncio?')) return;
      try {
        const res = await fetch(`/api/ads/${id}`, {
          method: 'DELETE',
          headers: { 'Authorization': 'Bearer ' + getToken() }
        });
        if (!res.ok) { alert('Erro ao excluir anúncio.'); return; }
        adsData = adsData.filter(a => a.id !== id);
        renderAnuncios();
        await refreshAds();
      } catch { alert('Erro de conexão.'); }
    }

    async function refreshAds() {
      try {
        const res = await fetch('/api/ads');
        if (res.ok) {
          catAdsData = await res.json();
          atualizarHero();
          if (typeof renderCatalogoAds === 'function') renderCatalogoAds();
        }
      } catch {}
    }

    // ── DESTAQUES (ADMIN) ──
    function abrirModalDestaques() {
      const modal = document.getElementById('modal-destaques');
      modal.classList.remove('modal-hidden');
      renderDestaques();
    }

    function fecharModalDestaques() {
      document.getElementById('modal-destaques').classList.add('modal-hidden');
    }

    function destaquesOrdenados() {
      return [...catRpgData].sort((a, b) => {
        const fa = a.featured ? 0 : 1, fb = b.featured ? 0 : 1;
        if (fa !== fb) return fa - fb;
        return ((a.featuredOrder ?? 0) - (b.featuredOrder ?? 0)) || a.name.localeCompare(b.name);
      });
    }

    function renderDestaques() {
      const list = document.getElementById('destaques-list');
      if (!catRpgData.length) {
        list.innerHTML = '<p class="text-xs text-center py-6" style="color: var(--text-muted);">Nenhum RPG cadastrado.</p>';
        return;
      }
      const ordered = destaquesOrdenados();
      let pos = 0;
      list.innerHTML = ordered.map(r => {
        const badge = r.featured ? `<span class="text-[9px] font-bold px-1.5 py-0.5 rounded-full" style="background:var(--accent);color:#fff;">#${++pos} no carrossel</span>` : `<span class="text-[9px] font-bold px-1.5 py-0.5 rounded-full" style="background:var(--bg-input);color:var(--text-muted);border:1px solid var(--border);">fora</span>`;
        return `
        <div class="rounded-2xl p-3 border flex items-center gap-3" style="background: color-mix(in srgb, var(--bg-card) 40%, transparent); border-color: var(--border);">
          <img src="${r.image}" class="w-10 h-12 object-cover rounded-lg shrink-0" alt="">
          <div class="flex-1 min-w-0">
            <p class="text-xs font-bold truncate" style="color: var(--text-primary);">${r.name}</p>
            <p class="text-[10px] truncate" style="color: var(--text-muted);">${r.owner}</p>
            <div class="mt-1">${badge}</div>
          </div>
          <div class="flex flex-col gap-1 shrink-0">
            <div class="flex gap-1">
              <button onclick="moverDestaque('${r.name.replace(/'/g, "\\'")}', -1)" title="Subir na ordem" class="w-7 h-7 rounded-lg flex items-center justify-center text-[10px] transition active:scale-90" style="background:var(--bg-input);color:var(--text-secondary);border:1px solid var(--border);" ${r.featured ? '' : 'disabled style="opacity:.35;"'}>
                <i class="fa-solid fa-chevron-up"></i>
              </button>
              <button onclick="moverDestaque('${r.name.replace(/'/g, "\\'")}', 1)" title="Descer na ordem" class="w-7 h-7 rounded-lg flex items-center justify-center text-[10px] transition active:scale-90" style="background:var(--bg-input);color:var(--text-secondary);border:1px solid var(--border);" ${r.featured ? '' : 'disabled style="opacity:.35;"'}>
                <i class="fa-solid fa-chevron-down"></i>
              </button>
            </div>
            <button onclick="toggleDestaque('${r.name.replace(/'/g, "\\'")}', this)" class="relative w-full h-6 rounded-full transition-colors" style="background: ${r.featured ? 'var(--accent)' : 'var(--text-muted)'};" title="${r.featured ? 'Remover dos destaques' : 'Adicionar aos destaques'}">
              <span class="absolute top-0.5 w-5 h-5 rounded-full bg-white shadow transition-transform" style="${r.featured ? 'right:0.5;transform:translateX(-0)' : 'left:0.5;transform:translateX(0)'};left:${r.featured ? 'auto' : '0.5'};right:${r.featured ? '0.5' : 'auto'};"></span>
            </button>
          </div>
        </div>`;
      }).join('');
    }

    async function toggleDestaque(nome, btn) {
      const rpg = catRpgData.find(r => r.name === nome);
      if (!rpg) return;
      try {
        const res = await fetch(`/api/rpgs/${encodeURIComponent(nome)}/featured`, {
          method: 'PATCH',
          headers: { 'Authorization': 'Bearer ' + getToken() }
        });
        if (!res.ok) { alert('Erro ao alterar destaque.'); return; }
        const updated = await res.json();
        rpg.featured = updated.featured;
        if (updated.featuredOrder !== undefined) rpg.featuredOrder = updated.featuredOrder;
        renderDestaques();
        atualizarHero();
        renderFeedDestaques();
      } catch { alert('Erro de conexão.'); }
    }

    async function moverDestaque(nome, dir) {
      const feats = [...catRpgData].filter(r => r.featured).sort((a, b) => ((a.featuredOrder ?? 0) - (b.featuredOrder ?? 0)) || a.name.localeCompare(b.name));
      const idx = feats.findIndex(r => r.name === nome);
      if (idx < 0) return;
      const j = idx + dir;
      if (j < 0 || j >= feats.length) return;
      const tmp = feats[idx];
      feats[idx] = feats[j];
      feats[j] = tmp;
      const orders = feats.map((r, i) => ({ name: r.name, order: i + 1 }));
      orders.forEach(o => { const rr = catRpgData.find(x => x.name === o.name); if (rr) rr.featuredOrder = o.order; });
      renderDestaques();
      atualizarHero();
      renderFeedDestaques();
      try {
        await fetch('/api/rpgs/featured-order', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() },
          body: JSON.stringify({ orders }),
        });
      } catch {}
    }


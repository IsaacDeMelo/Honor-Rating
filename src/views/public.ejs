    function subPreview(input, imgId, labelId, metaId, esperado) {
      const f = input.files?.[0];
      const img = document.getElementById(imgId);
      const label = document.getElementById(labelId);
      const meta = metaId ? document.getElementById(metaId) : null;
      const wrap = img.closest('[id$="-preview-wrap"]') || img.parentElement;
      if (!f) {
        img.classList.add('hidden');
        if (wrap && wrap.id?.endsWith('-wrap')) wrap.classList.add('hidden');
        label.textContent = 'Escolher';
        if (meta) meta.textContent = '';
        return;
      }
      label.textContent = f.name.slice(0, 22);
      const url = URL.createObjectURL(f);
      img.src = url;
      img.classList.remove('hidden');
      if (wrap && wrap.id?.endsWith('-wrap')) wrap.classList.remove('hidden');
      if (meta) {
        meta.textContent = 'carregando dimensões...';
        const probe = new Image();
        probe.onload = () => {
          const w = probe.naturalWidth, h = probe.naturalHeight;
          const ratio = w / h;
          const alvo = esperado === '2:3' ? 2 / 3 : 16 / 9;
          const desvio = Math.abs(ratio - alvo) / alvo;
          const ok = desvio < 0.15;
          meta.innerHTML = `${w}×${h} · ${ok ? '✓ ideal ' + esperado : '⚠ foge do ' + esperado + ' (será cortada)'}`;
          meta.style.color = ok ? '#22c55e' : '#f59e0b';
        };
        probe.src = url;
      }
    }

    async function enviarSubmissao() {

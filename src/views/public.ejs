              <label class="flex items-center gap-3 p-3 cursor-pointer" style="color: var(--text-secondary);" for="reg-banner">
                <span class="p-2 rounded-lg border" style="background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent); border-color: color-mix(in srgb, var(--accent) 30%, transparent);">

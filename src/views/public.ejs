      const username = select.value;
      const errEl = document.getElementById('creator-error');
      errEl.classList.add('hidden');
      if (!username) { errEl.textContent = 'Selecione um usuário.'; errEl.classList.remove('hidden'); return; }
      const rpgNames = [...document.querySelectorAll('.creator-rpg-cb:checked')].map(cb => cb.value);
      try {
        const res = await fetch(`/api/creators/${encodeURIComponent(username)}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() },
          body: JSON.stringify({ rpgNames })
        });
        const data = await res.json();
        if (!res.ok) { errEl.textContent = data.error || 'Erro ao salvar.'; errEl.classList.remove('hidden'); return; }
        const user = catUsersData.find(u => u.username === username);
        if (user) user.creatorOf = data.creatorOf || [];
        if (getUser() && getUser().username === username) {
          const me = getUser();
          me.creatorOf = data.creatorOf || [];
          localStorage.setItem(USER_KEY, JSON.stringify(me));

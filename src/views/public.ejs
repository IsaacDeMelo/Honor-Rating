            </button>
            <button id="btn-deletar-detalhe" onclick="deletarRpgDoDetalhe()" class="hidden px-3 py-2.5 rounded-2xl text-xs font-bold transition-all active:scale-[0.97] flex items-center justify-center gap-1.5" style="background: transparent; color: #f87171; border: 1px solid rgba(248,113,113,0.3);">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
          <div class="flex justify-end">
            <button onclick="abrirModalDenuncia()" class="text-[10px] underline opacity-60 hover:opacity-100 transition" style="color:var(--text-muted);" title="Reportar problema neste RPG">
              <i class="fa-solid fa-flag text-[8px] mr-1"></i>denunciar
            </button>
          </div>

          <div class="detalhe-reviews pt-2 border-t" style="border-color: var(--border);">
            <h4 class="text-xs font-bold font-title mb-3 flex items-center gap-2" style="color: var(--text-primary);">
              <i class="fa-solid fa-comments text-[10px]" style="color: var(--accent);"></i>
              Críticas
            </h4>

          <button id="perfil-logout-btn" onclick="fazerLogout()" class="w-full py-2.5 rounded-2xl text-xs font-bold transition-all active:scale-[0.97] flex items-center justify-center gap-2 hover:bg-red-500/10" style="background: transparent; color: #f87171; border: 1px solid rgba(248,113,113,0.3);">
            <i class="fa-solid fa-sign-out-alt"></i> Sair da Conta
          </button>
        </div>
      </div>
    </div>

    <!-- MODAL DE MONITORAMENTO (ADMIN) -->
    <div id="modal-monitoramento" onclick="if(event.target===this)fecharMonitoramento()" class="modal-hidden fixed inset-0 z-50 flex items-center justify-center p-4" style="background: color-mix(in srgb, var(--bg-primary) 90%, transparent);">
      <div class="rounded-3xl w-full max-w-2xl max-h-[90vh] overflow-y-auto shadow-2xl" style="background: var(--bg-card); border: 1px solid var(--border);">
        <div class="p-5 border-b flex justify-between items-center sticky top-0 z-10" style="border-color: var(--border); background: var(--bg-elevated);">
          <h3 class="text-sm font-bold font-title flex items-center gap-2" style="color: var(--text-primary);">
            <i class="fa-solid fa-chart-line" style="color: #10b981;"></i>
            Monitoramento de Tráfego
          </h3>
          <button onclick="fecharMonitoramento()" class="p-2 rounded-xl transition" style="color: var(--text-muted);">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <div class="p-5 space-y-5">


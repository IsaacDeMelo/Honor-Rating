    <!-- MODAL CADASTRAR RPG -->
    <div id="modal-submeter-rpg" class="modal-hidden fixed inset-0 z-50 flex items-center justify-center p-4" style="background: color-mix(in srgb, var(--bg-primary) 90%, transparent);">
      <div class="rounded-3xl w-full max-w-lg max-h-[90vh] overflow-y-auto shadow-2xl" style="background: var(--bg-card); border: 1px solid var(--border);">
        <div class="p-5 border-b flex justify-between items-center sticky top-0 z-10" style="border-color: var(--border); background: var(--bg-elevated);">
          <h3 class="text-sm font-bold font-title flex items-center gap-2" style="color: var(--text-primary);">
            <i class="fa-regular fa-circle-question" style="color:var(--text-muted);"></i>
            Cadastrar RPG
          </h3>
          <button onclick="fecharModalSubmeterRpg()" class="p-2 rounded-xl transition" style="color: var(--text-muted);">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <div class="p-4 space-y-3">
          <p class="text-[10px] leading-relaxed" style="color:var(--text-muted);">Envie os dados do seu RPG para avaliação da nossa equipe de curadoria. Se aprovado, ele entra no catálogo.</p>
          <div class="grid grid-cols-2 gap-2">
            <div class="col-span-2 sm:col-span-1">
              <label class="block text-[10px] font-bold mb-1" style="color:var(--text-secondary);">Nome do RPG *</label>
              <input id="sub-nome" type="text" maxlength="80" class="w-full rounded-xl px-3 py-2 text-xs focus:outline-none" style="background:var(--bg-input);border:1px solid var(--border);color:var(--text-primary);" placeholder="Ex: Reinos de Névoa">
            </div>
            <div class="col-span-2 sm:col-span-1">
              <label class="block text-[10px] font-bold mb-1" style="color:var(--text-secondary);">Criadora / Editora *</label>
              <input id="sub-owner" type="text" maxlength="80" class="w-full rounded-xl px-3 py-2 text-xs focus:outline-none" style="background:var(--bg-input);border:1px solid var(--border);color:var(--text-primary);" placeholder="Ex: Estúdio Lua">
            </div>
            <div>
              <label class="block text-[10px] font-bold mb-1" style="color:var(--text-secondary);">Categoria *</label>
              <input id="sub-genre" type="text" maxlength="40" class="w-full rounded-xl px-3 py-2 text-xs focus:outline-none" style="background:var(--bg-input);border:1px solid var(--border);color:var(--text-primary);" placeholder="Ex: Fantasia">
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-[10px] font-bold mb-1" style="color:var(--text-secondary);">Classificação *</label>
                <select id="sub-age" class="w-full rounded-xl px-3 py-2 text-xs focus:outline-none" style="background:var(--bg-input);border:1px solid var(--border);color:var(--text-primary);">
                  <option value="L">Livre</option>
                  <option value="10">10</option>
                  <option value="12">12</option>
                  <option value="14">14</option>
                  <option value="16">16</option>
                  <option value="18">18</option>
                </select>
              </div>
              <div>
                <label class="block text-[10px] font-bold mb-1" style="color:var(--text-secondary);">Ano</label>
                <input id="sub-year" type="text" maxlength="10" class="w-full rounded-xl px-3 py-2 text-xs focus:outline-none" style="background:var(--bg-input);border:1px solid var(--border);color:var(--text-primary);" placeholder="2026">
              </div>
            </div>
          </div>
          <div>
            <label class="block text-[10px] font-bold mb-1" style="color:var(--text-secondary);">Descrição * (mín. 20 caracteres)</label>
            <textarea id="sub-desc" rows="4" maxlength="5000" class="w-full rounded-xl px-3 py-2 text-xs focus:outline-none resize-none" style="background:var(--bg-input);border:1px solid var(--border);color:var(--text-primary);" placeholder="Sobre o que é? Como se joga? Para quantas pessoas?"></textarea>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <div>
              <label class="block text-[10px] font-bold mb-1" style="color:var(--text-secondary);">Site oficial (opcional)</label>
              <input id="sub-link" type="url" class="w-full rounded-xl px-3 py-2 text-xs focus:outline-none" style="background:var(--bg-input);border:1px solid var(--border);color:var(--text-primary);" placeholder="https://...">
            </div>
            <div>
              <label class="block text-[10px] font-bold mb-1" style="color:var(--text-secondary);">WhatsApp / Convite (opcional)</label>

                <div class="rounded-xl overflow-hidden border" style="border-color:var(--border);width:110px;aspect-ratio:2/3;background:#000;">
                  <img id="sub-image-preview" class="w-full h-full object-cover" alt="Prévia da capa 2:3">
                </div>
                <p id="sub-image-meta" class="text-[9px] text-center" style="color:var(--text-muted);"></p>
                <p class="text-[8px]" style="color:var(--text-muted);opacity:.7;">Prévia no formato do catálogo (2:3)</p>
              </div>
            </div>
            <div>
              <label class="block text-[10px] font-bold mb-1" style="color:var(--text-secondary);">Banner (16:9, opcional)</label>

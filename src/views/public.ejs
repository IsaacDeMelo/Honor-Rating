    function filtrarCatalogo() {
      const q = document.getElementById('cat-search').value.toLowerCase().trim();
      trackSearchDebounced(q);
      const top10 = document.getElementById('cat-top10');
      if (top10) top10.classList.toggle('cat-top10-hidden', !!q);
      document.querySelectorAll('#catalog-grid-container .cat-section').forEach(section => {
        if (section === top10) return;
        let visible = 0;
        section.querySelectorAll('.cat-card').forEach(card => {
          const nome = card.dataset.nome.toLowerCase();
          const genre = card.dataset.genre.toLowerCase();
          const rpg = catRpgData.find(r => r.name.toLowerCase() === nome);
          const tags = (rpg?.tags || []).map(t => t.name.toLowerCase()).join(' ');
          const match = !q || nome.includes(q) || genre.includes(q) || tags.includes(q);
          card.style.display = match ? '' : 'none';
          if (match) visible++;
        });
        const countEl = section.querySelector('.cat-genre-count');
        if (countEl) countEl.textContent = visible;
        section.style.display = visible ? '' : 'none';
      });
    }

    function ordenarCatalogo(tipo) {
      currentSort = tipo;
      document.querySelectorAll('#sort-nome, #sort-popular, #sort-nota').forEach(b => {
        b.style.background = 'var(--bg-input)';
        b.style.color = 'var(--text-muted)';
        b.style.border = '1px solid var(--border)';
      });
      const active = document.getElementById('sort-' + tipo);
      if (active) { active.style.background = 'var(--accent)'; active.style.color = 'white'; active.style.border = 'none'; }

      const container = document.getElementById('catalog-grid-container');
      const sections = [...container.querySelectorAll('.cat-section')];

      sections.forEach(s => s.classList.remove('hidden'));
      sections.forEach(s => s.querySelector('.cat-section-title')?.classList.remove('hidden'));
      sections.forEach(section => {
        const cards = [...section.querySelectorAll('.cat-card')];
        const grid = section.querySelector('.grid');
        if (tipo === 'nome') {
          cards.sort((a, b) => a.dataset.nome.localeCompare(b.dataset.nome));
        } else if (tipo === 'popular') {
          const counts = {};
          catRpgRatings.forEach(r => { counts[r.rpg.name] = r.reviewCount; });
          cards.sort((a, b) => (counts[b.dataset.nome] || 0) - (counts[a.dataset.nome] || 0));
        } else if (tipo === 'nota') {
          const avgs = {};
          catRpgRatings.forEach(r => { avgs[r.rpg.name] = r.avgRating; });
          cards.sort((a, b) => {
            const va = avgs[a.dataset.nome], vb = avgs[b.dataset.nome];
            if (va && !vb) return -1;
            if (!va && vb) return 1;
            return (vb || 0) - (va || 0);
          });
        }
        cards.forEach(c => grid.appendChild(c));
      });
    }

    function adCreativeHtml(c) {
      const ar = c.format === 'square' ? '1 / 1' : c.format === 'poster' ? '2 / 3' : '21 / 9';
      const layout = c.format === 'square' ? 'max-width:14rem;margin:0 auto;' : c.format === 'poster' ? 'max-width:11rem;margin:0 auto;' : '';
      const title = (c.title || '').replace(/"/g, '&quot;');
      const link = c.link || '';
      const desc = (c.desc || '').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      const onclick = link ? " onclick=\"window.open('" + link.replace(/'/g, "\\'") + "','_blank')\"" : ' onclick="event.stopPropagation();"';
      return `<div class="cat-ad-block" style="cursor:${link ? 'pointer' : 'default'};${layout}"${onclick}>
        <div style="position:relative;overflow:hidden;border-radius:0.75rem;border:1px solid var(--border);">
          <div style="aspect-ratio:${ar};">
            <img src="${c.image}" class="w-full h-full object-cover" alt="">
          </div>
          <div style="position:absolute;right:6px;bottom:6px;">
            <span style="font-size:8px;font-weight:700;color:rgba(255,255,255,0.95);background:rgba(0,0,0,0.55);padding:2px 7px;border-radius:6px;backdrop-filter:blur(4px);letter-spacing:0.3px;">${title}</span>
          </div>
        </div>
        ${desc ? '<p style="font-size:11px;margin-top:5px;padding:0 2px;color:var(--text-muted);">' + desc + '</p>' : ''}
      </div>`;
    }

    function renderCatalogoAds() {
      const container = document.getElementById('catalog-grid-container');
      if (!container) return;
      container.querySelectorAll('.cat-ad-block').forEach(el => el.remove());
      const sections = [...container.querySelectorAll('.cat-section')];
      const creatives = [];
      (catAdsData || []).forEach(a => {
        if (!a.active) return;
        (a.creatives || []).forEach(c => {
          if (c.placement === 'catalog' || c.placement === 'both') {
            creatives.push({ ...c, title: a.title, link: a.link, desc: a.description });
          }
        });
      });
      if (!creatives.length) return;
      creatives.sort((x, y) => (x.slot ?? 0) - (y.slot ?? 0));
      const last = sections.length;
      creatives.forEach(c => {
        const pos = Math.min(c.slot ?? 0, last);
        const ref = sections[pos];
        const tmp = document.createElement('div');
        tmp.innerHTML = adCreativeHtml(c).trim();
        while (tmp.firstChild) container.insertBefore(tmp.firstChild, ref || null);
      });
    }

    function renderCatalogo() {
      const container = document.getElementById('catalog-grid-container');
      const generos = [...new Set(catRpgData.map(r => r.genre))].sort((a, b) => a.localeCompare(b));
      const starColor = getComputedStyle(document.documentElement).getPropertyValue('--star').trim() || '#f59e0b';
      container.innerHTML = generos.map(genre => {
        const itens = catRpgData.filter(r => r.genre === genre);
        return `<div class="cat-section" data-genre="${genre.replace(/"/g, '&quot;')}">
          <h3 class="cat-section-title text-base font-title font-bold mb-4 flex items-center gap-2" style="color: var(--text-primary);">
            <span class="w-1 h-4 rounded-full inline-block" style="background: var(--accent);"></span>
            <span class="cat-genre-name">${genre}</span>
            <span class="text-[10px] font-normal" style="color: var(--text-muted);">(<span class="cat-genre-count">${itens.length}</span>)</span>
          </h3>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3">
            ${itens.map(rpg => {
              const rr = catRpgRatings.find(r => r.rpg.name === rpg.name);
              const media = rr ? rr.avgRating : 0;
              const noRevs = !rr || rr.reviewCount === 0;
              const blurClass = rpg.ageRating === '18' && rpg.blurImage ? ' cat-blur' : '';
              const desc = rpg.description ? rpg.description.substring(0, 90).replace(/"/g, '&quot;') : '';
              const owner = (rpg.owner || '').replace(/"/g, '&quot;');
              const limitedText = rpg.closed ? 'Vagas encerradas' : (rpg.slotsTotal ? ((rpg.slotsFilled || 0) + '/' + rpg.slotsTotal + ' vagas') : 'Edição limitada');
              return `<div onclick="selecionarRpgCatalogo('${rpg.name.replace(/'/g, "\\'")}', this)" class="cat-card rounded-xl overflow-hidden border" data-nome="${rpg.name.replace(/"/g, '&quot;')}" data-genre="${rpg.genre.replace(/"/g, '&quot;')}" data-owner="${owner}" data-desc="${desc}" style="background: var(--bg-card); border-color: var(--border); aspect-ratio: 2/3;">
                <img src="${rpg.image}" class="w-full h-full object-cover${blurClass}" alt="${rpg.name.replace(/"/g, '&quot;')}">
                <span class="cat-age-badge ${rpg.ageRating}">${rpg.ageRating === 'L' ? 'L' : rpg.ageRating}</span>
                <div class="cat-rating-badge absolute top-8 right-2 z-3 flex items-center gap-1 text-[9px] font-bold px-1.5 py-0.5 rounded" style="background:rgba(0,0,0,0.7);color:${starColor};backdrop-filter:blur(4px);${noRevs ? 'opacity:0.4;' : ''}">
                  <i class="fa-solid fa-star text-[7px]"></i> ${media.toFixed(1)}
                </div>
                <div class="cat-overlay"></div>
                <div class="cat-label">
                  <h4 class="font-title font-bold text-sm" style="color: white; text-shadow: 0 1px 4px rgba(0,0,0,0.8);">${rpg.name.replace(/"/g, '&quot;')}</h4>
                  <p class="text-[10px] mt-0.5 truncate" style="color: rgba(255,255,255,0.6);">${owner}</p>
                  ${rpg.limitedEdition ? `<p class="text-[9px] mt-0.5 font-bold uppercase tracking-wider flex items-center gap-1" style="color: #f59e0b; text-shadow: 0 1px 4px rgba(0,0,0,0.8);"><i class="fa-solid fa-lock text-[7px]"></i> ${limitedText}</p>` : ''}
                  <p class="text-[9px] mt-1 leading-tight line-clamp-2" style="color: rgba(255,255,255,0.5);">${desc}</p>
                </div>
              </div>`;
            }).join('')}
          </div>
        </div>`;
      }).join('');
      renderCatalogoAds();
    }

    async function refreshData() {
      try {
        const [rpgsRes, usersRes, ratingsRes] = await Promise.all([
          fetch('/api/rpgs'),
          fetch('/api/auth/users'),
          fetch('/api/rpgs/ratings'),
        ]);
        if (rpgsRes.ok) {
          const rpgs = await rpgsRes.json();
          catRpgData = rpgs;
          heroSlides = buildHeroSlides(rpgs, catAdsData);
          heroIndex = 0;
          renderCatalogo();
          atualizarHero();
          atualizarSearchOptions();
        }
        if (usersRes.ok) {
          catUsersData = await usersRes.json();
        }
        if (ratingsRes.ok) {
          catRpgRatings = await ratingsRes.json();
        }
        renderFeedDestaques();
        atualizarFeedSelo();
      } catch {}
    }

    function atualizarSearchOptions() {
      const select = document.querySelector('#form-rpg');
      if (!select) return;
      const current = select.value;
      select.innerHTML = catRpgData.map(r => `<option value="${r.name.replace(/"/g, '&quot;')}">${r.name.replace(/"/g, '&quot;')}</option>`).join('');
      select.value = current;
    }

    function atualizarMediasCatalogo() {
      document.querySelectorAll('.cat-card').forEach(card => {
        const nome = card.dataset.nome;
        const rr = catRpgRatings.find(r => r.rpg.name === nome);
        const media = rr ? rr.avgRating : 0;
        const noRevs = !rr || rr.reviewCount === 0;
        let badge = card.querySelector('.cat-rating-badge');
        if (!badge) {
          badge = document.createElement('div');
          badge.className = 'cat-rating-badge absolute top-8 right-2 z-3 flex items-center gap-1 text-[9px] font-bold px-1.5 py-0.5 rounded';
          badge.style.cssText = 'background:rgba(0,0,0,0.7);color:var(--star);backdrop-filter:blur(4px);';
          card.appendChild(badge);
        }
        badge.style.opacity = noRevs ? '0.4' : '1';
        badge.innerHTML = '<i class="fa-solid fa-star text-[7px]"></i> ' + media.toFixed(1);
      });
    }

    function atualizarHero() {
      heroSlides = buildHeroSlides(catRpgData, catAdsData);
      heroIndex = 0;
      heroIrPara(null, 0);
      const dots = document.getElementById('hero-dots');
      if (heroSlides.length < 2) {
        if (dots) dots.innerHTML = '';
        pararHero();
        return;
      }
      if (dots) {
        dots.innerHTML = heroSlides.map((_, i) => `
          <button onclick="heroIrPara(event, ${i})" class="w-1.5 h-1.5 rounded-full transition-all" style="background:${i === 0 ? 'var(--accent)' : 'rgba(255,255,255,0.4)'};${i === 0 ? 'width:16px;' : ''}"></button>
        `).join('');
      }
      iniciarHero();
    }

    function abrirPerfil() {
      const user = getUser();
      if (!user) { abrirModalLogin(); return; }
      preencherPerfil(user.username, true);
    }

    function verPerfil(username) {
      preencherPerfil(username, false);
    }

    function preencherPerfil(username, isOwn) {
      let user = catUsersData.find(u => u.username === username);
      if (!user && isOwn) {
        user = getUser();
      }
      if (!user) return;
      document.getElementById('perfil-nome').textContent = user.username;
      const roleEl = document.getElementById('perfil-role');
      const criadorRpgs = (user.creatorOf || []).filter(rn => catRpgData.some(r => r.name === rn));
      if (user.role === 'admin') {
        roleEl.textContent = 'Administrador';
        roleEl.style.background = 'color-mix(in srgb, var(--accent) 15%, transparent)';
        roleEl.style.color = 'var(--accent)';
      } else if (criadorRpgs.length) {
        roleEl.textContent = 'Criador';
        roleEl.style.background = '#22c55e20';
        roleEl.style.color = '#22c55e';
      } else {
        roleEl.textContent = 'Usuário';
        roleEl.style.background = 'color-mix(in srgb, var(--accent) 15%, transparent)';
        roleEl.style.color = 'var(--accent)';
      }
      document.getElementById('perfil-bio').value = user.bio || '';
      document.getElementById('perfil-contact').textContent = user.contact || 'Não informado';
      const avatar = document.getElementById('perfil-avatar');
      const placeholder = document.getElementById('perfil-avatar-placeholder');
      if (user.avatar) { avatar.src = user.avatar; avatar.classList.remove('hidden'); placeholder.classList.add('hidden'); }
      else { avatar.classList.add('hidden'); placeholder.classList.remove('hidden'); placeholder.textContent = user.username.charAt(0).toUpperCase(); }

      document.getElementById('perfil-camera-label').classList.toggle('hidden', !isOwn);
      document.getElementById('perfil-bio').disabled = !isOwn;
      document.getElementById('perfil-save-btn').classList.toggle('hidden', !isOwn);
      document.getElementById('perfil-monitor-btn').classList.toggle('hidden', !(isOwn && user.role === 'admin'));
      document.getElementById('perfil-logout-btn').classList.toggle('hidden', !isOwn);
      document.getElementById('perfil-reviews-heading').textContent = isOwn ? 'Minhas Críticas' : `Críticas de ${user.username}`;

      const list = document.getElementById('perfil-reviews');
      const minhas = allReviewData.filter(r => r.username === user.username);
      if (minhas.length) {
        list.innerHTML = minhas.map(r => {
          const isPending = r.status === 'pending';
          return `
          <div class="rounded-xl p-3 border" style="background:color-mix(in srgb, var(--bg-card) 50%, transparent);border-color:var(--border);">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[11px] font-semibold" style="color:var(--text-secondary);">${r.rpg.name}</span>
              <div class="flex items-center gap-2">
                ${isPending ? '<span class="text-[8px] font-bold px-1.5 py-0.5 rounded uppercase tracking-wider" style="background:#f59e0b20;color:#f59e0b;border:1px solid #f59e0b40;">Pendente</span>' : ''}
                <span class="text-[10px]" style="color:var(--star);">${'★'.repeat(Math.floor(r.rating))}${r.rating % 1 ? '½' : ''} ${r.rating}</span>
              </div>
            </div>
            <p class="text-[11px] leading-relaxed" style="color:var(--text-muted);">${r.comment}</p>
            <span class="text-[9px]" style="color:var(--text-muted);">${r.timeAgo}</span>
          </div>
        `}).join('');
      } else {
        list.innerHTML = '<p class="text-xs text-center py-4" style="color:var(--text-muted);">Nenhuma crítica.</p>';
      }

      const modal = document.getElementById('modal-perfil');
      modal.classList.remove('modal-hidden');
      carregarScorePerfil(user.username, isOwn);
    }

    function fecharPerfil() {
      document.getElementById('modal-perfil').classList.add('modal-hidden');
    }

    function escalaNivel(score) {
      if (score >= 80) return { nivel: 'Lenda', cor: '#a855f7' };
      if (score >= 60) return { nivel: 'Destaque', cor: '#22c55e' };
      if (score >= 40) return { nivel: 'Reconhecido', cor: '#10b981' };
      if (score >= 20) return { nivel: 'Emergente', cor: '#f59e0b' };
      return { nivel: 'Iniciante', cor: '#f59e0b' };
    }

    async function carregarScorePerfil(username, isOwn) {
      const chip = document.getElementById('perfil-score-chip');
      const painelBtn = document.getElementById('perfil-painel-btn');
      if (chip) chip.classList.add('hidden');
      if (painelBtn) painelBtn.classList.add('hidden');
      if (!isOwn) return;
      const user = catUsersData.find(u => u.username === username);
      const isCreator = (user?.creatorOf || []).some(rn => catRpgData.some(r => r.name === rn));
      if (!isCreator) return;
      const token = getToken();
      if (!token) return;
      try {
        const res = await fetch('/api/creators/' + encodeURIComponent(username) + '/stats', { headers: { 'Authorization': 'Bearer ' + token } });
        if (!res.ok) return;
        const stats = await res.json();
        if (chip) {
          chip.classList.remove('hidden');
          document.getElementById('perfil-score-value').textContent = stats.score;
        }
        if (painelBtn) painelBtn.classList.remove('hidden');
      } catch {}
    }

    let painelStatsCache = null;
    let painelFiltro = 'todos';

    function painelTab(f) {
      painelFiltro = f;
      ['todos', 'destaque', 'atencao'].forEach(t => {
        const el = document.getElementById('painel-tab-' + t);
        if (!el) return;
        const on = t === f;
        el.style.background = on ? 'var(--accent)' : 'transparent';
        el.style.color = on ? '#fff' : 'var(--text-muted)';
      });
      painelFiltrar();
    }

    function painelFiltrar() {
      if (!painelStatsCache) return;
      const q = (document.getElementById('painel-busca')?.value || '').toLowerCase();
      const { cor } = escalaNivel(painelStatsCache.score);
      let list = painelStatsCache.rpgs;
      if (painelFiltro === 'destaque') list = list.filter(r => r.boostedPosts > 0 || r.score >= 60);
      if (painelFiltro === 'atencao') list = list.filter(r => r.reviewCount === 0 || r.avgRating < 3.5 || r.views < 10);
      if (q) list = list.filter(r => r.rpg.name.toLowerCase().includes(q) || (r.rpg.genre || '').toLowerCase().includes(q));
      document.getElementById('painel-count').textContent = list.length + ' sistema(s)';
      const container = document.getElementById('painel-rpgs');
      if (!list.length) {
        container.innerHTML = '<p class="text-xs text-center py-6" style="color: var(--text-muted);">Nenhum sistema com esse filtro. Tente outra busca.</p>';
        return;
      }
      container.innerHTML = list.map(r => {
        const pct = Math.min(100, Math.round((r.score / 100) * 100));
        const stars = r.reviewCount > 0
          ? '<i class="fas fa-star" style="color:var(--star);font-size:8px;"></i>'.repeat(Math.floor(r.avgRating)) + (r.avgRating % 1 !== 0 ? '<i class="fas fa-star-half-alt" style="color:var(--star);font-size:8px;"></i>' : '')
          : '<i class="fa-regular fa-star" style="color:var(--text-muted);font-size:8px;"></i>';
        const statusChip = r.reviewCount === 0
          ? '<span class="text-[9px] font-bold px-1.5 py-0.5 rounded-full" style="background:#f59e0b20;color:#f59e0b;border:1px solid #f59e0b40;">Sem avaliações ainda</span>'
          : r.avgRating < 3.5
          ? '<span class="text-[9px] font-bold px-1.5 py-0.5 rounded-full" style="background:#ef444420;color:#ef4444;border:1px solid #ef444440;">Precisa de atenção</span>'
          : r.boostedPosts > 0
          ? '<span class="text-[9px] font-bold px-1.5 py-0.5 rounded-full" style="background:#22c55e20;color:#22c55e;border:1px solid #22c55e40;">Em alta no feed</span>'
          : '<span class="text-[9px] font-bold px-1.5 py-0.5 rounded-full" style="background:var(--bg-input);color:var(--text-muted);border:1px solid var(--border);">Estável</span>';
        const boostBar = Math.min(100, r.boostedPosts ? (r.boostedPosts * 40) : 0);
        return `
        <div class="rounded-2xl border overflow-hidden" style="background: color-mix(in srgb, var(--bg-elevated) 40%, transparent); border-color: var(--border);">
          <div class="flex items-stretch gap-0">
            <img src="${r.rpg.image}" class="w-20 h-auto object-cover shrink-0" alt="" style="min-height:110px;">
            <div class="flex-1 min-w-0 p-3.5 space-y-2">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <h4 class="text-xs font-bold truncate" style="color: var(--text-primary);">${r.rpg.name}</h4>
                  <p class="text-[10px] truncate" style="color:var(--text-muted);">${r.rpg.genre || ''} · ${r.rpg.owner || ''}</p>
                </div>
                <span class="text-[10px] font-bold px-2 py-1 rounded-xl shrink-0" style="background:${cor}20;color:${cor};border:1px solid ${cor}40;">${r.score}</span>
              </div>
              <div class="flex flex-wrap items-center gap-1.5">
                <div class="flex items-center gap-0.5">${stars}</div>
                <span class="text-[9px]" style="color: var(--text-muted);">${r.reviewCount > 0 ? r.avgRating.toFixed(1) + ' · ' + r.reviewCount + ' avaliações' : 'Sem notas'}</span>
                ${statusChip}
              </div>
              <div class="h-1.5 rounded-full overflow-hidden" style="background: var(--bg-input);" title="Score ${r.score}/100">
                <div class="h-full rounded-full" style="width:${pct}%; background: linear-gradient(90deg, ${cor}, #f59e0b);"></div>
              </div>
            </div>
          </div>
          <div class="grid grid-cols-4 gap-2 px-3.5 pb-2 text-center">
            <div class="rounded-xl py-2" style="background: var(--bg-input);">
              <p class="text-sm font-bold" style="color: var(--text-primary);">${r.views.toLocaleString('pt-BR')}</p>
              <p class="text-[8px] font-bold uppercase tracking-wider mt-0.5" style="color: var(--text-muted);">Acessos</p>
            </div>
            <div class="rounded-xl py-2" style="background: var(--bg-input);">
              <p class="text-sm font-bold" style="color: var(--text-primary);">${r.reviewCount}</p>
              <p class="text-[8px] font-bold uppercase tracking-wider mt-0.5" style="color: var(--text-muted);">Avaliações</p>
            </div>
            <div class="rounded-xl py-2" style="background: var(--bg-input);">
              <p class="text-sm font-bold" style="color: var(--text-primary);">${r.repliesCount}</p>
              <p class="text-[8px] font-bold uppercase tracking-wider mt-0.5" style="color: var(--text-muted);">Respostas</p>
            </div>
            <div class="rounded-xl py-2" style="background: var(--bg-input);">
              <p class="text-sm font-bold" style="color: var(--text-primary);">${r.postsCount}</p>
              <p class="text-[8px] font-bold uppercase tracking-wider mt-0.5" style="color: var(--text-muted);">Posts</p>
            </div>
          </div>
          <div class="px-3.5 pb-2">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[9px] font-bold" style="color: var(--text-muted);">Posts impulsionados</span>
              <span class="text-[9px] font-bold" style="color: ${r.boostedPosts ? '#f59e0b' : 'var(--text-muted)'};">${r.boostedPosts} em alta</span>
            </div>
            <div class="h-1.5 rounded-full overflow-hidden" style="background: var(--bg-input);">
              <div class="h-full rounded-full transition-all" style="width:${boostBar}%; background: linear-gradient(90deg, ${cor}, #f59e0b);"></div>
            </div>
          </div>
          <div class="flex gap-2 px-3.5 pb-3.5">
            <button onclick="abrirDetalheRpg('${r.rpg.name.replace(/'/g, "\\'")}')" class="flex-1 py-2 rounded-xl text-[10px] font-bold transition active:scale-[0.97]" style="background:var(--bg-input);color:var(--text-primary);border:1px solid var(--border);"><i class="fa-solid fa-eye mr-1"></i>Ver página</button>
            <button onclick="fecharPainelCriador();setTimeout(()=>abrirModalPostarEvento('${r.rpg.name.replace(/'/g, "\\'")}'),150)" class="flex-1 py-2 rounded-xl text-[10px] font-bold transition active:scale-[0.97] text-white" style="background:var(--accent);"><i class="fa-solid fa-bullhorn mr-1"></i>Postar evento</button>
          </div>
        </div>`;
      }).join('');
    }

    function abrirPainelCriador() {
      const user = getUser();
      if (!user) return;
      const modal = document.getElementById('modal-painel-criador');
      modal.classList.remove('modal-hidden');
      document.getElementById('painel-username-badge').textContent = '@' + user.username;
      document.getElementById('painel-rpgs').innerHTML = '<p class="text-xs text-center py-6" style="color: var(--text-muted);">Carregando...</p>';
      document.getElementById('painel-score-valor').textContent = '0';
      document.getElementById('painel-score-bar').style.width = '0%';
      document.getElementById('painel-nivel').textContent = 'Calculando...';
      document.getElementById('painel-total-views').textContent = '—';
      document.getElementById('painel-total-reviews').textContent = '—';
      document.getElementById('painel-media-geral').textContent = '—';
      const busca = document.getElementById('painel-busca');
      if (busca) busca.value = '';
      painelTab('todos');

      fetch('/api/creators/' + encodeURIComponent(user.username) + '/stats', { headers: { 'Authorization': 'Bearer ' + getToken() } })
        .then(r => { if (r.status === 403) { fecharPainelCriador(); return null; } return r.json(); })
        .then(stats => {
          if (!stats) return;
          painelStatsCache = stats;
          document.getElementById('painel-score-valor').textContent = stats.score;
          document.getElementById('painel-score-bar').style.width = Math.min(100, stats.score) + '%';
          const { nivel, cor } = escalaNivel(stats.score);
          const nivelEl = document.getElementById('painel-nivel');
          nivelEl.textContent = 'Nível: ' + nivel + ' · Score ' + stats.score + '/100';
          const scoreCard = document.getElementById('painel-score-card');
          scoreCard.style.background = 'linear-gradient(135deg, ' + cor + ', color-mix(in srgb, ' + cor + ' 60%, #000))';

          const totalViews = stats.rpgs.reduce((a, r) => a + (r.views || 0), 0);
          const totalReviews = stats.rpgs.reduce((a, r) => a + (r.reviewCount || 0), 0);
          const mediaGeral = totalReviews ? (stats.rpgs.reduce((a, r) => a + (r.avgRating * r.reviewCount), 0) / totalReviews) : 0;
          document.getElementById('painel-total-views').textContent = totalViews.toLocaleString('pt-BR');
          document.getElementById('painel-total-reviews').textContent = String(totalReviews);
          document.getElementById('painel-media-geral').textContent = totalReviews ? mediaGeral.toFixed(1) : '—';

          const dica = document.getElementById('painel-dica');
          if (!stats.rpgs.length) {
            dica.innerHTML = 'Você ainda não tem sistemas vinculados. Peça ao admin o selo de criador.';
          } else if (stats.rpgs.some(r => r.reviewCount === 0)) {
            dica.innerHTML = '<i class="fa-solid fa-lightbulb mr-1"></i><b>Dica:</b> sistemas sem avaliação quase não aparecem. Compartilhe o link e peça as primeiras críticas.';
          } else if (stats.rpgs.some(r => r.avgRating < 3.5 && r.reviewCount > 0)) {
            dica.innerHTML = '<i class="fa-solid fa-lightbulb mr-1"></i><b>Dica:</b> responda as críticas com nota baixa — criadores que respondem sobem mais rápido.';
          } else {
            dica.innerHTML = '<i class="fa-solid fa-fire mr-1"></i><b>Boa!</b> Seus sistemas estão bem. Publique eventos para manter o impulso no feed.';
          }

          if (!stats.rpgs.length) {
            document.getElementById('painel-rpgs').innerHTML = '<p class="text-xs text-center py-6" style="color: var(--text-muted);">Nenhum sistema vinculado ao seu selo de criador.</p>';
            document.getElementById('painel-count').textContent = '';
            return;
          }
          painelFiltrar();
        })
        .catch(() => {
          document.getElementById('painel-rpgs').innerHTML = '<p class="text-xs text-center py-6" style="color: var(--text-muted);">Erro ao carregar o painel.</p>';
        });
    }

    function fecharPainelCriador() {
      document.getElementById('modal-painel-criador').classList.add('modal-hidden');
    }

    function trackAnalytics(payload) {
      fetch('/api/analytics', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      }).catch(() => {});
    }

    let searchTrackTimer = null;
    function trackSearchDebounced(query) {
      const q = (query || '').trim();
      if (!q || q.length < 3) return;
      clearTimeout(searchTrackTimer);
      searchTrackTimer = setTimeout(() => trackAnalytics({ type: 'search', query: q }), 800);
    }

    let monTipo = 'all';
    let monCache = null;

    function abrirMonitoramento(keep) {
      const token = getToken();
      if (!token) return;
      document.getElementById('modal-monitoramento').classList.remove('modal-hidden');
      ['all', 'rpg', 'search'].forEach(t => {
        const id = t === 'all' ? 'mon-f-all' : t === 'rpg' ? 'mon-f-rpg' : 'mon-f-search';
        const el = document.getElementById(id);
        if (!el) return;
        const on = (monTipo === 'all' && t === 'all') || (monTipo === 'rpgview' && t === 'rpg') || (monTipo === 'search' && t === 'search');
        el.style.background = on ? 'var(--accent)' : 'var(--bg-input)';
        el.style.color = on ? '#fff' : 'var(--text-muted)';
      });
      if (keep && monCache) { renderMonitoramento(monCache); return; }
      document.getElementById('mon-total-visits').textContent = '...';
      document.getElementById('mon-total-rpgviews').textContent = '...';
      document.getElementById('mon-total-searches').textContent = '...';
      document.getElementById('mon-daily').innerHTML = '<p class="text-[10px] m-auto" style="color:var(--text-muted);">Carregando...</p>';
      document.getElementById('mon-top-rpgs').innerHTML = '';
      document.getElementById('mon-top-searches').innerHTML = '';

      fetch('/api/analytics/summary', { headers: { 'Authorization': 'Bearer ' + token } })
        .then(r => { if (r.status === 403) { fecharMonitoramento(); return null; } return r.json(); })
        .then(data => {
          if (!data) return;
          monCache = data;
          renderMonitoramento(data);
        })
        .catch(() => { fecharMonitoramento(); });
    }

    function renderMonitoramento(data) {
      document.getElementById('mon-total-visits').textContent = data.totalVisits.toLocaleString('pt-BR');
      document.getElementById('mon-total-rpgviews').textContent = data.totalRpgViews.toLocaleString('pt-BR');
      document.getElementById('mon-total-searches').textContent = data.totalSearches.toLocaleString('pt-BR');
      document.getElementById('mon-last7-visits').textContent = '+' + (data.last7?.visits ?? 0) + ' nos últimos 7 dias';
      document.getElementById('mon-last7-rpgviews').textContent = '+' + (data.last7?.rpgViews ?? 0) + ' nos últimos 7 dias';
      document.getElementById('mon-last7-searches').textContent = '+' + (data.last7?.searches ?? 0) + ' nos últimos 7 dias';
      document.getElementById('mon-avg').textContent = (data.avgPerDay ?? 0) + '/dia';
      document.getElementById('mon-peak').textContent = data.peakDay ? data.peakDay.day.slice(8, 10) + '/' + data.peakDay.day.slice(5, 7) + ' (' + data.peakDay.count + ')' : '—';
      const ins = document.getElementById('mon-insights');
      const conv = data.totalVisits ? Math.round((data.totalRpgViews / data.totalVisits) * 100) : 0;
      ins.innerHTML = '<i class="fa-solid fa-lightbulb mr-1"></i><b>Resumo:</b> ' + conv + '% das visitas viram um RPG · '
        + 'média de ' + (data.avgPerDay ?? 0) + ' eventos/dia · '
        + (data.peakDay ? 'pico em <b>' + data.peakDay.day + '</b> com <b>' + data.peakDay.count + '</b> eventos.' : 'sem pico ainda.');

      const valOf = (d) => monTipo === 'rpgview' ? (d.rpgview || 0) : monTipo === 'search' ? (d.search || 0) : (d.count || 0);
      const max = Math.max(...data.daily.map(valOf), 1);
      const days = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
      document.getElementById('mon-daily').innerHTML = data.daily.map(d => {
        const v = valOf(d);
        const h = Math.min(Math.max(Math.round((v / max) * 100), v ? 4 : 2), 72);
        const dt = new Date(d.day + 'T00:00:00');
        return `
        <div class="flex-1 flex flex-col items-center justify-end gap-1 h-full min-w-0">
          <span class="text-[8px] font-bold" style="color:${v ? 'var(--text-secondary)' : 'var(--text-muted)'};">${v || ''}</span>
          <div class="w-full rounded-t" style="height:${h}%; background:${v ? 'var(--accent)' : 'color-mix(in srgb, var(--border) 60%, transparent)'};" title="${d.day}: ${d.count} total · ${d.pageview || 0} visitas · ${d.rpgview || 0} RPG · ${d.search || 0} buscas"></div>
          <span class="text-[7px]" style="color:var(--text-muted);">${days[dt.getDay()]}</span>
          <span class="text-[6px]" style="color:var(--text-muted);opacity:.7;">${d.day.slice(8, 10)}/${d.day.slice(5, 7)}</span>
        </div>`;
      }).join('');

      const byRpgMap = {};
      (data.byRpg || []).forEach(b => { byRpgMap[b.rpg] = b; });
      const topR = data.topRpgs.slice(0, 8);
      const maxR = Math.max(...topR.map(t => t.count), 1);
      document.getElementById('mon-top-rpgs').innerHTML = topR.length ? topR.map((t, i) => {
        const b = byRpgMap[t.rpg];
        const extra = b ? `<span class="text-[9px] ml-2" style="color:var(--text-muted);">${b.reviews} avaliações${b.avgRating ? ' · ★ ' + b.avgRating.toFixed(1) : ''}</span>` : '';
        return `
        <div class="rounded-xl p-2.5" style="background: var(--bg-elevated); border: 1px solid var(--border);">
          <div class="flex items-center justify-between mb-1 gap-2">
            <span class="text-[11px] font-semibold truncate" style="color:var(--text-primary);"><span class="mr-1" style="color:var(--star);">#${i + 1}</span>${t.rpg.replace(/</g, '&lt;').replace(/>/g, '&gt;')}${extra}</span>
            <span class="text-[10px] font-bold shrink-0 ml-2" style="color:#f59e0b;">${t.count} views</span>
          </div>
          <div class="h-1.5 rounded-full overflow-hidden" style="background: var(--bg-input);">
            <div class="h-full rounded-full" style="width:${Math.round(t.count / maxR * 100)}%; background: linear-gradient(90deg, var(--accent), #f59e0b);"></div>
          </div>
        </div>`;
      }).join('') : '<p class="text-[10px] text-center py-3" style="color:var(--text-muted);">Nenhuma visualização registrada ainda.</p>';

      const topS = data.topSearches.slice(0, 8);
      const maxS = Math.max(...topS.map(t => t.count), 1);
      document.getElementById('mon-top-searches').innerHTML = topS.length ? topS.map((t, i) => `
        <div class="flex items-center justify-between rounded-xl p-2.5" style="background: var(--bg-elevated); border: 1px solid var(--border);">
          <span class="text-[11px] font-medium truncate" style="color:var(--text-secondary);"><i class="fa-solid fa-magnifying-glass text-[9px] mr-1.5" style="color:var(--text-muted);"></i>${t.query.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</span>
          <div class="flex items-center gap-2 shrink-0 ml-2">
            <div class="h-1.5 w-20 rounded-full overflow-hidden" style="background: var(--bg-input);">
              <div class="h-full rounded-full" style="width:${Math.round(t.count / maxS * 100)}%; background: var(--accent);"></div>
            </div>
            <span class="text-[10px] font-bold" style="color:var(--text-muted);">${t.count}</span>
          </div>
        </div>`).join('') : '<p class="text-[10px] text-center py-3" style="color:var(--text-muted);">Nenhuma busca registrada ainda.</p>';

      const rec = data.recent || [];
      document.getElementById('mon-recent').innerHTML = rec.length ? rec.slice(0, 12).map(r => {
        const icon = r.type === 'rpgview' ? 'fa-eye' : r.type === 'search' ? 'fa-magnifying-glass' : 'fa-house';
        const label = r.type === 'rpgview' ? ('RPG: ' + (r.rpg || '')) : r.type === 'search' ? ('Busca: "' + (r.query || '') + '"') : 'Visita à home';
        const when = new Date(r.createdAt).toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
        return `<div class="flex items-center gap-2 rounded-xl px-2.5 py-2" style="background:var(--bg-elevated);border:1px solid var(--border);">
          <i class="fa-solid ${icon} text-[9px]" style="color:var(--text-muted);"></i>
          <span class="text-[10px] truncate flex-1" style="color:var(--text-secondary);">${label.replace(/</g, '&lt;')}</span>
          <span class="text-[9px] shrink-0" style="color:var(--text-muted);">${when}</span>
        </div>`;
      }).join('') : '<p class="text-[10px] text-center py-3" style="color:var(--text-muted);">Sem atividade recente.</p>';
    }

    function fecharMonitoramento() {
      document.getElementById('modal-monitoramento').classList.add('modal-hidden');
    }

    async function enviarAvatar(event) {
      const file = event.target.files[0];
      if (!file) return;
      const token = getToken();
      if (!token) return;
      const formData = new FormData();
      formData.append('avatar', file);
      try {
        const res = await fetch('/api/auth/profile', { method: 'PATCH', headers: { 'Authorization': `Bearer ${token}` }, body: formData });
        const data = await res.json();
        if (!res.ok) { alert(data.error); return; }
        saveSession(token, data.user);
        const user = getUser();
        if (user?.avatar) { document.getElementById('perfil-avatar').src = user.avatar; document.getElementById('perfil-avatar').classList.remove('hidden'); document.getElementById('perfil-avatar-placeholder').classList.add('hidden'); }
        atualizarNavbar();
      } catch { alert('Erro ao enviar avatar.'); }
    }

    async function salvarPerfil() {
      const token = getToken();
      if (!token) return;
      const bio = document.getElementById('perfil-bio').value.trim();
      try {
        const res = await fetch('/api/auth/profile', { method: 'PATCH', headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` }, body: JSON.stringify({ bio }) });
        const data = await res.json();
        if (!res.ok) { alert(data.error); return; }
        saveSession(token, data.user);
        alert('Perfil salvo!');
      } catch { alert('Erro ao salvar.'); }
    }

    async function fazerLogout() {
      fecharPerfil();
      const token = getToken();
      if (token) await fetch('/api/auth/logout', { method: 'POST', headers: { 'Authorization': `Bearer ${token}` } }).catch(() => {});
      clearSession();
      atualizarNavbar();
    }

    async function verificarSessao() {
      const token = getToken();
      if (!token) return;
      try {
        const res = await fetch('/api/auth/me', { headers: { 'Authorization': `Bearer ${token}` } });
        if (res.ok) { const data = await res.json(); saveSession(token, data.user); }
        else { clearSession(); }
      } catch { clearSession(); }
      atualizarNavbar();
    }

    function mostrarErro(id, msg) { const el = document.getElementById(id); el.textContent = msg; el.classList.remove('hidden'); }
    function esconderErro(id) { document.getElementById(id).classList.add('hidden'); }

    async function fazerLogin(event) {
      event.preventDefault();
      esconderErro('login-error');
      try {
        const res = await fetch('/api/auth/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username: document.getElementById('login-username').value, password: document.getElementById('login-password').value }) });
        const data = await res.json();
        if (!res.ok) { mostrarErro('login-error', data.error); return; }
        saveSession(data.token, data.user);
        atualizarNavbar();
        fecharModalLogin();
        document.getElementById('form-login').reset();
        try {
          const usersRes = await fetch('/api/auth/users');
          if (usersRes.ok) catUsersData = await usersRes.json();
        } catch {}
      } catch { mostrarErro('login-error', 'Erro ao conectar com o servidor.'); }
    }

    function previewRegAvatar(input) {
      const file = input.files[0];
      if (!file) return;
      document.getElementById('reg-file-name').textContent = file.name;
      const reader = new FileReader();
      reader.onload = function(e) {
        const preview = document.getElementById('reg-avatar-preview');
        preview.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover">`;
      };
      reader.readAsDataURL(file);
    }

    async function fazerRegistro(event) {
      event.preventDefault();
      esconderErro('reg-error');
      try {
        const formData = new FormData();
        formData.append('username', document.getElementById('reg-username').value);
        formData.append('password', document.getElementById('reg-password').value);
        formData.append('contact', document.getElementById('reg-contact').value.trim());
        const avatarFile = document.getElementById('reg-avatar').files[0];
        if (avatarFile) formData.append('avatar', avatarFile);
        const res = await fetch('/api/auth/register', { method: 'POST', body: formData });
        const data = await res.json();
        if (!res.ok) { mostrarErro('reg-error', data.error); return; }
        saveSession(data.token, data.user);
        atualizarNavbar();
        fecharModalRegistro();
        document.getElementById('form-registro').reset();
        document.getElementById('reg-avatar-preview').innerHTML = '<i class="fa-solid fa-camera text-sm"></i>';
        document.getElementById('reg-file-name').textContent = 'Nenhum';
        try {
          const usersRes = await fetch('/api/auth/users');
          if (usersRes.ok) catUsersData = await usersRes.json();
        } catch {}
      } catch { mostrarErro('reg-error', 'Erro ao conectar com o servidor.'); }
    }

    function toggleSearch() {
      const s = document.getElementById('search-section');
      s.classList.toggle('hidden');
      if (!s.classList.contains('hidden')) document.getElementById('search-input').focus();
    }

    let feedSkip = 20;
    let feedLoading = false;
    let feedHasMore = true;
    let feedEventsLoaded = 0;
    let feedEventsDone = true;

    function iniciarFeedEventos() {
      feedEventsLoaded = catEventPostsData.length || 0;
      feedEventsDone = feedEventsLoaded < 50;
      feedHasMore = true;
    }

    async function carregarMaisFeed() {
      if (feedLoading || !feedHasMore) return;
      feedLoading = true;
      const spinner = document.getElementById('feed-spinner');
      const loader = document.getElementById('feed-loader');
      spinner.classList.remove('hidden');
      if (loader) loader.classList.add('hidden');
      try {
        if (!feedEventsDone) {
          const res = await fetch('/api/feed/events?skip=' + feedEventsLoaded + '&limit=20');
          if (!res.ok) { feedEventsDone = true; }
          else {
            const posts = await res.json();
            posts.forEach(p => {
              document.getElementById('feed-container').insertBefore(criarCardEvento(p), spinner);
            });
            feedEventsLoaded += posts.length;
            if (posts.length < 20) feedEventsDone = true;
          }
        }
        if (feedEventsDone && feedHasMore) {
          const res = await fetch('/api/reviews/feed?skip=' + feedSkip + '&limit=20');
          if (!res.ok) { feedHasMore = false; return; }
          const reviews = await res.json();
          if (reviews.length < 20) feedHasMore = false;
          feedSkip += reviews.length;
          const container = document.getElementById('feed-container');
          reviews.forEach(r => {
            const card = criarCardFeed(r);
            container.insertBefore(card, spinner);
          });
        }
      } catch { feedEventsDone = true; feedHasMore = false; }
      finally {
        feedLoading = false;
        spinner.classList.add('hidden');
        if (feedHasMore && loader) loader.classList.remove('hidden');
      }
    }

    function criarCardFeed(r) {
      const div = document.createElement('div');
      div.className = 'feed-card rounded-2xl p-4.5 border transition-all duration-300 shadow-sm flex flex-col space-y-3.5';
      div.style.background = 'color-mix(in srgb, var(--bg-card) 40%, transparent)';
      div.style.borderColor = 'var(--border)';
      div.setAttribute('data-rpg', r.rpg.name);
      const starColor = getComputedStyle(document.documentElement).getPropertyValue('--star').trim() || '#f59e0b';
      const user = catUsersData.find(u => u.username === r.username);
      const avatarHtml = user && user.avatar
        ? '<img src="' + user.avatar + '" class="w-full h-full object-cover" alt="">'
        : r.username.charAt(0).toUpperCase();
      div.innerHTML = `
        <div class="flex items-center space-x-3 p-2.5 rounded-xl border" style="background: color-mix(in srgb, var(--bg-elevated) 40%, transparent); border-color: var(--border);">
          <img src="${r.customImage || r.rpg.image}" class="w-12 h-14 object-cover rounded-lg shadow-md" alt="Capa ${r.rpg.name}">
          <div class="flex-1 min-w-0">
            <span class="text-[9px] font-bold px-1.5 py-0.5 rounded tracking-wide uppercase font-title" style="background: var(--accent-dim); color: var(--accent);">${r.rpg.genre}</span>
            <h3 class="font-title font-bold text-sm truncate mt-0.5 cursor-pointer hover:underline" style="color: var(--text-primary);" onclick="abrirDetalheRpg('${r.rpg.name.replace(/'/g, "\\'")}')">${r.rpg.name}</h3>
            <p class="text-[10px] truncate flex items-center gap-1" style="color: var(--text-muted);">Por: <span class="rpg-owner">${r.rpg.owner}</span></p>
          </div>
        </div>
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2.5">
            <div onclick="verPerfil('${r.username}')" class="w-9 h-9 rounded-full flex items-center justify-center font-bold text-sm overflow-hidden shrink-0 cursor-pointer" style="background: var(--accent-dim); border: 1px solid var(--border-accent); color: var(--accent);">${avatarHtml}</div>
            <div>
              <h4 onclick="verPerfil('${r.username}')" class="font-bold text-xs cursor-pointer hover:underline inline-flex items-center gap-1" style="color: var(--text-secondary);">${r.username}
                <span class="creator-badge hidden items-center gap-0.5 text-[7px] font-bold px-1 py-0.5 rounded-full" data-creator="${r.username}" style="background:#22c55e20;color:#22c55e;border:1px solid #22c55e40;"><i class="fa-solid fa-award"></i>Criador</span>
              </h4>
              <span class="text-[9px]" style="color: var(--text-muted);">${r.timeAgo}</span>
            </div>
          </div>
          <div class="flex items-center space-x-0.5 text-[10px] px-2 py-1 rounded-full border" style="color: ${starColor}; background: color-mix(in srgb, ${starColor} 10%, transparent); border-color: color-mix(in srgb, ${starColor} 20%, transparent);">
            ${'<i class="fas fa-star"></i>'.repeat(Math.floor(r.rating))}${r.rating % 1 !== 0 ? '<i class="fas fa-star-half-alt"></i>' : ''}${'<i class="far fa-star text-slate-700"></i>'.repeat(5 - Math.ceil(r.rating))}
            <span class="text-[10px] ml-1 font-semibold" style="color: ${starColor};">${r.rating}</span>
          </div>
        </div>
        <p class="text-xs leading-relaxed comment-text pl-1" style="color: var(--text-secondary);">${r.comment}</p>
        <div class="flex justify-end">
          <button onclick="deletarAvaliacao('${r.id}', this)" class="review-delete-btn text-[9px] px-2 py-1 rounded-lg font-bold transition-all hidden active:scale-[0.94]" style="color: #ef4444; background: color-mix(in srgb, #ef4444 10%, transparent); border: 1px solid color-mix(in srgb, #ef4444 20%, transparent);" data-owner="${r.username}">
            <i class="fa-solid fa-trash-alt mr-1"></i>Excluir
          </button>
        </div>`;
      const storedUser = getUser();
      if (storedUser) {
        const btn = div.querySelector('.review-delete-btn');
        if (btn) btn.classList.toggle('hidden', !(storedUser.role === 'admin' || storedUser.username === r.username));
      }
      return div;
    }

    // ── POSTAR EVENTO ──
    function abrirModalPostarEvento(preRpg) {
      const user = getUser();
      if (!user) { abrirModalLogin(); return; }
      const u = catUsersData.find(x => x.username === user.username);
      const isAdmin = user.role === 'admin';
      const meusRpgs = (u?.creatorOf || []).filter(rn => catRpgData.some(r => r.name === rn));
      const todosRpgs = catRpgData.map(r => r.name);
      const opcoes = isAdmin ? todosRpgs : meusRpgs;
      if (!opcoes.length) { alert('Você não é criador de nenhum sistema.'); return; }
      const select = document.getElementById('event-rpg-select');
      select.innerHTML = (isAdmin ? `<option value="__geral__">Comunicado geral (sem RPG)</option>` : '')
        + opcoes.map(rn => `<option value="${rn.replace(/"/g, '&quot;')}">${rn}</option>`).join('');
      if (preRpg && opcoes.includes(preRpg)) select.value = preRpg;
      document.getElementById('event-title').value = '';
      document.getElementById('event-content').value = '';
      document.getElementById('event-tags').value = '';
      const fi = document.getElementById('event-image');
      if (fi) fi.value = '';
      document.getElementById('event-image-label').textContent = 'Anexar imagem';
      document.getElementById('event-image-preview').classList.add('hidden');
      document.getElementById('event-image-preview').innerHTML = '';
      document.getElementById('event-pin-box').classList.toggle('hidden', user.role !== 'admin');
      const pinInput = document.getElementById('event-pinned-days');
      if (pinInput) pinInput.value = '';
      document.getElementById('event-error').classList.add('hidden');
      document.getElementById('modal-postar-evento').classList.remove('modal-hidden');
    }

    function eventImagePreview(input) {
      const box = document.getElementById('event-image-preview');
      const label = document.getElementById('event-image-label');
      const f = input.files?.[0];
      if (!f) { box.classList.add('hidden'); box.innerHTML = ''; label.textContent = 'Anexar imagem'; return; }
      label.textContent = f.name.slice(0, 24);
      box.innerHTML = `<img src="${URL.createObjectURL(f)}" class="w-full max-h-44 object-cover rounded-xl border" style="border-color:var(--border);">`;
      box.classList.remove('hidden');
    }

    function fecharModalPostarEvento() {
      document.getElementById('modal-postar-evento').classList.add('modal-hidden');
    }

    async function publicarEvento() {
      const errEl = document.getElementById('event-error');
      errEl.classList.add('hidden');
      const rpgName = document.getElementById('event-rpg-select').value;
      const title = document.getElementById('event-title').value.trim();
      const content = document.getElementById('event-content').value.trim();
      const tags = document.getElementById('event-tags').value.trim();
      if (!title || !content) { errEl.textContent = 'Preencha título e descrição.'; errEl.classList.remove('hidden'); return; }
      const btn = document.querySelector('#modal-postar-evento button[onclick="publicarEvento()"]');
      if (btn) { btn.disabled = true; btn.style.opacity = '.6'; }
      try {
        const form = new FormData();
        if (rpgName && rpgName !== '__geral__') form.append('rpgName', rpgName);
        form.append('title', title);
        form.append('content', content);
        if (tags) form.append('tags', tags);
        const imgFile = document.getElementById('event-image').files?.[0];
        if (imgFile) form.append('image', imgFile);
        const pinDays = document.getElementById('event-pinned-days')?.value;
        if (pinDays && Number(pinDays) > 0) form.append('pinnedDays', String(Number(pinDays)));
        const headers = { 'Authorization': 'Bearer ' + getToken() };
        const res = await fetch('/api/posts', { method: 'POST', headers, body: form });
        const data = await res.json();
        if (!res.ok) { errEl.textContent = data.error || 'Erro ao publicar.'; errEl.classList.remove('hidden'); return; }
        fecharModalPostarEvento();
        await refreshPosts();
        abrirFeed();
      } catch { errEl.textContent = 'Erro de conexão.'; errEl.classList.remove('hidden'); }
      finally { if (btn) { btn.disabled = false; btn.style.opacity = '1'; } }
    }

    async function deletarEvento(id, btn) {
      if (!confirm('Excluir esta postagem?')) return;
      try {
        const res = await fetch(`/api/posts/${id}`, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + getToken() } });
        if (!res.ok) { alert('Erro ao excluir.'); return; }
        const card = btn.closest('.feed-event-card');
        if (card) card.remove();
        catEventPostsData = catEventPostsData.filter(p => p.id !== id);
      } catch { alert('Erro de conexão.'); }
    }

    async function refreshPosts() {
      try {
        const res = await fetch('/api/posts');
        if (res.ok) {
          const posts = await res.json();
          const container = document.getElementById('feed-container');
          if (!container) return;
          const spinner = document.getElementById('feed-spinner');
          const existentes = [...container.querySelectorAll('.feed-event-card')];
          existentes.forEach(e => e.remove());
          posts.forEach(p => {
            container.insertBefore(criarCardEvento(p), spinner);
          });
          catEventPostsData = posts;
          iniciarFeedEventos();
        }
      } catch {}
    }

    function criarCardEvento(p) {
      const div = document.createElement('div');
      div.className = 'feed-card feed-event-card rounded-2xl p-4.5 border transition-all duration-300 shadow-sm flex flex-col space-y-3.5';
      div.style.background = 'color-mix(in srgb, #22c55e 6%, var(--bg-card) 40%, transparent)';
      div.style.borderColor = 'color-mix(in srgb, #22c55e 30%, var(--border))';
      div.setAttribute('data-rpg', p.rpg ? p.rpg.name : '');
      const isGeral = !p.rpg;
      const selo = isGeral ? 'Comunicado' : 'Evento do Criador';
      const diasFixado = p.pinned && p.pinnedUntil ? Math.max(1, Math.ceil((new Date(p.pinnedUntil).getTime() - Date.now()) / 86400000)) : 0;
      const impulso = p.pinned
        ? `<span class="text-[9px] font-bold px-2 py-0.5 rounded-full shrink-0" style="background:#a855f720;color:#c084fc;border:1px solid #a855f740;" title="Fixado pelo admin até ${new Date(p.pinnedUntil).toLocaleDateString('pt-BR')}."><i class="fa-solid fa-thumbtack text-[8px] mr-1"></i>Fixado · ${diasFixado}d</span>`
        : (p.boosted
          ? `<span class="text-[9px] font-bold px-2 py-0.5 rounded-full shrink-0" style="background:#f59e0b20;color:#f59e0b;border:1px solid #f59e0b40;" title="Quanto mais avaliações boas o sistema tem, mais tempo este post fica no topo."><i class="fa-solid fa-rocket text-[8px] mr-1"></i>Em alta · ${Math.round(p.boostHours)}h</span>`
          : `<span class="text-[9px] font-bold px-2 py-0.5 rounded-full shrink-0" style="background:var(--bg-input);color:var(--text-muted);border:1px solid var(--border);" title="O impulso deste post terminou e ele está caindo conforme o tempo."><i class="fa-solid fa-arrow-trend-down text-[8px] mr-1"></i>Caindo</span>`);
      const rpgBlock = p.rpg ? `
        <div class="flex items-center space-x-3 p-2.5 rounded-xl border" style="background: color-mix(in srgb, var(--bg-elevated) 40%, transparent); border-color: var(--border);">
          <img src="${p.rpg.image}" class="w-12 h-14 object-cover rounded-lg shadow-md" alt="">
          <div class="flex-1 min-w-0">
            <span class="text-[9px] font-bold px-1.5 py-0.5 rounded tracking-wide uppercase font-title" style="background: #22c55e; color: white;">${p.rpg.genre}</span>
            <h3 class="font-title font-bold text-sm truncate mt-0.5 cursor-pointer hover:underline" style="color: var(--text-primary);" onclick="abrirDetalheRpg('${p.rpg.name.replace(/'/g, "\\'")}')">${p.rpg.name}</h3>
            <p class="text-[10px] truncate" style="color: var(--text-muted);">Por: ${p.rpg.owner}</p>
          </div>
        </div>` : '';
      const tagsHtml = (p.tags && p.tags.length) ? `<div class="flex flex-wrap gap-1 pl-1">${p.tags.map(t => `<span class="text-[9px] px-2 py-0.5 rounded-full font-medium" style="background:color-mix(in srgb, #22c55e 12%, transparent);color:#22c55e;border:1px solid color-mix(in srgb, #22c55e 25%, transparent);">#${String(t).replace(/</g, '&lt;')}</span>`).join('')}</div>` : '';
      div.innerHTML = `
        <div class="flex items-center justify-between gap-2">
          <span class="text-[9px] font-bold px-2 py-0.5 rounded-full tracking-wide uppercase shrink-0" style="background:#22c55e20;color:#22c55e;border:1px solid #22c55e40;"><i class="fa-solid fa-bullhorn text-[8px] mr-1"></i>${selo}</span>
          ${impulso}
          <span class="text-[9px]" style="color: var(--text-muted);">${p.timeAgo}</span>
        </div>
        ${rpgBlock}
        <h4 class="text-sm font-bold" style="color: var(--text-primary);">${p.title}</h4>
        ${p.image ? `<a href="${p.image}" target="_blank" rel="noopener"><img src="${p.image}" class="w-full object-contain rounded-xl border" style="border-color:var(--border);max-height:75vh;background:#000;" loading="lazy" alt=""></a>` : ''}
        <p class="text-xs leading-relaxed pl-1" style="color: var(--text-secondary);">${p.content}</p>
        ${tagsHtml}
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-semibold flex items-center gap-1" style="color: #22c55e;"><i class="fa-solid fa-award"></i> ${p.username}</span>
          <span class="inline-flex items-center gap-1.5">
            <button onclick="fixarPost('${p.id}')" class="event-pin-btn text-[9px] px-2 py-1 rounded-lg font-bold transition-all hidden active:scale-[0.94]" style="color: #c084fc; background: color-mix(in srgb, #a855f7 10%, transparent); border: 1px solid color-mix(in srgb, #a855f7 25%, transparent);">
              <i class="fa-solid fa-thumbtack mr-1"></i>${p.pinned ? 'Ajustar' : 'Fixar'}
            </button>
            <button onclick="deletarEvento('${p.id}', this)" class="event-delete-btn text-[9px] px-2 py-1 rounded-lg font-bold transition-all hidden active:scale-[0.94]" style="color: #ef4444; background: color-mix(in srgb, #ef4444 10%, transparent); border: 1px solid color-mix(in srgb, #ef4444 20%, transparent);" data-owner="${p.username}">
              <i class="fa-solid fa-trash-alt mr-1"></i>Excluir
            </button>
          </span>
        </div>`;
      const storedUser = getUser();
      if (storedUser) {
        const btn = div.querySelector('.event-delete-btn');
        if (btn) btn.classList.toggle('hidden', !(storedUser.role === 'admin' || storedUser.username === p.username));
        const pinBtn = div.querySelector('.event-pin-btn');
        if (pinBtn) pinBtn.classList.toggle('hidden', storedUser.role !== 'admin');
      }
      return div;
    }

    async function fixarPost(id) {
      const user = getUser();
      if (!user || user.role !== 'admin') return;
      const atual = (typeof catEventPostsData !== 'undefined' ? catEventPostsData : []).find(p => p.id === id);
      const entrada = prompt(
        atual?.pinned ? 'Post fixado. Digite 0 para desafixar ou N dias para ajustar:' : 'Fixar este post no topo por quantos dias? (0 cancela)',
        atual?.pinned ? '0' : '5'
      );
      if (entrada === null) return;
      const days = Number(entrada);
      if (!Number.isFinite(days) || days < 0 || days > 365) { alert('Digite um número de 0 a 365.'); return; }
      try {
        const res = await fetch('/api/posts/' + id + '/pin', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() },
          body: JSON.stringify({ days })
        });
        if (!res.ok) { alert('Erro ao fixar.'); return; }
        await refreshPosts();
      } catch { alert('Erro de conexão.'); }
    }

    // Usuários em destaque: top avaliadores + donos de RPGs do top 10
    function calcularSpotlight() {
      const top10 = (catRpgRatings || []).slice(0, 10).map(x => x.rpg.name);
      const cont = {};
      (allReviewData || []).forEach(r => { cont[r.username] = (cont[r.username] || 0) + 1; });
      return (catUsersData || [])
        .map(u => {
          const n = cont[u.username] || 0;
          const tops = (u.creatorOf || []).filter(nm => top10.includes(nm));
          return { u, n, tops, score: n + tops.length * 5 };
        })
        .filter(x => x.n > 0 || x.tops.length > 0)
        .sort((a, b) => b.score - a.score || a.u.username.localeCompare(b.u.username))
        .slice(0, 10);
    }

    function renderFeedDestaques() {
      const section = document.getElementById('feed-destaques-section');
      if (!section) return;
      const spot = calcularSpotlight();
      if (!spot.length) { section.style.display = 'none'; return; }
      section.style.display = '';
      const container = section.querySelector('.no-scrollbar');
      container.innerHTML = spot.map(s => {
        const avatar = s.u.avatar
          ? `<img src="${s.u.avatar}" class="w-full h-full object-cover rounded-full" alt="">`
          : `<span class="w-full h-full rounded-full flex items-center justify-center text-xl font-bold" style="background: var(--accent-dim); color: var(--accent);">${s.u.username.charAt(0).toUpperCase()}</span>`;
        const mini = s.tops.length
          ? '<i class="fa-solid fa-trophy" style="color:var(--star);font-size:6px;"></i><span class="text-[8px] ml-0.5 font-semibold" style="color:var(--text-muted);">Top 10</span>'
          : `<i class="fas fa-star" style="color:var(--star);font-size:6px;"></i><span class="text-[8px] ml-0.5 font-semibold" style="color:var(--text-muted);">${s.n}</span>`;
        return `
          <button onclick="verPerfil('${s.u.username.replace(/'/g, "\\'")}')" class="flex flex-col items-center space-y-1 flex-shrink-0 focus:outline-none group" title="${s.tops.length ? 'Dono de RPG no Top 10: ' + s.tops.join(', ') : s.n + ' avaliações'}">
            <div class="w-16 h-16 rounded-full p-0.5 overflow-hidden transition-all duration-300 group-hover:scale-105" style="box-shadow: 0 0 0 2px var(--accent-glow); background: var(--bg-card);">
              ${avatar}
            </div>
            <span style="color: var(--text-secondary);" class="text-[11px] font-medium truncate w-16 text-center group-hover:text-white transition">${s.u.username}</span>
            <div class="flex items-center gap-[1px]">${mini}</div>
          </button>`;
      }).join('');
    }

    // ── RESPONDER AVALIAÇÕES ──
    let replyReviewId = null;

    function abrirModalResponderReview(reviewId, username, comment) {
      const user = getUser();
      if (!user) { abrirModalLogin(); return; }
      replyReviewId = reviewId;
      document.getElementById('reply-review-author').textContent = `Avaliação de ${username}`;
      document.getElementById('reply-review-comment').textContent = comment;
      document.getElementById('reply-content').value = '';
      document.getElementById('reply-error').classList.add('hidden');
      document.getElementById('modal-responder-review').classList.remove('modal-hidden');
    }

    function fecharModalResponderReview() {
      document.getElementById('modal-responder-review').classList.add('modal-hidden');
      replyReviewId = null;
    }

    async function enviarResposta() {
      const errEl = document.getElementById('reply-error');
      errEl.classList.add('hidden');
      const content = document.getElementById('reply-content').value.trim();
      if (!content) { errEl.textContent = 'Escreva sua resposta.'; errEl.classList.remove('hidden'); return; }
      if (!replyReviewId) return;
      try {
        const res = await fetch(`/api/reviews/${replyReviewId}/replies`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() },
          body: JSON.stringify({ content })
        });
        const data = await res.json();
        if (!res.ok) { errEl.textContent = data.error || 'Erro ao responder.'; errEl.classList.remove('hidden'); return; }
        fecharModalResponderReview();
        await carregarRespostas(replyReviewId, document.querySelector('[data-reviews-list="' + replyReviewId + '"]'));
        replyReviewId = null;
      } catch { errEl.textContent = 'Erro de conexão.'; errEl.classList.remove('hidden'); }
    }

    async function carregarRespostas(reviewId, container) {
      if (!container) return;
      try {
        const res = await fetch(`/api/reviews/${reviewId}/replies`);
        if (!res.ok) return;
        const replies = await res.json();
        catRepliesData[reviewId] = replies;
        renderRespostas(reviewId, container);
      } catch {}
    }

    function renderRespostas(reviewId, container) {
      if (!container) return;
      const replies = catRepliesData[reviewId] || [];
      if (!replies.length) { container.innerHTML = ''; container.classList.add('hidden'); return; }
      container.classList.remove('hidden');
      container.innerHTML = replies.map(rep => `
        <div class="rounded-xl p-2.5 border flex items-start gap-2" style="background: color-mix(in srgb, #22c55e 6%, transparent); border-color: color-mix(in srgb, #22c55e 25%, transparent);">
          <i class="fa-solid fa-award text-[10px] mt-0.5" style="color: #22c55e;"></i>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-1.5 mb-0.5">
              <span class="text-[10px] font-bold" style="color: #22c55e;">${rep.username}</span>
              <span class="text-[8px] font-bold px-1 py-0.5 rounded uppercase" style="background:#22c55e20;color:#22c55e;border:1px solid #22c55e40;">Criador</span>
              <span class="text-[8px] ml-auto" style="color: var(--text-muted);">${rep.timeAgo}</span>
            </div>
            <p class="text-[10px] leading-relaxed" style="color: var(--text-secondary);">${rep.content.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</p>
          </div>
          <button onclick="deletarResposta('${rep.id}', this)" class="reply-delete-btn hidden text-[9px] px-1.5 py-0.5 rounded-lg font-bold shrink-0" style="color: #ef4444; background: color-mix(in srgb, #ef4444 10%, transparent);" data-owner="${rep.username}">
            <i class="fa-solid fa-trash-alt"></i>
          </button>
        </div>`).join('');
      const storedUser = getUser();
      if (storedUser) {
        container.querySelectorAll('.reply-delete-btn').forEach(b => {
          b.classList.toggle('hidden', !(storedUser.role === 'admin' || storedUser.username === b.getAttribute('data-owner')));
        });
      }
    }

    async function deletarResposta(id, btn) {
      if (!confirm('Excluir esta resposta?')) return;
      try {
        const res = await fetch(`/api/replies/${id}`, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + getToken() } });
        if (!res.ok) { alert('Erro ao excluir.'); return; }
        const box = btn.closest('.review-replies-box');
        if (box) box.remove();
      } catch { alert('Erro de conexão.'); }
    }

    // Infinite scroll: carrega mais ao chegar no final
    let feedObserver = null;
    document.addEventListener('DOMContentLoaded', function() {
      const spinner = document.getElementById('feed-spinner');
      if (!spinner) return;
      iniciarFeedEventos();
      feedObserver = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting && feedHasMore) {
          carregarMaisFeed();
        }
      }, { rootMargin: '200px' });
      feedObserver.observe(spinner);
    });

    function buscarNoFeed() {
      const q = document.getElementById('search-input').value.toLowerCase();
      trackSearchDebounced(q);
      document.querySelectorAll('.feed-card').forEach(c => { c.style.display = c.textContent.toLowerCase().includes(q) ? 'flex' : 'none'; });
    }

    function filtrarRPG(nome) {
      document.querySelectorAll('.feed-card').forEach(c => { c.style.display = c.getAttribute('data-rpg') === nome ? 'flex' : 'none'; });
    }

    function limparFiltros() {
      document.querySelectorAll('.feed-card').forEach(c => c.style.display = 'flex');
      document.getElementById('search-input').value = '';
    }

    function abrirModalAvaliacao(rpgNome) {
      const user = getUser();
      if (!user) { abrirModalLogin(); return; }
      document.getElementById('current-user-name').textContent = user.username;
      const badge = document.getElementById('current-user-badge');
      const avatarImg = document.getElementById('current-user-avatar-img');
      const avatarLetter = document.getElementById('current-user-avatar-letter');
      if (user.avatar) { avatarImg.src = user.avatar; avatarImg.classList.remove('hidden'); avatarLetter.classList.add('hidden'); }
      else { avatarImg.classList.add('hidden'); avatarLetter.classList.remove('hidden'); avatarLetter.textContent = user.username.charAt(0).toUpperCase(); }
      document.getElementById('form-rating').value = '0';
      document.querySelectorAll('#star-rating i').forEach(s => { s.className = 'fa-regular fa-star cursor-pointer transition-colors'; s.style.color = 'var(--text-muted)'; });
      document.getElementById('rating-label').textContent = '-';
      document.getElementById('form-comment').value = '';
      document.getElementById('form-image').value = '';
      document.getElementById('file-name').textContent = 'Nenhum';
      if (rpgNome) {
        const select = document.getElementById('form-rpg');
        for (let opt of select.options) { if (opt.value === rpgNome) { select.value = rpgNome; break; } }
      }
      document.getElementById('modal-avaliacao').classList.remove('modal-hidden');
    }

    function fecharModalAvaliacao() { document.getElementById('modal-avaliacao').classList.add('modal-hidden'); }
    function abrirModalLogin() { esconderErro('login-error'); document.getElementById('form-login').reset(); document.getElementById('modal-login').classList.remove('modal-hidden'); }
    function fecharModalLogin() { document.getElementById('modal-login').classList.add('modal-hidden'); }
    function abrirModalRegistro() { fecharModalLogin(); esconderErro('reg-error'); document.getElementById('form-registro').reset(); document.getElementById('modal-registro').classList.remove('modal-hidden'); }
    function fecharModalRegistro() { document.getElementById('modal-registro').classList.add('modal-hidden'); }
    function atualizarNomeArquivo(input) { document.getElementById('file-name').textContent = input.files.length > 0 ? input.files[0].name : 'Nenhum arquivo selecionado'; }
    function abrirConfiguracoes() { document.getElementById('modal-config').classList.remove('modal-hidden'); }
    function fecharConfiguracoes() { document.getElementById('modal-config').classList.add('modal-hidden'); }

    document.querySelectorAll('#star-rating i').forEach(star => {
      star.addEventListener('click', function() {
        const value = parseInt(this.dataset.value);
        document.getElementById('form-rating').value = value;
        const starColor = getComputedStyle(document.documentElement).getPropertyValue('--star').trim() || '#f59e0b';
        const mutedColor = getComputedStyle(document.documentElement).getPropertyValue('--text-muted').trim() || '#64748b';
        document.querySelectorAll('#star-rating i').forEach((s, i) => {
          s.className = i < value ? 'fa-solid fa-star transition-colors' : 'fa-regular fa-star transition-colors';
          s.style.color = i < value ? starColor : mutedColor;
        });
        const labels = ['', 'Péssimo', 'Ruim', 'Regular', 'Bom', 'Excelente'];
        document.getElementById('rating-label').textContent = labels[value];
      });
    });

    async function postarAvaliacao(event) {
      event.preventDefault();
      const token = getToken();
      if (!token) { fecharModalAvaliacao(); abrirModalLogin(); return; }
      const rpgName = document.getElementById('form-rpg').value;
      const rating = document.getElementById('form-rating').value;
      const comment = document.getElementById('form-comment').value;
      const imageFile = document.getElementById('form-image').files[0];
      if (rating === '0') { alert('Selecione uma nota com as estrelas.'); return; }
      const formData = new FormData();
      formData.append('rpgName', rpgName);
      formData.append('rating', rating);
      formData.append('comment', comment);
      if (imageFile) formData.append('image', imageFile);
      try {
        const res = await fetch('/api/reviews', { method: 'POST', headers: { 'Authorization': `Bearer ${token}` }, body: formData });
        if (!res.ok) {
          const err = await res.json();
          if (res.status === 401) { clearSession(); atualizarNavbar(); fecharModalAvaliacao(); abrirModalLogin(); return; }
          alert(err.error || 'Erro ao publicar avaliação.'); return;
        }
        const review = await res.json();
        allReviewData.unshift(review);
        if (review.status === 'pending') {
          pendingReviewsData.push(review);
          atualizarNavbar();
          fecharModalAvaliacao();
          alert('Sua avaliação foi enviada para aprovação. Ela aparecerá no feed após ser aprovada por um administrador.');
          return;
        }
        catReviewData.push(review);
        const starColor = getComputedStyle(document.documentElement).getPropertyValue('--star').trim() || '#f59e0b';
        let estrelasHTML = '';
        for (let i = 1; i <= 5; i++) {
          if (i <= Math.floor(review.rating)) estrelasHTML += `<i class="fas fa-star" style="color:${starColor}"></i> `;
          else if (i === Math.ceil(review.rating) && review.rating % 1 !== 0) estrelasHTML += `<i class="fas fa-star-half-alt" style="color:${starColor}"></i> `;
          else estrelasHTML += `<i class="far fa-star" style="color:${starColor}; opacity:0.4"></i> `;
        }
        const imgSrc = review.customImage || review.rpg.image;
        const bgCard = getComputedStyle(document.documentElement).getPropertyValue('--bg-card').trim();
        const bgElevated = getComputedStyle(document.documentElement).getPropertyValue('--bg-elevated').trim();
        const border = getComputedStyle(document.documentElement).getPropertyValue('--border').trim();
        const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
        const textPrimary = getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim();
        const textSecondary = getComputedStyle(document.documentElement).getPropertyValue('--text-secondary').trim();
        const textMuted = getComputedStyle(document.documentElement).getPropertyValue('--text-muted').trim();
        const novoCard = document.createElement('div');
        novoCard.className = 'feed-card rounded-2xl p-4.5 border transition-all duration-300 shadow-sm flex flex-col space-y-3.5';
        novoCard.style.cssText = `background:color-mix(in srgb, ${bgCard} 40%, transparent);border-color:${border};`;
        novoCard.setAttribute('data-rpg', review.rpg.name);
        novoCard.innerHTML = `
          <div class="flex items-center space-x-3 p-2.5 rounded-xl border" style="background:color-mix(in srgb, ${bgElevated} 40%, transparent);border-color:${border};">
            <img src="${imgSrc}" class="w-12 h-14 object-cover rounded-lg shadow-md" alt="Capa ${review.rpg.name}">
            <div class="flex-1 min-w-0">
              <span class="text-[9px] font-bold px-1.5 py-0.5 rounded tracking-wide uppercase font-title" style="background:color-mix(in srgb, ${accent} 15%, transparent);color:${accent};">${review.rpg.genre}</span>
              <h3 class="font-title font-bold text-sm truncate mt-0.5 cursor-pointer hover:underline rpg-name" style="color:${textPrimary};" onclick="abrirDetalheRpg('${review.rpg.name}')">${review.rpg.name}</h3>
              <p class="text-[10px] truncate" style="color:${textMuted};">Por: <span class="rpg-owner">${review.rpg.owner}</span></p>
            </div>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2.5">
              <div onclick="verPerfil('${review.username}')" class="w-9 h-9 rounded-full flex items-center justify-center font-bold text-sm cursor-pointer" style="background:color-mix(in srgb, ${accent} 15%, transparent);border:1px solid color-mix(in srgb, ${accent} 30%, transparent);color:${accent};">${review.username.charAt(0).toUpperCase()}</div>
              <div>
                <h4 onclick="verPerfil('${review.username}')" class="font-bold text-xs cursor-pointer hover:underline" style="color:${textSecondary};">${review.username}</h4>
                <span class="text-[9px]" style="color:${textMuted};">${review.timeAgo}</span>
              </div>
            </div>
            <div class="flex items-center space-x-0.5 text-[10px] px-2 py-1 rounded-full border" style="color:${starColor};background:color-mix(in srgb, ${starColor} 10%, transparent);border-color:color-mix(in srgb, ${starColor} 20%, transparent);">
              ${estrelasHTML}
              <span class="text-[10px] ml-1 font-semibold" style="color:${starColor};">${review.rating}</span>
            </div>
          </div>
          <p class="text-xs leading-relaxed comment-text pl-1" style="color:${textSecondary};">${review.comment}</p>
          <div class="flex justify-end">
            <button onclick="deletarAvaliacao('${review.id}', this)" class="review-delete-btn text-[9px] px-2 py-1 rounded-lg font-bold transition-all hidden active:scale-[0.94]" style="color:#ef4444;background:color-mix(in srgb, #ef4444 10%, transparent);border:1px solid color-mix(in srgb, #ef4444 20%, transparent);" data-owner="${review.username}">
              <i class="fa-solid fa-trash-alt mr-1"></i>Excluir
            </button>
          </div>
        `;
        const feed = document.getElementById('feed-container');
        feed.insertBefore(novoCard, feed.firstChild);
        document.getElementById('form-avaliacao').reset();
        document.getElementById('file-name').textContent = 'Nenhum arquivo selecionado';
        document.querySelectorAll('#star-rating i').forEach(s => { s.className = 'fa-regular fa-star cursor-pointer transition-colors'; s.style.color = 'var(--text-muted)'; });
        document.getElementById('rating-label').textContent = 'Selecione';
        fecharModalAvaliacao();
      } catch (err) { alert('Erro ao conectar com o servidor.'); }
    }

    carregarTema();
    abrirCatalogo();
    setInterval(async () => {
      try {
        const res = await fetch('/api/reviews');
        if (res.ok) {
          const data = await res.json();
          const currentIds = new Set(catReviewData.map(r => r.id));
          const novas = data.filter(r => !currentIds.has(r.id));
          if (novas.length) {
            novas.forEach(n => catReviewData.push(n));
            atualizarMediasCatalogo();
          }
        }
      } catch {}
    }, 15000);

    const themeVars = ['--bg-primary','--bg-secondary','--bg-card','--bg-elevated','--bg-input','--accent','--text-primary','--text-secondary','--text-muted','--border','--star'];
    themeVars.forEach(v => {
      const el = document.getElementById('cp-' + v.replace('--', ''));
      if (!el) return;
      const val = getComputedStyle(document.documentElement).getPropertyValue(v).trim();
      if (val && val.startsWith('#')) el.value = val;
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        if (!document.getElementById('modal-perfil').classList.contains('modal-hidden')) fecharPerfil();
        if (!document.getElementById('modal-pendentes').classList.contains('modal-hidden')) fecharModalPendentes();
        if (!document.getElementById('modal-painel-criador').classList.contains('modal-hidden')) fecharPainelCriador();
        if (!document.getElementById('modal-monitoramento').classList.contains('modal-hidden')) fecharMonitoramento();
        if (!document.getElementById('modal-denuncia').classList.contains('modal-hidden')) fecharModalDenuncia();
        if (!document.getElementById('modal-denuncias').classList.contains('modal-hidden')) fecharModalDenuncias();
        if (!document.getElementById('modal-submeter-rpg').classList.contains('modal-hidden')) fecharModalSubmeterRpg();
        if (!document.getElementById('modal-submissoes').classList.contains('modal-hidden')) fecharModalSubmissoes();
        if (!document.getElementById('modal-chat').classList.contains('modal-hidden')) fecharChat();
      }
    });

    verificarSessao();
    iniciarHero();
    iniciarChatDot();
    iniciarChatStream();
  </script>
</body>
</html>
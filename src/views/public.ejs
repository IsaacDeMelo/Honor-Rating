          </div>
          <div><label class="block text-[10px] font-bold mb-1" style="color: var(--text-secondary);">Site Oficial (link)</label><input type="url" id="reg-link" class="w-full rounded-xl p-2.5 text-xs focus:outline-none" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);" placeholder="https://..."></div>

    <!-- MODAL DENUNCIAR RPG -->
    <div id="modal-denuncia" class="modal-hidden fixed inset-0 z-50 flex items-center justify-center p-4" style="background: color-mix(in srgb, var(--bg-primary) 90%, transparent);">
      <div class="rounded-3xl w-full max-w-md shadow-2xl" style="background: var(--bg-card); border: 1px solid var(--border);">
        <div class="p-5 border-b flex justify-between items-center" style="border-color: var(--border); background: var(--bg-elevated);">
          <h3 class="text-sm font-bold font-title flex items-center gap-2" style="color: var(--text-primary);">
            <i class="fa-solid fa-flag" style="color:#f87171;"></i>
            Denunciar <span id="denuncia-rpg-nome" class="truncate max-w-44"></span>
          </h3>
          <button onclick="fecharModalDenuncia()" class="p-2 rounded-xl transition" style="color: var(--text-muted);">
            <i class="fas fa-times"></i>
          </button>
        </div>
        <div class="p-4 space-y-3">
          <p class="text-[10px] leading-relaxed" style="color:var(--text-muted);">Sua denúncia é anônima para outros usuários e vai direto para análise do admin. Escolha o motivo:</p>
          <div class="grid grid-cols-3 gap-2" id="denuncia-motivos">
            <button onclick="denunciaMotivo('golpe')" data-motivo="golpe" class="denuncia-motivo-btn rounded-xl p-3 text-center transition" style="background:var(--bg-input);border:1px solid var(--border);">
              <i class="fa-solid fa-triangle-exclamation block text-base mb-1" style="color:#ef4444;"></i>
              <span class="text-[11px] font-bold" style="color:var(--text-primary);">Golpe</span>
              <span class="block text-[8px]" style="color:var(--text-muted);">fraude / roubo</span>
            </button>
            <button onclick="denunciaMotivo('inativo')" data-motivo="inativo" class="denuncia-motivo-btn rounded-xl p-3 text-center transition" style="background:var(--bg-input);border:1px solid var(--border);">
              <i class="fa-solid fa-moon block text-base mb-1" style="color:#f59e0b;"></i>
              <span class="text-[11px] font-bold" style="color:var(--text-primary);">Inativo</span>
              <span class="block text-[8px]" style="color:var(--text-muted);">abandonado</span>
            </button>
            <button onclick="denunciaMotivo('falso')" data-motivo="falso" class="denuncia-motivo-btn rounded-xl p-3 text-center transition" style="background:var(--bg-input);border:1px solid var(--border);">
              <i class="fa-solid fa-mask block text-base mb-1" style="color:var(--accent);"></i>
              <span class="text-[11px] font-bold" style="color:var(--text-primary);">Falso</span>
              <span class="block text-[8px]" style="color:var(--text-muted);">info falsa</span>
            </button>
          </div>
          <div>
            <label class="block text-[10px] font-bold mb-1" style="color: var(--text-secondary);" id="denuncia-desc-label">Descreva *</label>
            <textarea id="denuncia-desc" rows="3" class="w-full rounded-xl px-3 py-2 text-xs focus:outline-none resize-none" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);" placeholder="Conte o que aconteceu..."></textarea>
          </div>
          <div id="denuncia-prova-box" class="hidden space-y-2">

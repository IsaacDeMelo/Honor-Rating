    // ── CHAT GLOBAL ──
    let chatAberto = false;
    let chatTimer = null;
    let chatDotTimer = null;
    let chatUltimoId = null;

    function chatSeenKey() {
      const user = getUser();
      return 'honor-chat-seen-' + (user ? user.username : 'anon');
    }

    function getChatLastSeen() {
      return localStorage.getItem(chatSeenKey()) || null;
    }

    function setChatLastSeen(iso) {
      localStorage.setItem(chatSeenKey(), iso || new Date().toISOString());
    }

    function corDoUsuario(nome) {
      let h = 0;
      for (let i = 0; i < nome.length; i++) h = (h * 31 + nome.charCodeAt(i)) % 360;
      return `hsl(${h}, 70%, 60%)`;
    }

    function escaparHtml(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // Formatação estilo WhatsApp: *negrito* _itálico_ ~riscado~ `código` + links
    function formatChatText(s) {
      let h = escaparHtml(s);
      h = h.replace(/```([\s\S]+?)```/g, '<code style="background:rgba(0,0,0,.35);padding:1px 5px;border-radius:6px;font-size:11px;">$1</code>');
      h = h.replace(/\*([^*\n]+)\*/g, '<b>$1</b>');
      h = h.replace(/(^|\W)_([^_\n]+)_/g, '$1<i>$2</i>');
      h = h.replace(/~([^~\n]+)~/g, '<s>$1</s>');
      h = h.replace(/`([^`\n]+)`/g, '<code style="background:rgba(0,0,0,.35);padding:1px 5px;border-radius:6px;font-size:11px;">$1</code>');
      h = h.replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" rel="noopener" class="underline" style="color:#7dd3fc;">$1</a>');
      return h.replace(/\n/g, '<br>');
    }

    function abrirChat() {
      document.getElementById('modal-chat').classList.remove('modal-hidden');
      chatAberto = true;
      carregarChat();
      clearInterval(chatTimer);
      // Push (SSE) atualiza na hora; o intervalo abaixo é só fallback
      chatTimer = setInterval(() => {
        if (!chatAberto || document.hidden) return;
        if (chatSource && chatSource.readyState === 1) return;
        carregarChat(true);
      }, 15000);
      // Viu: limpa o pontinho na hora
      const latest = chatUltimoId;
      if (latest) setChatLastSeen(latest);
      atualizarChatDot(false, 0);
    }

    function fecharChat() {
      document.getElementById('modal-chat').classList.add('modal-hidden');
      chatAberto = false;
      clearInterval(chatTimer);
    }

    async function carregarChat(silencioso) {
      const box = document.getElementById('chat-mensagens');
      try {
        const res = await fetch('/api/chat?limit=50');
        if (!res.ok) throw 0;
        const msgs = await res.json();
        const eu = getUser()?.username;
        if (!msgs.length) {
          box.innerHTML = '<p class="text-[11px] text-center py-8" style="color:var(--text-muted);">Nenhuma mensagem ainda. Puxe assunto!</p>';
          return;
        }
        const pertoDoFim = (box.scrollHeight - box.scrollTop - box.clientHeight) < 120;
        box.innerHTML = msgs.map(m => {
          const minha = eu && m.username === eu;
          const u = catUsersData.find(x => x.username === m.username);
          const avatar = u?.avatar;
          const initial = m.username.charAt(0).toUpperCase();
          const hora = new Date(m.createdAt).toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
          return `
          <div class="flex ${minha ? 'justify-end' : 'justify-start'}">
            <div class="max-w-[80%] rounded-2xl px-3 py-2 shadow-sm ${minha ? 'rounded-br-md' : 'rounded-bl-md'}" style="background:${minha ? 'var(--accent)' : 'var(--bg-elevated)'};border:1px solid var(--border);">
              ${minha ? '' : `<div class="flex items-center gap-1.5 mb-1">
                <div class="w-5 h-5 rounded-full flex items-center justify-center text-[9px] font-bold overflow-hidden shrink-0" style="background:${corDoUsuario(m.username)};color:#fff;">${avatar ? `<img src="${avatar}" class="w-full h-full object-cover">` : initial}</div>
                <span class="text-[10px] font-bold" style="color:${corDoUsuario(m.username)};">${m.username.replace(/</g, '&lt;')}</span>
              </div>`}
              ${m.image ? `<a href="${m.image}" target="_blank" rel="noopener"><img src="${m.image}" class="rounded-xl mb-1 w-full max-h-52 object-cover" loading="lazy" alt=""></a>` : ''}
              ${m.text ? `<p class="text-[12px] leading-relaxed break-words" style="color:${minha ? '#fff' : 'var(--text-primary)'};">${formatChatText(m.text)}</p>` : ''}
              <div class="flex items-center justify-end gap-1.5 mt-0.5">
                <span class="text-[8px]" style="color:${minha ? 'rgba(255,255,255,.7)' : 'var(--text-muted)'};">${hora}</span>
                ${minha || getUser()?.role === 'admin' ? `<button onclick="deletarChatMsg('${m.id}')" class="text-[8px] opacity-60 hover:opacity-100" style="color:${minha ? '#fff' : 'var(--text-muted)'};" title="Apagar"><i class="fa-solid fa-trash"></i></button>` : ''}
              </div>
            </div>
          </div>`;
        }).join('');
        chatUltimoId = msgs[msgs.length - 1].createdAt;
        document.getElementById('chat-subtitulo').textContent = msgs.length + ' mensagens · da comunidade Honor Rating';
        if (!silencioso || pertoDoFim) box.scrollTop = box.scrollHeight;
        if (chatAberto) { setChatLastSeen(chatUltimoId); atualizarChatDot(false, 0); }
      } catch {
        if (!silencioso) box.innerHTML = '<p class="text-[11px] text-center py-8" style="color:var(--text-muted);">Erro ao carregar. Tente de novo.</p>';
      }
    }

    function chatImagePreview(input) {
      const box = document.getElementById('chat-preview');
      const f = input.files?.[0];
      if (!f) { box.classList.add('hidden'); box.innerHTML = ''; return; }
      box.innerHTML = `<div class="relative inline-block mb-2">
        <img src="${URL.createObjectURL(f)}" class="h-20 rounded-xl border" style="border-color:var(--border);">
        <button onclick="document.getElementById('chat-image').value='';chatImagePreview(document.getElementById('chat-image'))" class="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full text-[10px] font-bold" style="background:#ef4444;color:#fff;">×</button>
      </div>`;
      box.classList.remove('hidden');
    }

    async function enviarChatMsg() {
      const user = getUser();
      if (!user) { fecharChat(); abrirModalLogin(); return; }
      const input = document.getElementById('chat-text');
      const fileInput = document.getElementById('chat-image');
      const text = input.value.trim();
      const file = fileInput.files?.[0];
      if (!text && !file) return;
      const btn = document.getElementById('chat-send-btn');
      btn.style.opacity = '.5';
      try {
        const form = new FormData();
        if (text) form.append('text', text);
        if (file) form.append('image', file);
        const res = await fetch('/api/chat', { method: 'POST', headers: { 'Authorization': 'Bearer ' + getToken() }, body: form });
        if (!res.ok) return;
        input.value = '';
        fileInput.value = '';
        document.getElementById('chat-preview').classList.add('hidden');
        document.getElementById('chat-preview').innerHTML = '';
        await carregarChat();
      } catch {}
      finally { btn.style.opacity = '1'; }
    }

    async function deletarChatMsg(id) {
      if (!confirm('Apagar esta mensagem?')) return;
      try {
        const res = await fetch('/api/chat/' + id, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + getToken() } });
        if (res.ok) carregarChat(true);
      } catch {}
    }

    function atualizarChatDot(temNovas, qtd) {
      document.getElementById('nav-chat-dot')?.classList.toggle('hidden', !temNovas);
      const btn = document.getElementById('nav-chat');
      if (btn) btn.title = temNovas ? (qtd > 1 ? qtd + ' mensagens novas no chat' : '1 mensagem nova no chat') : 'Chat global';
    }

    async function chatDotPoll() {
      if (chatAberto || document.hidden) return;
      try {
        const seen = getChatLastSeen();
        // Primeira vez: marca a base sem acender (não brilha à toa)
        if (!seen) {
          const r0 = await fetch('/api/chat/ping');
          if (!r0.ok) return;
          const d0 = await r0.json();
          if (d0.latest) setChatLastSeen(d0.latest);
          return;
        }
        const res = await fetch('/api/chat/ping?since=' + encodeURIComponent(seen));
        if (!res.ok) return;
        const data = await res.json();
        if (data.hasNew) {
          // Conta quantas são novas para o título do botão
          const r2 = await fetch('/api/chat?limit=100');
          if (!r2.ok) return;
          const msgs = await r2.json();
          const novas = msgs.filter(m => m.createdAt > seen);
          atualizarChatDot(novas.length > 0, novas.length);
        } else {
          atualizarChatDot(false, 0);
        }
      } catch {}
    }

    function iniciarChatDot() {
      clearInterval(chatDotTimer);
      chatDotTimer = setInterval(chatDotPoll, 20000);
      setTimeout(chatDotPoll, 3000);
      // Ao voltar para a aba, atualiza na hora (chat aberto ou pontinho)
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) return;
        if (chatAberto) carregarChat(true);
        else chatDotPoll();
      });
    }

    // Push em tempo real: o servidor avisa quando chega mensagem nova
    let chatSource = null;
    function iniciarChatStream() {
      try {
        if (typeof EventSource === 'undefined') return;
        chatSource = new EventSource('/api/chat/stream');
        chatSource.onmessage = (ev) => {
          try {
            const data = JSON.parse(ev.data);
            if (data.type === 'message') {
              if (chatAberto) carregarChat(true);
              else {
                const seen = getChatLastSeen();
                if (!seen || data.message.createdAt > seen) atualizarChatDot(true, 1);
              }
            } else if (data.type === 'deleted') {
              if (chatAberto) carregarChat(true);
            }
          } catch {}
        };
        chatSource.onerror = () => { /* reconecta sozinho; fallback cobre */ };
      } catch {}
    }


          <button onclick="fecharPerfil()" class="absolute top-3 right-3 w-7 h-7 rounded-full flex items-center justify-center text-white text-xs transition active:scale-90" style="background: rgba(0,0,0,0.3);"><i class="fas fa-times"></i></button>
          <div class="relative -mb-10 w-20 h-20 rounded-full overflow-hidden border-[3px] shadow-lg" style="border-color: var(--bg-card);">
            <img id="perfil-avatar" class="w-full h-full object-cover hidden" src="" alt="">
            <div id="perfil-avatar-placeholder" class="w-full h-full flex items-center justify-center text-2xl font-bold text-white" style="background: var(--accent);">U</div>
          </div>
        </div>

        <div class="pt-12 pb-5 px-5 space-y-4">

          <div class="text-center">
            <p class="text-base font-bold" style="color: var(--text-primary);" id="perfil-nome">Carregando...</p>
            <div class="inline-block mt-1.5 px-2.5 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider" id="perfil-role" style="background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent);">Usuário</div>
            <div id="perfil-score-chip" class="hidden inline-flex items-center gap-1 mt-1.5 ml-1.5 px-2.5 py-0.5 rounded-full text-[9px] font-bold" style="background:#f59e0b20;color:#f59e0b;border:1px solid #f59e0b40;" title="Score calculado pela nota e volume de avaliações dos seus sistemas">
              <i class="fa-solid fa-gauge-high text-[8px]"></i> Score <span id="perfil-score-value">0</span>
            </div>
          </div>

          <div class="flex items-start gap-3 p-3 rounded-2xl" style="background: var(--bg-elevated);">
            <label id="perfil-camera-label" class="cursor-pointer shrink-0 w-9 h-9 rounded-full flex items-center justify-center text-xs transition active:scale-90" style="background: var(--bg-input); color: var(--text-muted); border: 1px solid var(--border);" title="Alterar foto">
              <i class="fa-solid fa-camera"></i>
              <input type="file" id="perfil-avatar-input" accept=".jpg,.jpeg,.png,.webp" class="hidden" onchange="enviarAvatar(event)">

                <img id="reg-banner-preview" class="w-full h-full object-cover" alt="Prévia 16:9">
              </div>
              <p class="text-[9px] mt-1" style="color:var(--text-muted);">Prévia 16:9 — como aparece no topo. <span id="reg-banner-meta"></span></p>

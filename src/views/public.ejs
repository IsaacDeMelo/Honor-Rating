<!DOCTYPE html>
<html lang="pt-BR">
<%
const seoRpg = typeof initialRpg !== 'undefined' ? rpgs.find(r => r.name === initialRpg) : null;
const seoRevs = seoRpg ? reviews.filter(r => r.rpg.name === seoRpg.name) : [];
const seoAvg = seoRevs.length ? (seoRevs.reduce((s, r) => s + r.rating, 0) / seoRevs.length) : 0;
const seoCount = seoRevs.length;
%>
<head>
  <meta name="google-site-verification" content="cvE8c8q17Rp3ylk6DTnfQqPcF8q1faf4k55S1KbhXJ8" />
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <link rel=icon href="images/logo.png" type="image/png">
  <% if (typeof metaTitle !== 'undefined') { %>
    <title><%= metaTitle %></title>
    <meta name="description" content="<%= metaDescription %>">
    <link rel="canonical" href="https://honor-rating.onrender.com<%= canonicalUrl %>">
    <meta property="og:title" content="<%= metaTitle %>">
    <meta property="og:description" content="<%= metaDescription %>">
    <meta property="og:image" content="<%= ogImage %>">
    <meta property="og:url" content="https://honor-rating.onrender.com<%= ogUrl %>">
    <meta property="og:type" content="website">
  <% } else { %>
    <title>Honor - Rating | Catálogo de RPG</title>
    <meta name="description" content="Descubra e avalie sistemas de RPG. Veja críticas, notas e recomendações da comunidade para encontrar seu próximo jogo.">
    <link rel="canonical" href="https://honor-rating.onrender.com/" />
  <% } %>

  <% if (seoRpg) { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "<%= seoRpg.name %>",
    "description": "<%= seoRpg.description.replace(/"/g, '&quot;').substring(0, 200) %>",
    "image": "<%= seoRpg.image %>",
    "brand": { "@type": "Brand", "name": "<%= seoRpg.owner %>" },
    "genre": "<%= seoRpg.genre %>",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "<%= seoCount > 0 ? seoAvg.toFixed(1) : '0' %>",
      "bestRating": "5",
      "worstRating": "0",
      "ratingCount": "<%= seoCount %>"
    },
    "url": "https://honor-rating.onrender.com<%= canonicalUrl %>"
  }
  </script>
  <% } %>
  <!-- Fontes Premium do Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Cropper.js -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">
  
  <script>
    // Configurações personalizadas do Tailwind para dar um visual único e autoral
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            title: ['"Space Grotesk"', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    :root {
      --bg-primary: #050911;
      --bg-secondary: #0f1524;
      --bg-card: #111827;
      --bg-elevated: #1a1f35;
      --bg-input: #0a0e1a;
      --accent: #e50914;
      --accent-hover: #f40612;
      --accent-dim: rgba(229, 9, 20, 0.15);
      --accent-glow: rgba(229, 9, 20, 0.3);
      --text-primary: #f1f5f9;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --border: rgba(100, 116, 139, 0.25);
      --border-accent: rgba(229, 9, 20, 0.3);
      --star: #f59e0b;
    }

    html { scroll-behavior: smooth; }

    /* ─── Transição global suave ─── */
    *, *::before, *::after {
      transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, opacity 0.3s ease;
    }

    /* ─── Animação de fade-in da página ─── */
    @keyframes pageFadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    body > div:first-of-type {
      animation: pageFadeIn 0.5s ease;
    }

    /* ─── Feed cards com entrada animada ─── */
    @keyframes feedCardIn {
      from { opacity: 0; transform: translateY(24px); }
      to { opacity: 1; transform: translateY(0); }
    }
    #feed-container > .feed-card {
      animation: feedCardIn 0.45s ease both;
    }
    #feed-container > .feed-card:nth-child(1) { animation-delay: 0.04s; }
    #feed-container > .feed-card:nth-child(2) { animation-delay: 0.08s; }
    #feed-container > .feed-card:nth-child(3) { animation-delay: 0.12s; }

    button, a, input, select, textarea { transition: all 0.2s ease; }
    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--accent) !important;
      box-shadow: 0 0 0 2px var(--accent-dim);
    }
    #stories-section button img { transition: transform 0.3s ease; }
    #stories-section button:hover img { transform: scale(1.1); }

    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    .glassmorphism {
      background: color-mix(in srgb, var(--bg-elevated) 60%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    .feed-card { padding: 20px; transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease; }
    .feed-card:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(0,0,0,0.3); border-color: var(--accent-dim) !important; }

    /* ─── Header Netflix ─── */
    @keyframes headerGlow {
      0%, 100% { box-shadow: 0 1px 0 var(--accent-dim); }
      50% { box-shadow: 0 1px 0 var(--accent), 0 0 20px var(--accent-glow); }
    }
    @keyframes headerReveal {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes logoFadeDrop {
      0% { opacity: 0; transform: scale(0.8) translateY(-8px); filter: blur(4px); }
      60% { transform: scale(1.05) translateY(1px); }
      100% { opacity: 1; transform: scale(1) translateY(0); filter: blur(0); }
    }
    @keyframes badgePulse {
      0%, 100% { box-shadow: 0 0 0 0 var(--accent-dim); }
      50% { box-shadow: 0 0 12px 2px var(--accent-dim); }
    }
    @keyframes headerUnderline {
      from { transform: scaleX(0); }
      to { transform: scaleX(1); }
    }
    .header-inner {
      animation: headerReveal 0.5s ease both;
    }
    .header-logo-img {
      animation: logoFadeDrop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s both;
    }
    .header-badge {
      animation: badgePulse 2.5s ease-in-out infinite;
    }
    .header-glow {
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--accent), transparent);
      transform-origin: center;
      animation: headerUnderline 0.8s ease 0.3s both;
    }

    #modal-catalogo {
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
    }
    #modal-catalogo.catalogo-aberto {
      opacity: 1;
      pointer-events: auto;
    }

    @keyframes catSlideUp {
      from { opacity: 0; transform: translateY(40px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes catBannerZoom {
      from { transform: scale(1.15); }
      to   { transform: scale(1); }
    }

    .cat-banner-zoom {
      animation: catBannerZoom 6s ease-out forwards;
    }
    #modal-catalogo.catalogo-aberto .cat-hero {
      animation: catSlideUp 0.6s ease 0.1s both;
    }
    #modal-catalogo.catalogo-aberto .cat-section .cat-card {
      animation: catSlideUp 0.45s ease both;
    }
    #modal-catalogo.catalogo-aberto .cat-section:nth-child(1) .cat-card:nth-child(1) { animation-delay: 0.15s; }
    #modal-catalogo.catalogo-aberto .cat-section:nth-child(1) .cat-card:nth-child(2) { animation-delay: 0.19s; }
    #modal-catalogo.catalogo-aberto .cat-section:nth-child(1) .cat-card:nth-child(3) { animation-delay: 0.23s; }
    #modal-catalogo.catalogo-aberto .cat-section:nth-child(2) .cat-card:nth-child(1) { animation-delay: 0.22s; }
    #modal-catalogo.catalogo-aberto .cat-section:nth-child(2) .cat-card:nth-child(2) { animation-delay: 0.26s; }
    #modal-catalogo.catalogo-aberto .cat-section:nth-child(3) .cat-card:nth-child(1) { animation-delay: 0.29s; }
    #modal-catalogo.catalogo-aberto .cat-section:nth-child(3) .cat-card:nth-child(2) { animation-delay: 0.33s; }
    #modal-catalogo.catalogo-aberto .cat-section:nth-child(4) .cat-card:nth-child(1) { animation-delay: 0.36s; }

    #cat-top10 {
      transition: opacity 0.35s ease, max-height 0.5s ease, margin 0.4s ease, padding 0.4s ease;
      overflow: hidden;
    }
    #cat-top10.cat-top10-hidden {
      opacity: 0;
      max-height: 0;
      margin: 0;
      padding: 0;
      border: none;
      pointer-events: none;
    }

    .cat-card {
      transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.4s ease;
      cursor: pointer;
      position: relative;
      overflow: hidden;
    }
    .cat-card:hover {
      transform: scale(1.07);
      box-shadow: 0 16px 48px rgba(0,0,0,0.6), 0 0 30px var(--accent-glow);
      z-index: 2;
    }
    .cat-card .cat-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 55%);
      opacity: 1;
      transition: opacity 0.35s ease;
      pointer-events: none;
    }
    .cat-card .cat-label {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 12px;
      transform: translateY(0);
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      z-index: 1;
    }

    .cat-card .cat-blur {
      filter: blur(24px);
      transition: filter 0.4s ease;
    }
    .cat-card .cat-blur.revealed {
      filter: blur(0);
    }
    .cat-age-badge {
      position: absolute;
      top: 8px;
      right: 8px;
      z-index: 3;
      font-size: 9px;
      font-weight: 800;
      padding: 2px 6px;
      border-radius: 4px;
      letter-spacing: 0.02em;
      backdrop-filter: blur(4px);
    }
    .cat-age-badge.L { background: rgba(34,197,94,0.85); color: #fff; }
    .cat-age-badge.\31 2 { background: rgba(234,179,8,0.85); color: #000; }
    .cat-age-badge.\31 4 { background: rgba(251,146,60,0.85); color: #000; }
    .cat-age-badge.\31 6 { background: rgba(239,68,68,0.85); color: #fff; }
    .cat-age-badge.\31 8 { background: rgba(0,0,0,0.85); color: #fff; border: 1px solid var(--accent); }
    .cat-age-badge.\31 8::after { content: ' 🔞'; font-size: 7px; }

    .cat-section-title {
      animation: catSlideUp 0.5s ease both;
    }
    #modal-catalogo.catalogo-aberto .cat-section-title:nth-of-type(1) { animation-delay: 0.12s; }
    #modal-catalogo.catalogo-aberto .cat-section-title:nth-of-type(2) { animation-delay: 0.18s; }
    #modal-catalogo.catalogo-aberto .cat-section-title:nth-of-type(3) { animation-delay: 0.24s; }
    #modal-catalogo.catalogo-aberto .cat-section-title:nth-of-type(4) { animation-delay: 0.3s; }

    #modal-catalogo, #modal-detalhe, #modal-registrar-rpg, #modal-avaliacao, #modal-login, #modal-registro, #modal-perfil, #modal-config {
      opacity: 0;
      transition: opacity 0.35s ease, backdrop-filter 0.35s ease;
      pointer-events: none;
      visibility: hidden;
    }
    #modal-catalogo.catalogo-aberto,
    #modal-detalhe.detalhe-aberto, #modal-registrar-rpg.registro-aberto,
    #modal-avaliacao:not(.modal-hidden), #modal-login:not(.modal-hidden), #modal-registro:not(.modal-hidden),
    #modal-perfil:not(.modal-hidden), #modal-config:not(.modal-hidden) {
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
    }
    .modal-hidden {
      opacity: 0 !important;
      pointer-events: none !important;
      visibility: hidden !important;
    }

    @keyframes detalheSlideUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    #modal-detalhe.detalhe-aberto .detalhe-card {
      animation: detalheSlideUp 0.4s ease 0.05s both;
    }
    #modal-detalhe.detalhe-aberto .detalhe-reviews {
      animation: detalheSlideUp 0.4s ease 0.15s both;
    }

    .detalhe-review-card {
      transition: background 0.2s ease;
    }
    .detalhe-review-card:hover {
      background: color-mix(in srgb, var(--bg-elevated) 50%, transparent);
    }

    .color-picker::-webkit-color-swatch-wrapper { padding: 0; }
    .color-picker::-webkit-color-swatch { border: none; border-radius: 8px; }
    .color-picker::-moz-color-swatch { border: none; border-radius: 8px; }

    @media (max-width: 1023px) {
    #theme-panel { display: none !important; }
  }
  @media (min-width: 1024px) {
    .header-inner { padding-left: 1.75rem; padding-right: 1.75rem; }
    #catalog-controls .flex.w-full { max-width: 100%; }
    .detalhe-card .p-5 { padding: 1.75rem; }
    .feed-card { padding: 1.25rem; }
    #feed-container .feed-card:last-child { margin-bottom: 2rem; }
  }
</style>
</head>
<body style="background-color: var(--bg-primary); color: var(--text-primary); font-family: 'Plus Jakarta Sans', sans-serif;" class="min-h-screen flex justify-center selection:bg-[var(--accent-dim)] selection:text-[var(--accent)]">

  <!-- CONTAINER PRINCIPAL -->
  <div style="background-color: var(--bg-secondary); border-color: var(--border);" class="w-full max-w-md lg:max-w-5xl min-h-screen flex flex-col relative pb-24 shadow-[0_0_50px_rgba(0,0,0,0.8)] border-x">
    
    <!-- HEADER NETFLIX -->
    <header style="border-color: var(--border);" class="sticky top-0 z-40 glassmorphism overflow-hidden">
      <div class="header-inner px-5 py-1 flex justify-between items-center">
        <div class="flex items-center gap-3">

          
        </div>
      </div>
      <div class="header-glow"></div>
    </header>

    <!-- VISÃO DO FEED (ALTERNA COM CATÁLOGO) -->
    <div id="feed-view" class="hidden">
    
    <!-- SEÇÃO STORIES (USUÁRIOS EM DESTAQUE) -->
    <section id="feed-destaques-section" class="py-5 border-b" style="border-color: var(--border); background-color: color-mix(in srgb, var(--bg-primary) 60%, transparent);">
      <h2 style="color: var(--text-muted);" class="text-[10px] uppercase tracking-widest font-bold px-5 mb-3 font-title">Destaques da comunidade</h2>
      
      <div class="flex space-x-4 overflow-x-auto px-5 no-scrollbar">
        <%
        const _top10 = (rpgRatings || []).slice(0, 10).map(x => x.rpg.name);
        const _cont = {};
        (allReviews || []).forEach(r => { _cont[r.username] = (_cont[r.username] || 0) + 1; });
        const _spot = (users || []).map(u => {
          const n = _cont[u.username] || 0;
          const tops = (u.creatorOf || []).filter(nm => _top10.includes(nm));
          return { u, n, tops, score: n + tops.length * 5 };
        }).filter(x => x.n > 0 || x.tops.length > 0)
        .sort((a, b) => b.score - a.score || a.u.username.localeCompare(b.u.username)).slice(0, 10);
        %>
        <% _spot.forEach(s => { %>
        <button onclick="verPerfil('<%= s.u.username %>')" class="flex flex-col items-center space-y-1 flex-shrink-0 focus:outline-none group">
          <div class="w-16 h-16 rounded-full p-0.5 overflow-hidden transition-all duration-300 group-hover:scale-105" style="box-shadow: 0 0 0 2px var(--accent-glow); background: var(--bg-card);">
            <% if (s.u.avatar) { %>
            <img src="<%= s.u.avatar %>" class="w-full h-full object-cover rounded-full" alt="<%= s.u.username %>">
            <% } else { %>
            <span class="w-full h-full rounded-full flex items-center justify-center text-xl font-bold" style="background: var(--accent-dim); color: var(--accent);"><%= s.u.username.charAt(0).toUpperCase() %></span>
            <% } %>
          </div>
          <span style="color: var(--text-secondary);" class="text-[11px] font-medium truncate w-16 text-center group-hover:text-white transition"><%= s.u.username %></span>
          <div class="flex items-center gap-[1px]">
            <% if (s.tops.length) { %>
            <i class="fa-solid fa-trophy" style="color:var(--star);font-size:6px;"></i>
            <span class="text-[8px] ml-0.5 font-semibold" style="color: var(--text-muted);">Top 10</span>
            <% } else { %>
            <i class="fas fa-star" style="color:var(--star);font-size:6px;"></i>
            <span class="text-[8px] ml-0.5 font-semibold" style="color: var(--text-muted);"><%= s.n %></span>
            <% } %>
          </div>
        </button>
        <% }) %>
      </div>
    </section>

    <!-- BARRA DE BUSCA -->
    <div id="search-section" class="p-4 border-b transition-all" style="background: color-mix(in srgb, var(--bg-elevated) 50%, transparent); border-color: var(--border);">
      <div class="relative">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3">
          <i class="fa-solid fa-magnifying-glass" style="color: var(--text-muted); font-size: 12px;"></i>
        </span>
        <input type="text" id="search-input" onkeyup="buscarNoFeed()" placeholder="Pesquise por RPG, usuário ou palavras-chave..." class="w-full rounded-lg pl-9 pr-4 py-2 text-xs focus:outline-none transition-colors placeholder:opacity-50" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);"> 
      </div>
      <button id="btn-postar-evento" onclick="abrirModalPostarEvento()" class="hidden mt-3 w-full py-2.5 rounded-xl text-[11px] font-bold transition-all active:scale-[0.97] flex items-center justify-center gap-2" style="background: var(--accent); color: white;">
        <i class="fa-solid fa-bullhorn"></i>
        Postar Evento
      </button>
    </div>

    <!-- FEED DE AVALIAÇÕES -->
    <main id="feed-container" class="flex-1 p-4 lg:p-6 space-y-4 lg:space-y-0 lg:grid lg:grid-cols-2 lg:gap-4 xl:grid-cols-3 overflow-y-auto">
      
      <% eventPosts.forEach(post => { %>
      <div class="feed-card feed-event-card rounded-2xl p-4.5 border transition-all duration-300 shadow-sm flex flex-col space-y-3.5" data-rpg="<%= post.rpg ? post.rpg.name : '' %>" style="background: color-mix(in srgb, #22c55e 6%, var(--bg-card) 40%, transparent); border-color: color-mix(in srgb, #22c55e 30%, var(--border));">
        <div class="flex items-center justify-between gap-2">
          <span class="text-[9px] font-bold px-2 py-0.5 rounded-full tracking-wide uppercase shrink-0" style="background:#22c55e20;color:#22c55e;border:1px solid #22c55e40;"><i class="fa-solid fa-bullhorn text-[8px] mr-1"></i><%= post.rpg ? 'Evento do Criador' : 'Comunicado' %></span>
          <% if (post.pinned) { %>
          <span class="text-[9px] font-bold px-2 py-0.5 rounded-full shrink-0" style="background:#a855f720;color:#c084fc;border:1px solid #a855f740;" title="Fixado pelo admin."><i class="fa-solid fa-thumbtack text-[8px] mr-1"></i>Fixado</span>
          <% } else if (post.boosted) { %>
          <span class="text-[9px] font-bold px-2 py-0.5 rounded-full shrink-0" style="background:#f59e0b20;color:#f59e0b;border:1px solid #f59e0b40;" title="Quanto mais avaliações boas o sistema tem, mais tempo este post fica no topo."><i class="fa-solid fa-rocket text-[8px] mr-1"></i>Em alta · <%= Math.round(post.boostHours) %>h</span>
          <% } else { %>
          <span class="text-[9px] font-bold px-2 py-0.5 rounded-full shrink-0" style="background:var(--bg-input);color:var(--text-muted);border:1px solid var(--border);" title="O impulso deste post terminou e ele está caindo conforme o tempo."><i class="fa-solid fa-arrow-trend-down text-[8px] mr-1"></i>Caindo</span>
          <% } %>
          <span class="text-[9px]" style="color: var(--text-muted);"><%= post.timeAgo %></span>
        </div>
        <% if (post.rpg) { %>
        <div class="flex items-center space-x-3 p-2.5 rounded-xl border" style="background: color-mix(in srgb, var(--bg-elevated) 40%, transparent); border-color: var(--border);">
          <img src="<%= post.rpg.image %>" class="w-12 h-14 object-cover rounded-lg shadow-md" alt="Capa <%= post.rpg.name %>">
          <div class="flex-1 min-w-0">
            <span class="text-[9px] font-bold px-1.5 py-0.5 rounded tracking-wide uppercase font-title" style="background: #22c55e; color: white;"><%= post.rpg.genre %></span>
            <h3 class="font-title font-bold text-sm truncate mt-0.5 cursor-pointer hover:underline" style="color: var(--text-primary);" onclick="abrirDetalheRpg('<%= post.rpg.name %>')"><%= post.rpg.name %></h3>
            <p class="text-[10px] truncate" style="color: var(--text-muted);">Por: <span class="rpg-owner"><%= post.rpg.owner %></span></p>
          </div>
        </div>
        <% } %>
        <h4 class="text-sm font-bold" style="color: var(--text-primary);"><%= post.title %></h4>
        <% if (post.image) { %>
        <a href="<%= post.image %>" target="_blank" rel="noopener"><img src="<%= post.image %>" class="w-full object-contain rounded-xl border" style="border-color:var(--border);max-height:75vh;background:#000;" loading="lazy" alt=""></a>
        <% } %>
        <p class="text-xs leading-relaxed pl-1" style="color: var(--text-secondary);"><%= post.content %></p>
        <% if (post.tags && post.tags.length) { %>
        <div class="flex flex-wrap gap-1 pl-1">
          <% post.tags.forEach(t => { %>
          <span class="text-[9px] px-2 py-0.5 rounded-full font-medium" style="background:color-mix(in srgb, #22c55e 12%, transparent);color:#22c55e;border:1px solid color-mix(in srgb, #22c55e 25%, transparent);">#<%= t %></span>
          <% }) %>
        </div>
        <% } %>
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-semibold flex items-center gap-1" style="color: #22c55e;">
            <i class="fa-solid fa-award"></i> <%= post.username %>
          </span>
          <span class="inline-flex items-center gap-1.5">
            <button onclick="fixarPost('<%= post.id %>')" class="event-pin-btn text-[9px] px-2 py-1 rounded-lg font-bold transition-all hidden active:scale-[0.94]" style="color: #c084fc; background: color-mix(in srgb, #a855f7 10%, transparent); border: 1px solid color-mix(in srgb, #a855f7 25%, transparent);">
              <i class="fa-solid fa-thumbtack mr-1"></i><%= post.pinned ? 'Ajustar' : 'Fixar' %>
            </button>
            <button onclick="deletarEvento('<%= post.id %>', this)" class="event-delete-btn text-[9px] px-2 py-1 rounded-lg font-bold transition-all hidden active:scale-[0.94]" style="color: #ef4444; background: color-mix(in srgb, #ef4444 10%, transparent); border: 1px solid color-mix(in srgb, #ef4444 20%, transparent);" data-owner="<%= post.username %>">
              <i class="fa-solid fa-trash-alt mr-1"></i>Excluir
            </button>
          </span>
        </div>
      </div>
      <% }) %>

      <% reviews.forEach(review => { %>
      <div class="feed-card rounded-2xl p-4.5 border transition-all duration-300 shadow-sm flex flex-col space-y-3.5" data-rpg="<%= review.rpg.name %>" style="background: color-mix(in srgb, var(--bg-card) 40%, transparent); border-color: var(--border);">
        
        <div class="flex items-center space-x-3 p-2.5 rounded-xl border" style="background: color-mix(in srgb, var(--bg-elevated) 40%, transparent); border-color: var(--border);">
          <img src="<%= review.customImage || review.rpg.image %>" class="w-12 h-14 object-cover rounded-lg shadow-md" alt="Capa <%= review.rpg.name %>">
          <div class="flex-1 min-w-0">
            <span class="text-[9px] font-bold px-1.5 py-0.5 rounded tracking-wide uppercase font-title" style="background: var(--accent-dim); color: var(--accent);"><%= review.rpg.genre %></span>
            <h3 class="font-title font-bold text-sm truncate mt-0.5 cursor-pointer hover:underline" style="color: var(--text-primary);" onclick="abrirDetalheRpg('<%= review.rpg.name %>')"><%= review.rpg.name %></h3>
            <p class="text-[10px] truncate flex items-center gap-1" style="color: var(--text-muted);">Por: <span class="rpg-owner"><%= review.rpg.owner %></span></p>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2.5">
            <%
            const avatarUser = users.find(u => u.username === review.username);
            const hasAvatar = avatarUser && avatarUser.avatar;
            %>
            <div onclick="verPerfil('<%= review.username %>')" class="w-9 h-9 rounded-full flex items-center justify-center font-bold text-sm overflow-hidden shrink-0 cursor-pointer" style="background: var(--accent-dim); border: 1px solid var(--border-accent); color: var(--accent);">
              <% if (hasAvatar) { %>
                <img src="<%= avatarUser.avatar %>" class="w-full h-full object-cover" alt="">
              <% } else { %>
                <%= review.username.charAt(0).toUpperCase() %>
              <% } %>
            </div>
            <div>
              <h4 onclick="verPerfil('<%= review.username %>')" class="font-bold text-xs cursor-pointer hover:underline inline-flex items-center gap-1" style="color: var(--text-secondary);"><%= review.username %>
                <span class="creator-badge hidden items-center gap-0.5 text-[7px] font-bold px-1 py-0.5 rounded-full" data-creator="<%= review.username %>" style="background:#22c55e20;color:#22c55e;border:1px solid #22c55e40;"><i class="fa-solid fa-award"></i>Criador</span>
              </h4>
              <span class="text-[9px]" style="color: var(--text-muted);"><%= review.timeAgo %></span>
            </div>
          </div>
          <div class="flex items-center space-x-0.5 text-[10px] px-2 py-1 rounded-full border" style="color: var(--star); background: color-mix(in srgb, var(--star) 10%, transparent); border-color: color-mix(in srgb, var(--star) 20%, transparent);">
            <% for (let i = 1; i <= 5; i++) { %>
              <% if (i <= Math.floor(review.rating)) { %>
                <i class="fas fa-star"></i>
              <% } else if (i === Math.ceil(review.rating) && review.rating % 1 !== 0) { %>
                <i class="fas fa-star-half-alt"></i>
              <% } else { %>
                <i class="far fa-star text-slate-700"></i>
              <% } %>
            <% } %>
            <span class="text-[10px] ml-1 font-semibold" style="color: var(--star);"><%= review.rating %></span>
          </div>
        </div>

        <p class="text-xs leading-relaxed comment-text pl-1" style="color: var(--text-secondary);">
          <%= review.comment %>
        </p>
        <div class="flex justify-end">
          <button onclick="deletarAvaliacao('<%= review.id %>', this)" class="review-delete-btn text-[9px] px-2 py-1 rounded-lg font-bold transition-all hidden active:scale-[0.94]" style="color: #ef4444; background: color-mix(in srgb, #ef4444 10%, transparent); border: 1px solid color-mix(in srgb, #ef4444 20%, transparent);" data-owner="<%= review.username %>">
            <i class="fa-solid fa-trash-alt mr-1"></i>Excluir
          </button>
        </div>
      </div>
      <% }) %>

      <div id="feed-loader" class="col-span-full text-center py-8 hidden">
        <button onclick="carregarMaisReviews()" class="px-6 py-2.5 rounded-xl text-xs font-bold transition-all active:scale-[0.97]" style="background: var(--accent); color: white;">
          Carregar mais avaliações
        </button>
      </div>
      <div id="feed-spinner" class="col-span-full text-center py-8 hidden">
        <i class="fa-solid fa-spinner fa-spin text-lg" style="color: var(--text-muted);"></i>
      </div>

    </main>
    </div>

    <!-- NAVBAR INFERIOR -->
    <nav style="border-color: var(--border);" class="fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-md lg:max-w-5xl border-t px-6 py-4 flex justify-between items-center z-50 glassmorphism rounded-t-2xl">
      
      <button id="nav-feed" onclick="abrirFeed()" class="flex flex-col items-center focus:outline-none transition group" style="color: var(--text-muted);">
        <i class="fa-solid fa-comment-dots text-base group-hover:scale-105 transition-transform"></i>
        <span class="text-[9px] mt-1 font-semibold tracking-wider uppercase font-title">Feed</span>
      </button>


      <button id="nav-catalogo" onclick="abrirCatalogo()" class="flex flex-col items-center focus:outline-none transition group" style="color: var(--accent);">
        <i class="fa-solid fa-compass text-base group-hover:scale-105 transition-transform"></i>
        <span class="text-[9px] mt-1 font-semibold tracking-wider uppercase font-title">Catálogo</span>
      </button>

      <button id="nav-chat" onclick="abrirChat()" class="relative flex flex-col items-center focus:outline-none transition group" style="color: var(--text-muted);">
        <i class="fa-solid fa-comments text-base group-hover:scale-105 transition-transform"></i>
        <span id="nav-chat-dot" class="hidden absolute top-0 right-1 w-2.5 h-2.5 rounded-full" style="background:#ef4444;box-shadow:0 0 6px #ef4444;"></span>
        <span class="text-[9px] mt-1 font-semibold tracking-wider uppercase font-title">Chat</span>
      </button>

      <button id="btn-user" onclick="abrirPerfil()" class="hidden flex flex-col items-center focus:outline-none transition group" style="color: var(--accent);">
        <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-white text-xs shadow-md overflow-hidden" style="background: var(--accent);">
          <img id="user-avatar-img" class="hidden w-full h-full object-cover" src="" alt="">
          <span id="user-avatar-letter">U</span>
        </div>
        <span id="user-name" class="text-[9px] mt-1 font-semibold tracking-wider uppercase font-title">Perfil</span>
      </button>
      <button id="btn-login" onclick="abrirModalLogin()" class="flex flex-col items-center focus:outline-none transition group" style="color: var(--text-muted);">
        <i class="fa-solid fa-user text-base group-hover:scale-105 transition-transform"></i>
        <span class="text-[9px] mt-1 font-semibold tracking-wider uppercase font-title">Entrar</span>
      </button>
    </nav>

    <!-- MODAL DE AVALIAÇÃO — VERSÃO ACONCHEGANTE -->
    <div id="modal-avaliacao" class="modal-hidden fixed inset-0 flex items-center justify-center p-4 z-50" style="background: color-mix(in srgb, var(--bg-primary) 90%, transparent);">
      <div class="rounded-3xl w-full max-w-lg shadow-2xl max-h-[90vh] overflow-y-auto" style="background: linear-gradient(to bottom, var(--bg-elevated), var(--bg-card)); border: 1px solid var(--border-accent);">
        
        <div class="p-6 border-b" style="background: linear-gradient(to right, color-mix(in srgb, var(--accent) 15%, transparent), color-mix(in srgb, var(--accent) 5%, transparent)); border-color: var(--border-accent);">
          <div class="flex justify-between items-start">
            <div class="flex items-start gap-3">
              <span class="p-2.5 rounded-xl shadow-lg mt-0.5 text-white" style="background: var(--accent);">
                <i class="fa-solid fa-feather-pointed text-sm"></i>
              </span>
              <div>
                <h3 class="text-lg font-bold font-title" style="color: var(--text-primary);">Escrever Crítica</h3>
                <p class="text-xs mt-1" style="color: var(--text-muted);">Compartilhe sua experiência com a comunidade</p>
              </div>
            </div>
            <button onclick="fecharModalAvaliacao()" class="p-2 rounded-xl transition-all" style="color: var(--text-muted);">
              <i class="fas fa-times text-base"></i>
            </button>
          </div>
        </div>

        <form id="form-avaliacao" onsubmit="postarAvaliacao(event)" class="p-5 space-y-3">

          <!-- Usuário + Avatar -->
          <div class="flex items-center gap-3 p-3 rounded-2xl border" style="background: color-mix(in srgb, var(--bg-input) 60%, transparent); border-color: var(--border);">
            <div id="current-user-badge" class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-base shadow-sm shrink-0 overflow-hidden" style="background: var(--accent); color: white;">
              <img id="current-user-avatar-img" class="hidden w-full h-full object-cover" src="" alt="">
              <span id="current-user-avatar-letter">U</span>
            </div>
            <div class="min-w-0 flex-1">
              <p id="current-user-name" class="text-sm font-semibold truncate" style="color: var(--text-primary);">Carregando...</p>
              <p class="text-[10px]" style="color: var(--text-muted);">Publicando como</p>
            </div>
          </div>

          <!-- RPG + Nota lado a lado -->
          <div class="flex gap-2">
            <div class="flex-1">
              <label class="block text-[10px] font-bold mb-1" style="color: var(--text-muted);">RPG</label>
              <select id="form-rpg" required class="w-full rounded-xl p-2.5 text-xs focus:outline-none appearance-none cursor-pointer" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);">
                <% rpgs.forEach(rpg => { %>
                <option value="<%= rpg.name %>"><%= rpg.name %></option>
                <% }) %>
              </select>
            </div>
            <div>
              <label class="block text-[10px] font-bold mb-1" style="color: var(--text-muted);">Nota</label>
              <div class="flex items-center gap-1 rounded-xl px-3 py-2.5 border" style="background: var(--bg-input); border-color: var(--border);">
                <div class="flex gap-0.5 text-base" id="star-rating">
                  <i class="fa-regular fa-star cursor-pointer transition-colors" style="color: var(--text-muted);" data-value="1"></i>
                  <i class="fa-regular fa-star cursor-pointer transition-colors" style="color: var(--text-muted);" data-value="2"></i>
                  <i class="fa-regular fa-star cursor-pointer transition-colors" style="color: var(--text-muted);" data-value="3"></i>
                  <i class="fa-regular fa-star cursor-pointer transition-colors" style="color: var(--text-muted);" data-value="4"></i>
                  <i class="fa-regular fa-star cursor-pointer transition-colors" style="color: var(--text-muted);" data-value="5"></i>
                </div>
                <span id="rating-label" class="text-[10px] font-medium ml-1" style="color: var(--text-muted);">-</span>
              </div>
              <input type="hidden" id="form-rating" value="0">
            </div>
          </div>

          <!-- Crítica -->
          <div>
            <label class="block text-[10px] font-bold mb-1" style="color: var(--text-muted);">Crítica</label>
            <textarea id="form-comment" rows="3" required class="w-full rounded-xl p-3 text-xs focus:outline-none resize-none leading-relaxed" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);" placeholder="Sua experiência com este sistema..."></textarea>
          </div>

          <!-- Capa opcional (colapsada) -->
          <details class="group">
            <summary class="text-[10px] font-bold cursor-pointer list-none flex items-center gap-1" style="color: var(--text-muted);">
              <i class="fa-solid fa-image text-[9px]"></i>
              Adicionar capa
              <i class="fa-solid fa-chevron-down text-[8px] ml-auto transition-transform group-open:rotate-180"></i>
            </summary>
            <div class="mt-2 rounded-xl overflow-hidden border" style="background: var(--bg-input); border-color: var(--border);">
              <label class="flex items-center gap-3 p-2.5 cursor-pointer" style="color: var(--text-secondary);">
                <span class="p-1.5 rounded-lg border" style="background: color-mix(in srgb, var(--star) 15%, transparent); color: var(--star); border-color: color-mix(in srgb, var(--star) 30%, transparent);">
                  <i class="fa-solid fa-cloud-arrow-up text-[10px]"></i>
                </span>
                <div class="flex-1 min-w-0">
                  <p class="text-[10px] font-medium" style="color: var(--text-secondary);">Escolher foto</p>
                  <p id="file-name" class="text-[9px] truncate" style="color: var(--text-muted);">Nenhum</p>
                </div>
              </label>
              <input type="file" id="form-image" accept=".jpg,.jpeg,.png,.webp,.gif" class="hidden" onchange="atualizarNomeArquivo(this)">
            </div>
          </details>

          <button type="submit" class="w-full text-white font-bold py-3 rounded-2xl text-xs transition-all active:scale-[0.97] flex items-center justify-center gap-2" style="background: var(--accent);">
            <i class="fa-solid fa-paper-plane"></i>
            Publicar
          </button>
        </form>
      </div>
    </div>

    <!-- MODAL DE LOGIN -->
    <div id="modal-login" class="modal-hidden fixed inset-0 flex items-center justify-center p-4 z-50" style="background: color-mix(in srgb, var(--bg-primary) 90%, transparent);">
      <div class="rounded-3xl w-full max-w-sm shadow-2xl overflow-hidden" style="background: linear-gradient(to bottom, var(--bg-elevated), var(--bg-card)); border: 1px solid var(--border);">
        <div class="p-5 border-b" style="background: color-mix(in srgb, var(--accent) 10%, transparent); border-color: var(--border);">
          <div class="flex justify-between items-center">
            <h3 class="text-base font-bold font-title flex items-center gap-2" style="color: var(--text-primary);">
              <i class="fa-solid fa-right-to-bracket" style="color: var(--accent);"></i>
              Entrar
            </h3>
            <button onclick="fecharModalLogin()" class="p-2 rounded-xl transition-all" style="color: var(--text-muted);">
              <i class="fas fa-times text-base"></i>
            </button>
          </div>
        </div>
        <form id="form-login" onsubmit="fazerLogin(event)" class="p-5 space-y-4">
          <div class="space-y-1.5">
            <label class="block text-xs font-bold tracking-wide" style="color: var(--text-secondary);">Usuário</label>
            <input type="text" id="login-username" required class="w-full rounded-2xl p-3 text-sm focus:outline-none transition-all" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);" placeholder="Seu nome de usuário">
          </div>
          <div class="space-y-1.5">
            <label class="block text-xs font-bold tracking-wide" style="color: var(--text-secondary);">Senha</label>
            <input type="password" id="login-password" required class="w-full rounded-2xl p-3 text-sm focus:outline-none transition-all" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);" placeholder="Sua senha">
          </div>
          <div id="login-error" class="text-xs hidden rounded-xl p-3 border" style="color: #f87171; background: rgba(248, 113, 113, 0.1); border-color: rgba(248, 113, 113, 0.3);"></div>
          <button type="submit" class="w-full text-white font-bold py-3 rounded-2xl text-sm transition-all duration-200 shadow-lg active:scale-[0.98]" style="background: var(--accent);">
            Entrar
          </button>
          <p class="text-xs text-center" style="color: var(--text-muted);">
            Ainda não tem conta?
            <a href="#" onclick="event.preventDefault(); abrirModalRegistro();" style="color: var(--accent);" class="font-semibold">Cadastre-se</a>
          </p>
        </form>
      </div>
    </div>

    <!-- MODAL DE REGISTRO -->
    <div id="modal-registro" class="modal-hidden fixed inset-0 flex items-center justify-center p-4 z-50" style="background: color-mix(in srgb, var(--bg-primary) 90%, transparent);">
      <div class="rounded-3xl w-full max-w-sm shadow-2xl overflow-hidden" style="background: linear-gradient(to bottom, var(--bg-elevated), var(--bg-card)); border: 1px solid var(--border);">
        <div class="p-5 border-b" style="background: color-mix(in srgb, var(--accent) 10%, transparent); border-color: var(--border);">
          <div class="flex justify-between items-center">
            <h3 class="text-base font-bold font-title flex items-center gap-2" style="color: var(--text-primary);">
              <i class="fa-solid fa-user-plus" style="color: var(--accent);"></i>
              Criar Conta
            </h3>
            <button onclick="fecharModalRegistro()" class="p-2 rounded-xl transition-all" style="color: var(--text-muted);">
              <i class="fas fa-times text-base"></i>
            </button>
          </div>
        </div>
        <form id="form-registro" onsubmit="fazerRegistro(event)" class="p-5 space-y-4">
          <div class="flex items-center gap-3 pb-2">
            <div id="reg-avatar-preview" class="w-12 h-12 rounded-full flex items-center justify-center font-bold text-base overflow-hidden shrink-0" style="background: var(--accent-dim); border: 2px dashed var(--border-accent); color: var(--accent);">
              <i class="fa-solid fa-camera text-sm"></i>
            </div>
            <div class="flex-1">
              <label class="block text-xs font-bold tracking-wide mb-1" style="color: var(--text-secondary);">Foto do Perfil <span style="color: var(--text-muted); font-weight: 400;">(opcional)</span></label>
              <label class="cursor-pointer inline-block px-3 py-1.5 rounded-xl text-[10px] font-bold transition-all active:scale-[0.97]" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-secondary);">
                <i class="fa-solid fa-upload mr-1"></i>Escolher
                <input type="file" id="reg-avatar" accept=".jpg,.jpeg,.png,.webp,.gif" class="hidden" onchange="previewRegAvatar(this)">
              </label>
              <span id="reg-file-name" class="text-[9px] ml-2" style="color: var(--text-muted);">Nenhum</span>
            </div>
          </div>
          <div class="space-y-1.5">
            <label class="block text-xs font-bold tracking-wide" style="color: var(--text-secondary);">Usuário</label>
            <input type="text" id="reg-username" required minlength="3" class="w-full rounded-2xl p-3 text-sm focus:outline-none transition-all" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);" placeholder="Mínimo de 3 caracteres">
          </div>
          <div class="space-y-1.5">
            <label class="block text-xs font-bold tracking-wide" style="color: var(--text-secondary);">Senha</label>
            <input type="password" id="reg-password" required minlength="4" class="w-full rounded-2xl p-3 text-sm focus:outline-none transition-all" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);" placeholder="Mínimo de 4 caracteres">
          </div>
          <div class="space-y-1.5">
            <label class="block text-xs font-bold tracking-wide" style="color: var(--text-secondary);">Contato <span style="color: var(--text-muted); font-weight: 400;">(WhatsApp)</span></label>
            <input type="text" id="reg-contact" required class="w-full rounded-2xl p-3 text-sm focus:outline-none transition-all" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);" placeholder="Seu número do WhatsApp">
          </div>
          <div id="reg-error" class="text-xs hidden rounded-xl p-3 border" style="color: #f87171; background: rgba(248, 113, 113, 0.1); border-color: rgba(248, 113, 113, 0.3);"></div>
          <button type="submit" class="w-full text-white font-bold py-3 rounded-2xl text-sm transition-all duration-200 shadow-lg active:scale-[0.98]" style="background: var(--accent);">
            Criar Conta
          </button>
          <p class="text-xs text-center" style="color: var(--text-muted);">
            Já tem conta?
            <a href="#" onclick="event.preventDefault(); fecharModalRegistro(); abrirModalLogin();" style="color: var(--accent);" class="font-semibold">Faça login</a>
          </p>
        </form>
      </div>
    </div>

    <!-- MODAL DE CONFIGURAÇÕES -->
    <div id="modal-config" class="modal-hidden fixed inset-0 flex items-center justify-center p-4 z-50" style="background: color-mix(in srgb, var(--bg-primary) 90%, transparent);">
      <div class="rounded-2xl w-full max-w-sm p-6 shadow-2xl" style="background: var(--bg-card); border: 1px solid var(--border);">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-sm font-bold font-title flex items-center gap-2" style="color: var(--text-primary);">
            <i class="fa-solid fa-sliders" style="color: var(--accent);"></i> Ajustes
          </h3>
          <button onclick="fecharConfiguracoes()" class="transition" style="color: var(--text-muted);">
            <i class="fas fa-times text-base"></i>
          </button>
        </div>
        <div class="space-y-4">
          <div class="flex justify-between items-center py-2.5 border-b" style="border-color: var(--border);">
            <span class="text-xs font-medium" style="color: var(--text-secondary);">Filtro de Conteúdo Seguro</span>
            <input type="checkbox" checked class="cursor-pointer h-4 w-4" style="accent-color: var(--accent);">
          </div>
          <div class="flex justify-between items-center py-2.5 border-b" style="border-color: var(--border);">
            <span class="text-xs font-medium" style="color: var(--text-secondary);">Apenas Sistemas em Português</span>
            <input type="checkbox" class="cursor-pointer h-4 w-4" style="accent-color: var(--accent);">
          </div>
          <button onclick="fecharConfiguracoes()" class="w-full font-semibold py-2 rounded-xl text-xs transition" style="background: var(--bg-input); color: var(--text-primary); border: 1px solid var(--border);">
            Fechar
          </button>
        </div>
      </div>
    </div>

    <!-- CATÁLOGO NETFLIX (OVERLAY FULLSCREEN) -->
    <div id="modal-catalogo" class="modal-hidden fixed inset-0 overflow-y-auto" style="background: var(--bg-primary); z-index: 30;">
      <div class="min-h-screen">
        <%
        const heroLimited = rpgs.filter(r => r.limitedEdition);
        const heroFeatured = rpgs.filter(r => r.featured && !r.limitedEdition);
        const heroRpgs = heroLimited.concat(heroFeatured).length ? heroLimited.concat(heroFeatured) : (rpgs[0] ? [rpgs[0]] : []);
        %>
        <div id="cat-hero-container" class="relative h-[55vh] min-h-[360px] overflow-hidden cursor-pointer" onmouseenter="pausarHero()" onmouseleave="retomarHero()" onclick="heroClicar()">
          <div id="cat-banner" class="cat-banner cat-banner-zoom absolute inset-0 bg-cover bg-center" style="background-image: url('<%= heroRpgs[0].banner %>'); transition: opacity 0.3s ease;"></div>
          <div class="absolute inset-0" style="background: linear-gradient(to top, var(--bg-primary) 0%, transparent 55%, rgba(0,0,0,0.5) 100%);"></div>
          <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(0,0,0,0.5) 0%, transparent 100%);"></div>

          <div class="cat-hero absolute bottom-0 left-0 right-0 p-8 pb-10">
            <div class="flex items-center gap-3 mb-3">
              <span id="cat-genre" class="text-[10px] font-bold uppercase tracking-[0.15em] px-2.5 py-1 rounded" style="background: var(--accent); color: white;"><%= heroRpgs[0].genre %></span>
              <span id="cat-year" class="text-[10px] font-medium" style="color: rgba(255,255,255,0.4);"><%= heroRpgs[0].year %></span>
              <span id="cat-limited-badge" class="<%= heroRpgs[0].limitedEdition ? 'flex' : 'hidden' %> text-[9px] font-bold uppercase tracking-[0.15em] px-2.5 py-1 rounded items-center gap-1" style="background: #f59e0b; color: #000;">
                <i class="fa-solid fa-lock text-[8px]"></i> Edição Limitada
              </span>
            </div>
            <h2 id="cat-title" class="text-4xl md:text-5xl font-title font-bold mb-3" style="color: white; text-shadow: 0 2px 20px rgba(0,0,0,0.7);"><%= heroRpgs[0].name %></h2>
            <p id="cat-desc" class="text-sm max-w-xl leading-relaxed mb-1 line-clamp-3" style="color: rgba(255,255,255,0.8); text-shadow: 0 1px 8px rgba(0,0,0,0.6); display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden;"><%= heroRpgs[0].description %></p>
            <p id="cat-owner" class="text-xs" style="color: rgba(255,255,255,0.4);"><%= heroRpgs[0].owner %></p>
            <a id="cat-ad-link" class="hidden mt-3 text-xs font-bold items-center gap-2" style="color: var(--accent);" target="_blank" rel="noopener">
              <span class="px-2 py-0.5 rounded" style="background: rgba(0,0,0,0.6);"><i class="fa-solid fa-circle-info text-[9px]"></i> Anúncio de parceiro</span>
            </a>
          </div>

          <% if (heroRpgs.length > 1) { %>
          <div id="hero-dots" class="absolute bottom-2 left-1/2 -translate-x-1/2 z-10 flex gap-1.5">
            <% heroRpgs.forEach((_, i) => { %>
            <button onclick="heroIrPara(event, <%= i %>)" class="w-1.5 h-1.5 rounded-full transition-all" style="background: <%= i === 0 ? 'var(--accent)' : 'rgba(255,255,255,0.4)' %>;<%= i === 0 ? ' width: 16px;' : '' %>"></button>
            <% }) %>
          </div>
          <% } %>

          <button onclick="abrirFeed(event)" class="absolute top-5 right-5 w-10 h-10 rounded-full flex items-center justify-center text-white transition-all z-10 hover:bg-white/20 active:scale-90" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.1);">
            <i class="fa-solid fa-comment-dots text-sm"></i>
          </button>
        </div>

        <div class="px-8 py-6 lg:px-12 lg:py-8" id="catalog-controls">
          <div class="w-full max-w-7xl mx-auto">
          <div id="cat-admin-section" class="mb-4 hidden overflow-x-hidden">
            <div class="flex flex-wrap gap-2">
              <button onclick="abrirModalRegistroRpg()" class="flex-1 py-2.5 rounded-xl text-[11px] font-bold transition-all active:scale-[0.97] flex items-center justify-center gap-2" style="background: var(--accent); color: white;">
                <i class="fa-solid fa-plus-circle"></i>
                Novo Sistema
              </button>
              <button id="btn-pending-reviews" onclick="abrirModalPendentes()" class="py-2.5 px-3 rounded-xl text-[11px] font-bold transition-all active:scale-[0.97] flex items-center justify-center gap-2 relative" style="background: #f59e0b; color: #000;">
                <i class="fa-solid fa-clock"></i>
                <span id="pending-count-badge" class="absolute -top-1.5 -right-1.5 w-4 h-4 rounded-full flex items-center justify-center text-[8px] font-bold" style="background: var(--accent); color: white;">0</span>
              </button>
              <button onclick="abrirModalAnuncios()" class="py-2.5 px-3 rounded-xl text-[11px] font-bold transition-all active:scale-[0.97] flex items-center justify-center gap-2" style="background: color-mix(in srgb, var(--accent) 20%, transparent); color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);">
                <i class="fa-solid fa-rectangle-ad"></i>
                Anúncios
              </button>
              <button onclick="abrirModalDestaques()" class="py-2.5 px-3 rounded-xl text-[11px] font-bold transition-all active:scale-[0.97] flex items-center justify-center gap-2" style="background: color-mix(in srgb, var(--star) 15%, transparent); color: var(--star); border: 1px solid color-mix(in srgb, var(--star) 35%, transparent);">
                <i class="fa-solid fa-star"></i>
                Destaques
              </button>
              <button onclick="abrirModalCriadores()" class="py-2.5 px-3 rounded-xl text-[11px] font-bold transition-all active:scale-[0.97] flex items-center justify-center gap-2" style="background: color-mix(in srgb, #22c55e 15%, transparent); color: #22c55e; border: 1px solid color-mix(in srgb, #22c55e 35%, transparent);">
                <i class="fa-solid fa-award"></i>
                Criadores
              </button>
              <button onclick="abrirModalDenuncias()" class="py-2.5 px-3 rounded-xl text-[11px] font-bold transition-all active:scale-[0.97] flex items-center justify-center gap-2 relative" style="background: color-mix(in srgb, #ef4444 15%, transparent); color: #f87171; border: 1px solid color-mix(in srgb, #ef4444 35%, transparent);">
                <i class="fa-solid fa-flag"></i>
                Denúncias
                <span id="reports-count-badge" class="hidden absolute -top-1.5 -right-1.5 min-w-4 h-4 px-1 rounded-full items-center justify-center text-[8px] font-bold flex" style="background: #ef4444; color: white;">0</span>
              </button>
              <button onclick="abrirModalSubmissoes()" class="py-2.5 px-3 rounded-xl text-[11px] font-bold transition-all active:scale-[0.97] flex items-center justify-center gap-2 relative" style="background: color-mix(in srgb, #a855f7 15%, transparent); color: #c084fc; border: 1px solid color-mix(in srgb, #a855f7 35%, transparent);">
                <i class="fa-solid fa-inbox"></i>
                Novos RPGs
                <span id="submissions-count-badge" class="hidden absolute -top-1.5 -right-1.5 min-w-4 h-4 px-1 rounded-full items-center justify-center text-[8px] font-bold flex" style="background: #a855f7; color: white;">0</span>
              </button>
            </div>
          </div>

          <div class="flex flex-col gap-3 mb-5">
            <div class="relative w-full">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none"><i class="fa-solid fa-search text-xs" style="color: var(--text-muted);"></i></span>
              <input type="text" id="cat-search" oninput="filtrarCatalogo()" placeholder="Pesquisar por nome ou categoria..." class="w-full rounded-xl pl-9 pr-4 py-3 text-sm focus:outline-none" style="background: var(--bg-input); border: 1px solid var(--border); color: var(--text-primary);">
            </div>
            <div class="flex gap-1 overflow-x-auto pb-1 scrollbar-thin" style="-webkit-overflow-scrolling: touch;">
              <button onclick="ordenarCatalogo('nome')" id="sort-nome" class="px-3 py-2.5 rounded-xl text-[10px] font-bold transition-all shrink-0" style="background: var(--accent); color: white;">A-Z</button>
              <button onclick="ordenarCatalogo('popular')" id="sort-popular" class="px-3 py-2.5 rounded-xl text-[10px] font-bold transition-all shrink-0" style="background: var(--bg-input); color: var(--text-muted); border: 1px solid var(--border);">Populares</button>
              <button onclick="ordenarCatalogo('nota')" id="sort-nota" class="px-3 py-2.5 rounded-xl text-[10px] font-bold transition-all shrink-0" style="background: var(--bg-input); color: var(--text-muted); border: 1px solid var(--border);">Melhor Nota</button>
            </div>
          </div>

          <!-- CTA SUTIL: CADASTRAR RPG -->
          <div class="w-full mb-7 flex justify-center">
            <button onclick="abrirModalSubmeterRpg()" class="group flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[10px] transition opacity-60 hover:opacity-100" style="background:transparent;border:1px solid var(--border);color:var(--text-muted);">
              <i class="fa-regular fa-circle-question text-[10px]"></i>
              <span>É criador? <span class="underline underline-offset-2">Cadastre seu RPG</span> para avaliação da nossa curadoria</span>
              <i class="fa-solid fa-chevron-right text-[8px] transition-transform group-hover:translate-x-0.5"></i>
            </button>
          </div>

          <!-- TOP 10 MAIS BEM AVALIADOS -->
          <div id="cat-top10" class="cat-section mb-7 pb-5 border-b" style="border-color: var(--border);">
            <h3 class="cat-section-title text-base font-title font-bold mb-4 flex items-center gap-2" style="color: var(--accent);">
              <i class="fa-solid fa-trophy" style="font-size: 12px;"></i> Top 10 Mais Bem Avaliados
            </h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3">
              <% topRpgs.forEach((rating, index) => { %>
              <div onclick="selecionarRpgCatalogo('<%= rating.rpg.name %>', this)" class="cat-card rounded-xl overflow-hidden border" data-nome="<%= rating.rpg.name %>" data-genre="<%= rating.rpg.genre %>" data-owner="<%= rating.rpg.owner %>" data-desc="<%= rating.rpg.description.substring(0, 80) %>" style="background: var(--bg-card); border-color: var(--border); aspect-ratio: 2/3;">
                <img src="<%= rating.rpg.image %>" class="w-full h-full object-cover" alt="<%= rating.rpg.name %>">
                <span class="absolute top-1.5 left-1.5 w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-bold z-10 shadow-lg border-2" style="background: <%= index < 3 ? 'var(--accent)' : 'rgba(0,0,0,0.7)' %>; color: white; border-color: <%= index < 3 ? 'var(--accent)' : 'var(--border)' %>;"><%= index + 1 %></span>
                <span class="cat-age-badge <%= rating.rpg.ageRating %>"><%= rating.rpg.ageRating === 'L' ? 'L' : rating.rpg.ageRating %></span>
                <div class="cat-rating-badge absolute top-8 right-2 z-3 flex items-center gap-1 text-[9px] font-bold px-1.5 py-0.5 rounded" style="background: rgba(0,0,0,0.7); color: var(--star); backdrop-filter: blur(4px);<%= rating.reviewCount === 0 ? ' opacity:0.4;' : '' %>">
                  <i class="fa-solid fa-star text-[7px]"></i>
                  <%= rating.avgRating.toFixed(1) %>
                </div>
                <div class="cat-overlay"></div>
                <div class="cat-label">
                  <h4 class="font-title font-bold text-sm" style="color: white; text-shadow: 0 1px 4px rgba(0,0,0,0.8);"><%= rating.rpg.name %></h4>
                  <p class="text-[10px] mt-0.5 truncate" style="color: rgba(255,255,255,0.6);"><%= rating.rpg.owner %></p>
                  <% if (rating.rpg.limitedEdition) { %>
                  <p class="text-[9px] mt-0.5 font-bold uppercase tracking-wider flex items-center gap-1" style="color: #f59e0b; text-shadow: 0 1px 4px rgba(0,0,0,0.8);"><i class="fa-solid fa-lock text-[7px]"></i> <%= rating.rpg.closed ? 'Vagas encerradas' : (rating.rpg.slotsTotal ? ((rating.rpg.slotsFilled || 0) + '/' + rating.rpg.slotsTotal + ' vagas') : 'Edição limitada') %></p>
                  <% } %>
                  <p class="text-[9px] mt-1 leading-tight line-clamp-2" style="color: rgba(255,255,255,0.5);"><%= rating.rpg.description.substring(0, 90) %></p>
                </div>
              </div>
              <% }) %>
            </div>
          </div>

          <div id="catalog-grid-container" class="space-y-8 pb-24">
            <%
            const generos = [...new Set(rpgs.map(r => r.genre))].sort((a, b) => a.localeCompare(b));
            %>
            <% generos.forEach(genre => { %>
            <% const itens = rpgs.filter(r => r.genre === genre); %>
            <div class="cat-section" data-genre="<%= genre %>">
              <h3 class="cat-section-title text-base font-title font-bold mb-4 flex items-center gap-2" style="color: var(--text-primary);">
                <span class="w-1 h-4 rounded-full inline-block" style="background: var(--accent);"></span>
                <span class="cat-genre-name"><%= genre %></span>
                <span class="text-[10px] font-normal" style="color: var(--text-muted);">(<span class="cat-genre-count"><%= itens.length %></span>)</span>
              </h3>
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3">
                <% 
                itens.forEach(rpg => { 
                  const rpgReviews = reviews.filter(r => r.rpg.name === rpg.name);
                  const media = rpgReviews.length ? (rpgReviews.reduce((s, r) => s + r.rating, 0) / rpgReviews.length) : 0;
                  const limitedText = rpg.closed ? 'Vagas encerradas' : (rpg.slotsTotal ? ((rpg.slotsFilled || 0) + '/' + rpg.slotsTotal + ' vagas') : 'Edição limitada');
                %>
                <div onclick="selecionarRpgCatalogo('<%= rpg.name %>', this)" class="cat-card rounded-xl overflow-hidden border" data-nome="<%= rpg.name %>" data-genre="<%= rpg.genre %>" data-owner="<%= rpg.owner %>" data-desc="<%= rpg.description.substring(0, 80) %>" style="background: var(--bg-card); border-color: var(--border); aspect-ratio: 2/3;">
                  <img src="<%= rpg.image %>" class="w-full h-full object-cover<%= rpg.ageRating === '18' && rpg.blurImage ? ' cat-blur' : '' %>" alt="<%= rpg.name %>">
                  <span class="cat-age-badge <%= rpg.ageRating %>"><%= rpg.ageRating === 'L' ? 'L' : rpg.ageRating %></span>
                  <div class="cat-rating-badge absolute top-8 right-2 z-3 flex items-center gap-1 text-[9px] font-bold px-1.5 py-0.5 rounded" style="background: rgba(0,0,0,0.7); color: var(--star); backdrop-filter: blur(4px);<%= rpgReviews.length === 0 ? ' opacity:0.4;' : '' %>">
                    <i class="fa-solid fa-star text-[7px]"></i>
                    <%= media.toFixed(1) %>
                  </div>
                  <div class="cat-overlay"></div>
                  <div class="cat-label">
                    <h4 class="font-title font-bold text-sm" style="color: white; text-shadow: 0 1px 4px rgba(0,0,0,0.8);"><%= rpg.name %></h4>
                    <p class="text-[10px] mt-0.5 truncate" style="color: rgba(255,255,255,0.6);"><%= rpg.owner %></p>
                    <% if (rpg.limitedEdition) { %>
                    <p class="text-[9px] mt-0.5 font-bold uppercase tracking-wider flex items-center gap-1" style="color: #f59e0b; text-shadow: 0 1px 4px rgba(0,0,0,0.8);"><i class="fa-solid fa-lock text-[7px]"></i> <%= limitedText %></p>
                    <% } %>
                    <p class="text-[9px] mt-1 leading-tight line-clamp-2" style="color: rgba(255,255,255,0.5);"><%= rpg.description.substring(0, 90) %></p>
                  </div>
                </div>
                <% }) %>
              </div>
            </div>
            <% }) %>
          </div>
          </div>
        </div>
      </div>
    </div>

    <!-- MODAL DE DETALHE DO RPG -->
    <%
    const detailRpg = seoRpg || rpgs[0];
    const modalHiddenClass = seoRpg ? 'detalhe-aberto' : 'modal-hidden';
    const rpgRevs = reviews.filter(r => r.rpg.name === detailRpg.name);
    const rpgAvg = rpgRevs.length ? (rpgRevs.reduce((s, r) => s + r.rating, 0) / rpgRevs.length) : 0;
    const rpgCount = rpgRevs.length;
    %>
    <div id="modal-detalhe" class="<%= modalHiddenClass %> fixed inset-0 z-50 flex items-center justify-center p-4" style="background: color-mix(in srgb, var(--bg-primary) 92%, transparent); backdrop-filter: blur(4px);">
      <div class="detalhe-card rounded-3xl w-full max-w-lg lg:max-w-2xl max-h-[90vh] overflow-y-auto shadow-2xl" style="background: linear-gradient(to bottom, var(--bg-elevated), var(--bg-card)); border: 1px solid var(--border);">
        <div class="relative h-44 lg:h-56 rounded-t-3xl overflow-hidden bg-cover bg-center" id="detalhe-banner" style="background-image: url('<%= detailRpg.banner %>');">
          <div class="absolute inset-0" style="background: linear-gradient(to top, var(--bg-elevated) 0%, transparent 60%);"></div>
          <button onclick="fecharDetalheRpg()" class="absolute top-3 right-3 w-8 h-8 rounded-full flex items-center justify-center transition z-10" style="background: rgba(0,0,0,0.5); color: white;">
            <i class="fas fa-times text-xs"></i>
          </button>
          <div class="absolute bottom-3 left-4 right-4 z-10">
            <span class="text-[9px] font-bold uppercase tracking-widest px-2 py-0.5 rounded" style="background: var(--accent); color: white;" id="detalhe-genre"><%= detailRpg.genre %></span>
          </div>
        </div>
        <div class="p-5 space-y-4">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0 flex-1">
              <h2 class="text-xl font-title font-bold" style="color: var(--text-primary);" id="detalhe-name"><%= detailRpg.name %></h2>
              <div class="flex items-center gap-3 mt-1">
                <span class="text-xs" style="color: var(--text-muted);" id="detalhe-owner"><%= detailRpg.owner %></span>
                <span class="rpg-criador-badge hidden items-center gap-0.5 text-[8px] font-bold px-1.5 py-0.5 rounded-full" data-rpg="<%= detailRpg.name %>" style="background:#22c55e20;color:#22c55e;border:1px solid #22c55e40;"><i class="fa-solid fa-award"></i>Você é o criador</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded font-bold" id="detalhe-age" style="background: rgba(234,179,8,0.2); color: #eab308;"><%= detailRpg.ageRating %></span>
                <span class="text-[10px]" style="color: var(--text-muted);" id="detalhe-year"><%= detailRpg.year %></span>
              </div>
            </div>
            <div id="detalhe-rating" class="flex flex-col items-center shrink-0 rounded-2xl px-4 py-2 border" style="background: color-mix(in srgb, var(--bg-card) 60%, transparent); border-color: var(--border);">
              <span class="text-2xl font-bold font-title leading-none" style="color: var(--star);" id="detalhe-rating-value"><%= rpgCount > 0 ? rpgAvg.toFixed(1) : '—' %></span>
              <div id="detalhe-rating-stars" class="flex items-center gap-0.5 mt-0.5">
                <% if (rpgCount > 0) { %>
                  <% for (let i = 1; i <= 5; i++) { %>
                    <i class="<%= i <= Math.floor(rpgAvg) ? 'fas fa-star' : (i === Math.ceil(rpgAvg) && rpgAvg % 1 !== 0 ? 'fas fa-star-half-alt' : 'far fa-star') %>" style="color:var(--star);font-size:9px;"></i>
                  <% } %>
                <% } else { %>
                  <% for (let i = 1; i <= 5; i++) { %>
                    <i class="fa-regular fa-star" style="color:var(--text-muted);font-size:9px;opacity:0.4;"></i>
                  <% } %>
                <% } %>
              </div>
              <span class="text-[9px] mt-0.5" style="color: var(--text-muted);" id="detalhe-rating-count"><%= rpgCount > 0 ? `${rpgCount} avaliação${rpgCount !== 1 ? 'ões' : ''}` : 'Sem avaliações' %></span>
            </div>
          </div>
          <p class="text-xs leading-relaxed" style="color: var(--text-secondary);" id="detalhe-desc"><%= detailRpg.description %></p>
          <div id="detalhe-limited" class="<%= detailRpg.limitedEdition ? 'flex' : 'hidden' %> p-3 rounded-xl items-center gap-3" style="background: color-mix(in srgb, #f59e0b 10%, transparent); border: 1px solid color-mix(in srgb, #f59e0b 35%, transparent);">
            <i class="fa-solid fa-lock text-base shrink-0" style="color: #f59e0b;"></i>
            <div class="min-w-0">
              <p class="text-[11px] font-bold" style="color: #f59e0b;" id="detalhe-limited-title"><%= detailRpg.closed ? 'Vagas encerradas' : (detailRpg.slotsTotal ? ('Vagas: ' + (detailRpg.slotsFilled || 0) + '/' + detailRpg.slotsTotal) : 'Edição Limitada') %></p>
              <p class="text-[10px] mt-0.5" style="color: var(--text-secondary);" id="detalhe-limited-sub"><%= detailRpg.closed ? 'Este RPG está fechado para novas inscrições.' : (detailRpg.slotsTotal ? ((detailRpg.slotsTotal - (detailRpg.slotsFilled || 0)) + ' vaga' + ((detailRpg.slotsTotal - (detailRpg.slotsFilled || 0)) !== 1 ? 's' : '') + ' restante' + ((detailRpg.slotsTotal - (detailRpg.slotsFilled || 0)) !== 1 ? 's' : '') + '.') : 'RPG fechado com vagas limitadas.') %></p>
            </div>
          </div>
          <div id="detalhe-tags" class="flex flex-wrap gap-1.5">
            <% if (detailRpg.tags && detailRpg.tags.length) { %>
              <% detailRpg.tags.sort((a, b) => b.weight - a.weight).forEach(t => { %>
              <span class="text-[9px] px-2 py-0.5 rounded font-medium" style="background:color-mix(in srgb, var(--accent) 15%, transparent);color:var(--accent);border:1px solid color-mix(in srgb, var(--accent) 25%, transparent);"><%= t.name %></span>
              <% }) %>
            <% } %>
          </div>
          <div class="flex flex-wrap gap-2">
            <a id="detalhe-link" href="<%= detailRpg.link || '#' %>" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-xs font-bold px-4 py-2 rounded-xl transition-all active:scale-95" style="background: var(--accent); color: white; <%= detailRpg.link ? '' : 'opacity:0.5;pointer-events:none;' %>">
              <i class="fa-solid fa-globe text-[10px]"></i>
              Site Oficial
            </a>
            <a id="detalhe-whatsapp" href="<%= detailRpg.whatsapp || '#' %>" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-xs font-bold px-4 py-2 rounded-xl transition-all active:scale-95" style="background: #25D366; color: white; <%= detailRpg.whatsapp ? '' : 'opacity:0.5;pointer-events:none;' %>">
              <i class="fa-brands fa-whatsapp text-[10px]"></i>
              Jogar
            </a>
          </div>

          <div class="flex gap-2">
            <button id="btn-avaliar-detalhe" onclick="avaliarDoDetalhe()" class="flex-1 text-white font-bold py-2.5 rounded-2xl text-xs transition-all active:scale-[0.97] flex items-center justify-center gap-2 hidden" style="background: var(--accent);">
              <i class="fa-solid fa-star"></i>
              Avaliar
            </button>
            <button id="btn-editar-detalhe" onclick="editarRpgDoDetalhe()" class="hidden px-3 py-2.5 rounded-2xl text-xs font-bold transition-all active:scale-[0.97] flex items-center justify-center gap-1.5" style="background: var(--bg-elevated); color: var(--text-secondary); border: 1px solid var(--border);">

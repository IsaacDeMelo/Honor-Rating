          ${a.description ? '<p class="mt-1 text-[9px] truncate" style="color: var(--text-muted);"><i class="fa-solid fa-align-left text-[8px] mr-1"></i>' + a.description.replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</p>' : ''}

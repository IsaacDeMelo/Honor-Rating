{
  "name": "typescriptlab",
  "version": "1.0.0",
  "description": "Rpflix — catálogo e comunidade de RPGs de mesa (Express + TypeScript + EJS + MongoDB)",
  "homepage": "https://github.com/IsaacDeMelo/TypeScriptLab#readme",
  "bugs": {
    "url": "https://github.com/IsaacDeMelo/TypeScriptLab/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IsaacDeMelo/TypeScriptLab.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "npx tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "mkdir -p dist/views dist/public && cp src/views/*.ejs dist/views/ 2>/dev/null || true && cp -r src/public/* dist/public/ 2>/dev/null || true",
    "migrate": "npx tsx src/migrate.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "mongoose": "^9.8.0",
    "multer": "^2.2.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "typescript": "^5.0.0"
  }
}